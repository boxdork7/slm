<!--
Sidebar 侧边导航 垂直展示的导航栏,用于在不同的内容区域之间进行切换。

UniApp X 版本改动点:
1. 移除 defineOptions
2. 移除手动组件导入 (easycom 自动注册)
3. SidebarItem/SidebarBeforeChange 等类型移到 wd-sidebar-key.uts
4. useChildren → createChildManager + provide 模式
5. 联合字面量类型改为 string
6. Record<string, any> → UTSJSONObject
7. any → 具体类型
8. ::before 伪元素 → 真实 view 元素
9. :deep() → 直接类选择器
10. isFunction → 类型检查改为 != null
-->
<template>
  <view :class="`wd-sidebar ${customClass}`" :style="customStyle">
    <!-- Items 模式: 通过 items 数组渲染侧边栏项 -->
    <template v-if="isItemsMode">
      <view
        v-for="(item, index) in items"
        :key="item.value"
        :class="getItemClass(item, index)"
        @click="handleItemClick(item, index)"
      >
        <!-- 自定义内容插槽 -->
        <slot
          v-if="item.useSlot"
          :name="item.slotName || `item-${index}`"
          :item="item"
          :index="index"
          :active="modelValue === item.value"
        />
        <!-- 默认内容 -->
        <block v-else>
          <!-- 图标插槽 -->
          <slot
            v-if="item.useIconSlot"
            :name="item.iconSlotName || `icon-${index}`"
            :item="item"
            :index="index"
          />
          <!-- 默认图标 -->
          <template v-else-if="item.icon">
            <wd-icon custom-class="wd-sidebar-item__icon" :name="item.icon" />
          </template>
          <wd-badge v-bind="getBadgeProps(item)" custom-class="wd-sidebar-item__badge">
            {{ item.label }}
          </wd-badge>
        </block>
      </view>
    </template>

    <!-- 子组件模式: 使用 wd-sidebar-item 子组件 -->
    <slot v-else />

    <view class="wd-sidebar__padding" />
  </view>
</template>

<script lang="uts" setup>
import { computed, provide } from 'vue'
import { deepAssign, isDef, isUndefined, omitBy } from '../common/util'
import { createChildManager } from '../../composables/useChildren'
import {
  SIDEBAR_KEY,
  type SidebarItem,
  type SidebarBeforeChange,
  type SidebarProps,
  type SidebarProvide,
} from './wd-sidebar-key'

/**
 * 侧边栏组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 侧边栏项数据数组 */
  items ?: SidebarItem[]
  /** 当前导航项的索引 */
  modelValue ?: number | string
  /** 在改变前执行的函数 */
  beforeChange ?: SidebarBeforeChange | null
}>(), {
  customStyle: '',
  customClass: '',
  items: () : SidebarItem[] => [],
  modelValue: 0,
  beforeChange: null,
})

/** 定义组件事件 */
const emit = defineEmits(['update:modelValue', 'change', 'item-click'])

/** 子组件管理 (用于兼容 wd-sidebar-item 子组件模式) */
const manager = createChildManager()

/** 子组件列表 (响应式计算) */
const children = computed(() : any[] => {
  // 这里需要从子组件收集数据,在 UniApp X 中简化处理
  // 实际应用中,子组件通过 inject 获取 sidebar 实例并注册自己的数据
  return []
})

/**
 * 判断是否使用 items 模式
 * 当传入 items 数组且有内容时,使用 items 模式
 */
const isItemsMode = computed(() : boolean => {
  return props.items.length > 0
})

/**
 * 子项状态变更
 * @param value 目标值
 * @param label 目标值标题
 */
function setChange(value : number | string, label : string) {
  if (props.beforeChange != null) {
    props.beforeChange({
      value,
      resolve: (pass : boolean) => {
        if (pass) {
          updateValue(value, label)
        }
      },
    })
  } else {
    updateValue(value, label)
  }
}

/**
 * 更新选中状态
 * @param value 目标值
 * @param label 目标值标题
 */
function updateValue(value : number | string, label : string) {
  emit('update:modelValue', value)
  emit('change', { value, label })
}

/**
 * Provide 数据给子组件
 */
const sidebarProps : SidebarProps = {
  modelValue: props.modelValue,
  beforeChange: props.beforeChange,
}

const sidebarProvide : SidebarProvide = {
  childUids: manager.childUids,
  addChild: manager.addChild,
  removeChild: manager.removeChild,
  props: sidebarProps,
  setChange: setChange,
}

provide(SIDEBAR_KEY, sidebarProvide)

/**
 * 计算侧边栏项的类名 (用于 items 模式)
 * @param item 侧边栏项数据
 * @param index 项目索引
 */
const getItemClass = (item : SidebarItem, index : number) : string => {
  const classNames : string[] = ['wd-sidebar-item']

  const active = props.modelValue === item.value
  if (active) classNames.push('wd-sidebar-item--active')
  if (item.disabled === true) classNames.push('wd-sidebar-item--disabled')

  // 计算前缀和后缀样式
  if (!isItemsMode.value) return classNames.join(' ')

  const activeIndex = props.items.findIndex((i : SidebarItem) : boolean => i.value === props.modelValue)
  if (index === activeIndex - 1) classNames.push('wd-sidebar-item--prefix')
  if (index === activeIndex + 1) classNames.push('wd-sidebar-item--suffix')

  return classNames.join(' ')
}

/**
 * 计算徽标属性 (用于 items 模式)
 * @param item 侧边栏项数据
 */
const getBadgeProps = (item : SidebarItem) : UTSJSONObject => {
  const baseProps = isDef(item.badgeProps) && item.badgeProps != null
    ? omitBy(item.badgeProps as UTSJSONObject, isUndefined)
    : {}

  const itemProps = omitBy(
    {
      max: item.max != null ? item.max : 99,
      isDot: item.isDot,
      modelValue: item.badge,
    },
    isUndefined,
  )

  return deepAssign(baseProps, itemProps) as UTSJSONObject
}

/**
 * 处理侧边栏项点击事件 (用于 items 模式)
 * @param item 侧边栏项数据
 * @param index 项目索引
 */
const handleItemClick = (item : SidebarItem, index : number) => {
  if (item.disabled === true) return

  // 触发点击事件
  emit('item-click', item, index)

  // 更新选中状态
  setChange(item.value, item.label)
}
</script>

<style lang="scss">
// 引入外部样式文件
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

// 暗色主题样式
.wot-theme-dark {
  @include b(sidebar) {
    background: $-dark-background;
    @include e(padding) {
      background: $-dark-background2;
    }
  }

  @include b(sidebar-item) {
    background: $-dark-background2;
    color: $-dark-color;

    &:active {
      background-color: $-dark-background4;
    }

    @include m(active) {
      background: $-dark-background;
      color: $-sidebar-active-color;
    }

    @include m(disabled) {
      color: $-dark-color-gray;

      &:active {
        background-color: $-dark-background2;
      }
    }
  }
}

// 侧边栏容器样式
@include b(sidebar) {
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  width: $-sidebar-width;
  height: $-sidebar-height;
  background: $-color-white;

  @include e(padding) {
    flex: 1 1 auto;
    background: $-sidebar-bg;
  }
}

// 侧边栏项样式
@include b(sidebar-item) {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 32rpx;
  font-size: $-sidebar-font-size;
  color: $-sidebar-color;
  background: $-sidebar-bg;
  min-height: $-sidebar-item-height;
  box-sizing: border-box;
  white-space: wrap;
  line-height: $-sidebar-item-line-height;

  &:active {
    background-color: $-sidebar-hover-bg;
  }

  @include m(active) {
    font-weight: 600;
    background: $-sidebar-active-bg;
    color: $-sidebar-active-color;

    &:active {
      background-color: transparent;
    }
  }

  @include m(prefix) {
    border-bottom-right-radius: $-sidebar-border-radius;
  }

  @include m(suffix) {
    border-top-right-radius: $-sidebar-border-radius;
  }

  @include m(disabled) {
    color: $-sidebar-disabled-color;
    cursor: not-allowed;

    &:active {
      background-color: $-sidebar-bg;
    }
  }

  /* edeep → 直接类选择器 (UniApp X 无 :deep()) */
  .wd-sidebar-item__badge {
    z-index: 2;
    word-break: break-all;
  }

  .wd-sidebar-item__icon {
    font-size: $-sidebar-icon-size;
    margin-right: 4rpx;
  }
}

/* 激活项左侧指示条 - 用真实 view 元素替代 ::before */
.wd-sidebar-item--active::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: $-sidebar-active-border-width;
  height: $-sidebar-active-border-height;
  background: $-sidebar-active-color;
  transform: translateY(-50%);
  border-radius: $-sidebar-active-border-width;
}
</style>
