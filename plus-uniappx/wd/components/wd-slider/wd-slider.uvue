<!--
Slider 滑块 用于选择一个或一个范围内的值。

UniApp X 版本
- 移除 defineOptions
- 移除手动组件导入（easycom 自动注册）
- 移除 CSSProperties → string 拼接
- 移除 #ifdef MP-DINGTALK 条件编译
- SliderValue = number | number[] → 简化为 number（不支持 range 模式联合类型）
- useTouch → 简化的触摸处理
- getRect → uni.createSelectorQuery
- uuid → import from util
- ComponentPublicInstance export → 移除
-->
<template>
  <view :class="`wd-slider ${disabled ? 'is-disabled' : ''} ${customClass}`" :style="customStyle">
    <!-- 滑块标签 -->
    <view v-if="showLabel" class="wd-slider__label-min">
      <text class="wd-slider__label-text">{{ minValue }}</text>
    </view>

    <!-- 滑块轨道区域 -->
    <view class="wd-slider__body" @click="handleTrackClick">
      <!-- 未激活轨道 -->
      <view
        :id="sliderId"
        class="wd-slider__track"
        :style="`height: ${inactiveHeight}rpx; border-radius: ${inactiveHeight / 2}rpx; background-color: ${inactiveColor};`"
      >
        <!-- 激活轨道 -->
        <view
          class="wd-slider__track-active"
          :style="`left: 0; width: ${barPercent}%; height: ${activeHeight}rpx; border-radius: ${activeHeight / 2}rpx; background-color: ${activeColor};`"
        />

        <!-- 滑块按钮 -->
        <view
          class="wd-slider__thumb-wrapper"
          :style="`left: ${barPercent}%;`"
          @touchstart.stop.prevent="onTouchStart"
          @touchmove.stop.prevent="onTouchMove"
          @touchend.stop.prevent="onTouchEnd"
          @touchcancel.stop.prevent="onTouchEnd"
        >
          <view class="wd-slider__thumb" :style="`width: ${thumbSize}rpx; height: ${thumbSize}rpx;`">
            <text v-if="showValue" class="wd-slider__thumb-text">{{ modelValue }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 滑块标签 -->
    <view v-if="showLabel" class="wd-slider__label-max">
      <text class="wd-slider__label-text">{{ maxValue }}</text>
    </view>
  </view>
</template>

<script lang="uts" setup>
import { computed, ref, onMounted } from 'vue'
import { uuid } from '../common/util'

/**
 * Slider 组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 当前值 */
  modelValue ?: number
  /** 是否禁用 */
  disabled ?: boolean
  /** 最小值 */
  min ?: number
  /** 最大值 */
  max ?: number
  /** 步进值 */
  step ?: number
  /** 是否显示当前值 */
  showValue ?: boolean
  /** 是否显示两端标签 */
  showLabel ?: boolean
  /** 激活轨道高度（rpx） */
  activeHeight ?: number
  /** 未激活轨道高度（rpx） */
  inactiveHeight ?: number
  /** 激活轨道颜色 */
  activeColor ?: string
  /** 未激活轨道颜色 */
  inactiveColor ?: string
  /** 滑块大小（rpx） */
  thumbSize ?: number
  /** 最小值标签 */
  minValue ?: string
  /** 最大值标签 */
  maxValue ?: string
}>(), {
  customStyle: '',
  customClass: '',
  modelValue: 0,
  disabled: false,
  min: 0,
  max: 100,
  step: 1,
  showValue: false,
  showLabel: false,
  activeHeight: 6,
  inactiveHeight: 6,
  activeColor: '#4D80F0',
  inactiveColor: '#E8E8E8',
  thumbSize: 48,
  minValue: '0',
  maxValue: '100',
})

const emit = defineEmits(['update:modelValue', 'change', 'dragstart', 'dragend'])

/* 唯一标识 */
const sliderId = `slider_${uuid()}`

/* 触摸状态 */
const startX = ref<number>(0)
const startValue = ref<number>(0)
const trackLeft = ref<number>(0)
const trackWidth = ref<number>(0)
const dragging = ref<boolean>(false)

/**
 * 计算进度百分比
 */
const barPercent = computed(() : number => {
  const range = props.max - props.min
  if (range <= 0) return 0
  const percent = ((props.modelValue - props.min) / range) * 100
  return Math.max(0, Math.min(100, percent))
})

/**
 * 获取轨道信息
 */
const getTrackRect = () => {
  uni.createSelectorQuery().in(this).select(`#${sliderId}`).boundingClientRect((rect) => {
    if (rect != null) {
      const rectObj = rect as UTSJSONObject
      trackLeft.value = (rectObj['left'] as number) ?? 0
      trackWidth.value = (rectObj['width'] as number) ?? 0
    }
  }).exec()
}

onMounted(() => {
  setTimeout(() => {
    getTrackRect()
  }, 100)
})

/**
 * 根据位置计算值
 */
const calcValueByPosition = (clientX : number) : number => {
  if (trackWidth.value <= 0) return props.modelValue

  const relativeX = clientX - trackLeft.value
  const percent = relativeX / trackWidth.value
  const range = props.max - props.min
  let value = props.min + range * percent

  /* 步进处理 */
  if (props.step > 0) {
    value = Math.round((value - props.min) / props.step) * props.step + props.min
  }

  /* 限制范围 */
  return Math.max(props.min, Math.min(props.max, value))
}

/**
 * 触摸开始
 */
const onTouchStart = (event : any) => {
  if (props.disabled) return

  getTrackRect()

  const touches = (event as UTSJSONObject)['touches'] as Array<UTSJSONObject>
  if (touches.length == 0) return
  const touch = touches[0]

  startX.value = (touch['clientX'] as number) ?? 0
  startValue.value = props.modelValue
  dragging.value = true

  emit('dragstart', { value: props.modelValue })
}

/**
 * 触摸移动
 */
const onTouchMove = (event : any) => {
  if (props.disabled || !dragging.value) return

  const touches = (event as UTSJSONObject)['touches'] as Array<UTSJSONObject>
  if (touches.length == 0) return
  const touch = touches[0]
  const clientX = (touch['clientX'] as number) ?? 0

  const newValue = calcValueByPosition(clientX)
  if (newValue != props.modelValue) {
    emit('update:modelValue', newValue)
    emit('change', { value: newValue })
  }
}

/**
 * 触摸结束
 */
const onTouchEnd = (_event : any) => {
  if (!dragging.value) return
  dragging.value = false
  emit('dragend', { value: props.modelValue })
}

/**
 * 点击轨道
 */
const handleTrackClick = (event : any) => {
  if (props.disabled) return

  getTrackRect()

  const detail = (event as UTSJSONObject)['detail'] as UTSJSONObject
  const clientX = (detail['x'] as number) ?? 0

  setTimeout(() => {
    const newValue = calcValueByPosition(clientX)
    if (newValue != props.modelValue) {
      emit('update:modelValue', newValue)
      emit('change', { value: newValue })
    }
  }, 50)
}
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(slider) {
  }
}

/* 滑块组件样式 */
@include b(slider) {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;

  /* 标签样式 */
  @include e(label-min) {
    margin-right: 16rpx;
  }

  @include e(label-max) {
    margin-left: 16rpx;
  }

  @include e(label-text) {
    font-size: 24rpx;
    color: #999;
  }

  /* 滑块主体 */
  @include e(body) {
    flex: 1;
    position: relative;
  }

  /* 轨道 */
  @include e(track) {
    width: 100%;
    position: relative;
  }

  /* 激活轨道 */
  @include e(track-active) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  /* 滑块按钮包装 */
  @include e(thumb-wrapper) {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  /* 滑块按钮 */
  @include e(thumb) {
    background-color: #fff;
    border-radius: 100px;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 滑块值文本 */
  @include e(thumb-text) {
    font-size: 22rpx;
    color: #333;
  }

  /* 禁用状态 */
  @include when(disabled) {
    opacity: 0.5;
  }
}
</style>
