/**
 * 网格容器提供的数据接口 - UniApp X 版本
 *
 * 与 plus-app 版本差异：
 * - 移除 InjectionKey 泛型（UTS 不支持 Symbol/InjectionKey）
 * - 改用字符串 key + type 定义
 * - 子组件管理通过 ChildManager 模式实现
 */

/**
 * 网格容器 Provide 接口
 */
export type GridProvide = {
  /** 子组件 UID 列表 */
  childUids : number[]
  /** 注册子组件 */
  addChild : (uid : number) => void
  /** 注销子组件 */
  removeChild : (uid : number) => void
  /** 是否开启格子点击反馈 */
  clickable : boolean
  /** 是否将格子固定为正方形 */
  square : boolean
  /** 列数 */
  column : number
  /** 是否显示边框 */
  border : boolean
  /** 背景颜色 */
  bgColor : string
  /** 格子之间的间距 */
  gutter : number
  /** 自定义内容区域hover-class */
  hoverClass : string
}

/**
 * 网格容器注入键（字符串 key）
 */
export const GRID_KEY = 'wd-grid'
