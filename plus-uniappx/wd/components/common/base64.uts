/**
 * Base64编码工具类 - UniApp X 版本
 *
 * 与 plus-app 版本差异：
 * - 移除 spread operator [...string]，改为 split('')
 * - Uint8Array 构建方式适配 UTS
 * - 移除浏览器 btoa 全局函数检测（UniApp X 非浏览器环境）
 */

/** Base64字符集 */
const _b64chars : string[] = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'.split('')

/**
 * 将字符串转换为UTF-8字节序列
 */
const utob = (src : string) : string => {
  const encoded : string = encodeURIComponent(src)!
  return encoded.replace(/%([0-9A-Fa-f]{2})/g, (_match : string, hex : string) : string => {
    return String.fromCharCode(parseInt(hex, 16))
  })
}

/**
 * 将标准Base64转换为URL安全格式
 */
const _mkUriSafe = (src : string) : string => {
  return src
    .replace(/[+/]/g, (m0 : string) : string => (m0 === '+' ? '-' : '_'))
    .replace(/=+$/m, '')
}

/**
 * 从字节数组转换为Base64字符串
 */
const fromByteArray = (bytes : number[], rfc4648 : boolean = false) : string => {
  let b64 = ''
  const l = bytes.length
  for (let i = 0; i < l; i += 3) {
    const a0 = bytes[i]
    const a1 = i + 1 < l ? bytes[i + 1] : -1
    const a2 = i + 2 < l ? bytes[i + 2] : -1

    const ord = ((a0 & 0xFF) << 16) | ((a1 >= 0 ? a1 & 0xFF : 0) << 8) | (a2 >= 0 ? a2 & 0xFF : 0)

    b64 += _b64chars[ord >>> 18]
    b64 += _b64chars[(ord >>> 12) & 63]
    b64 += a1 >= 0 ? _b64chars[(ord >>> 6) & 63] : '='
    b64 += a2 >= 0 ? _b64chars[ord & 63] : '='
  }
  return rfc4648 ? _mkUriSafe(b64) : b64
}

/**
 * 自定义 btoa 实现（将Latin-1字符串转换为Base64）
 */
const _btoa = (s : string) : string => {
  const bytes : number[] = []
  for (let i = 0; i < s.length; i++) {
    const code = s.charCodeAt(i)
    if (code > 255) {
      throw new Error('The string contains invalid characters.')
    }
    bytes.push(code)
  }
  return fromByteArray(bytes)
}

/**
 * 将字符串编码为Base64格式
 * @param src 要编码的字符串
 * @param rfc4648 是否使用RFC4648 URL安全格式（默认false）
 * @returns Base64编码后的字符串
 */
export const encode = (src : string, rfc4648 : boolean = false) : string => {
  const b64 = _btoa(utob(src))
  return rfc4648 ? _mkUriSafe(b64) : b64
}
