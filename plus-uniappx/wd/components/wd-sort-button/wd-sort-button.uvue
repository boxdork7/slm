<!--
SortButton 排序按钮 用于展示排序按钮，支持升序、降序、重置三种状态。

UniApp X 版本
- 移除 defineOptions
- 移除手动 wdIcon 导入（easycom 自动注册）
- edeep → e（UniApp X mixin）
- :deep() → 直接类选择器
- display: inline-block → display: flex
-->
<template>
  <view
    :class="`wd-sort-button ${line ? 'wd-sort-button--line' : ''} ${customClass}`"
    :style="customStyle"
    @click="handleClick"
  >
    <view class="wd-sort-button__wrapper">
      <view :class="`wd-sort-button__left ${modelValue !== 0 ? 'is-active' : ''}`">
        {{ title }}
      </view>
      <view :class="`wd-sort-button__right ${modelValue !== 0 ? 'is-active' : ''}`">
        <wd-icon v-if="modelValue !== 1" name="up" custom-class="wd-sort-button__icon-up" />
        <wd-icon v-if="modelValue !== -1" name="down" custom-class="wd-sort-button__icon-down" />
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
/**
 * 排序按钮组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 选中的箭头方向，1表示升序，0表示重置状态，-1表示降序 */
  modelValue ?: number
  /** 排序按钮展示的文案 */
  title ?: string
  /** 当展示双箭头时，是否允许手动重置按钮 */
  allowReset ?: boolean
  /** 是否优先切换为降序，如果不开启则默认优先切换为升序 */
  descFirst ?: boolean
  /** 是否展示下划线，当只有一个排序按钮时，通常不展示下划线 */
  line ?: boolean
}>(), {
  customStyle: '',
  customClass: '',
  modelValue: 0,
  title: '',
  allowReset: false,
  descFirst: false,
  line: true,
})

/** 组件事件 */
const emit = defineEmits(['change', 'update:modelValue'])

/**
 * 处理点击事件
 */
const handleClick = () => {
  let value = props.modelValue
  const allowReset = props.allowReset
  const descFirst = props.descFirst

  if (descFirst) {
    /** 优先降序模式：0 → -1 → 1 → (0 或 -1) */
    if (value === 0) {
      value = -1
    } else if (value === -1) {
      value = 1
    } else if (value === 1) {
      if (allowReset) {
        value = 0
      } else {
        value = -1
      }
    }
  } else {
    /** 优先升序模式：0 → 1 → -1 → (0 或 1) */
    if (value === 0) {
      value = 1
    } else if (value === 1) {
      value = -1
    } else if (value === -1) {
      if (allowReset) {
        value = 0
      } else {
        value = 1
      }
    }
  }

  emit('update:modelValue', value)
  emit('change', { value })
}
</script>

<style lang="scss">
@import '../../common/abstracts/variable';
@import '../../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(sort-button) {
    @include e(wrapper) {
      color: $-dark-color;
    }
  }
}

/* 排序按钮组件样式 */
@include b(sort-button) {
  display: flex;
  height: $-sort-button-height;
  line-height: $-sort-button-height;

  /* 下划线样式 */
  @include m(line) {
    .wd-sort-button__left {
      &::after {
        position: absolute;
        content: '';
        width: 38rpx;
        height: 4rpx;
        bottom: 8rpx;
        left: 50%;
        transform: translate(-50%, 0);
        background: $-sort-button-line-color;
        border-radius: calc($-sort-button-line-height / 2);
        transition: opacity 0.15s;
        opacity: 0;
      }

      &.is-active::after {
        opacity: 1;
      }
    }
  }

  /* 包装器样式 */
  @include e(wrapper) {
    font-size: $-sort-button-fs;
    color: $-sort-button-color;
    word-break: break-all;
    white-space: nowrap;
    font-size: 0;
  }

  /* 左侧文字区域 */
  @include e(left) {
    position: relative;
    display: flex;
    vertical-align: middle;
    line-height: normal;
    font-size: $-sort-button-fs;

    @include when(active) {
      font-weight: $-fw-medium;
    }
  }

  /* 右侧箭头区域 */
  @include e(right) {
    display: flex;
    vertical-align: middle;
    margin-left: 4rpx;
    width: 28rpx;
    height: 40rpx;
    position: relative;
    line-height: 1;
    font-size: 0;

    &.is-active {
      .wd-sort-button__icon-up,
      .wd-sort-button__icon-down {
        transform: scale(calc(10 / 14));
      }
    }
  }

  /* 向上箭头样式 */
  @include e(icon-up) {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transform: scale(calc(10 / 15));
    transform-origin: center top;
  }

  /* 向下箭头样式 */
  @include e(icon-down) {
    display: block !important;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    transform: scale(calc(10 / 15));
    transform-origin: center bottom;
  }
}
</style>
