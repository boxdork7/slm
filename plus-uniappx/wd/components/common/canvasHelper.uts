/**
 * Canvas 上下文适配器工具 - UniApp X 版本
 *
 * 与 plus-app 版本差异：
 * - UniApp X 使用 DrawableContext 而非 CanvasRenderingContext2D
 * - 移除 CanvasContext 适配（UniApp X 已原生支持 Canvas 2D API）
 * - 简化为辅助函数集合
 *
 * UniApp X 中 Canvas 使用方式：
 * ```uvue
 * <canvas id="myCanvas" style="width: 300px; height: 200px;"></canvas>
 *
 * <script setup lang="uts">
 * import { ref } from 'vue'
 *
 * const canvasRef = ref<UniElement | null>(null)
 *
 * const draw = () => {
 *   const ctx = canvasRef.value?.getDrawableContext()
 *   if (ctx == null) return
 *   ctx.fillStyle = '#ff0000'
 *   ctx.fillRect(0, 0, 100, 100)
 *   ctx.update()
 * }
 * </script>
 * ```
 */

/**
 * Canvas 绘制配置
 */
export type CanvasConfig = {
  /** 填充颜色 */
  fillStyle ?: string | null
  /** 描边颜色 */
  strokeStyle ?: string | null
  /** 线条宽度 */
  lineWidth ?: number
  /** 线条端点样式 */
  lineCap ?: string | null
  /** 线条连接样式 */
  lineJoin ?: string | null
  /** 字体设置 */
  font ?: string | null
  /** 全局透明度 */
  globalAlpha ?: number
  /** 文本对齐方式 */
  textAlign ?: string | null
  /** 文本基线 */
  textBaseline ?: string | null
}

/**
 * 绘制圆角矩形路径
 * UniApp X DrawableContext 可能不支持 roundRect，此函数手动绘制
 *
 * @param ctx - DrawableContext 实例
 * @param x - 矩形左上角 x 坐标
 * @param y - 矩形左上角 y 坐标
 * @param w - 矩形宽度
 * @param h - 矩形高度
 * @param r - 圆角半径
 */
export const drawRoundRect = (
  ctx : DrawableContext,
  x : number,
  y : number,
  w : number,
  h : number,
  r : number,
) : void => {
  const minSize = Math.min(w, h)
  const radius = r > minSize / 2 ? minSize / 2 : r

  ctx.beginPath()
  ctx.moveTo(x + radius, y)
  ctx.lineTo(x + w - radius, y)
  ctx.arc(x + w - radius, y + radius, radius, -Math.PI / 2, 0)
  ctx.lineTo(x + w, y + h - radius)
  ctx.arc(x + w - radius, y + h - radius, radius, 0, Math.PI / 2)
  ctx.lineTo(x + radius, y + h)
  ctx.arc(x + radius, y + h - radius, radius, Math.PI / 2, Math.PI)
  ctx.lineTo(x, y + radius)
  ctx.arc(x + radius, y + radius, radius, Math.PI, Math.PI * 3 / 2)
  ctx.closePath()
}

/**
 * 绘制圆形路径
 *
 * @param ctx - DrawableContext 实例
 * @param cx - 圆心 x 坐标
 * @param cy - 圆心 y 坐标
 * @param radius - 半径
 */
export const drawCircle = (
  ctx : DrawableContext,
  cx : number,
  cy : number,
  radius : number,
) : void => {
  ctx.beginPath()
  ctx.arc(cx, cy, radius, 0, 2 * Math.PI)
  ctx.closePath()
}
