/**
 * UniApp 缓存工具 (UniApp X 版本)
 *
 * 保持与 plus-app/utils/cache.ts 完全相同的导出接口
 *
 * 基于 UniApp 存储 API 的优化缓存封装
 * - 同步操作，性能更好
 * - 过期时间以秒为单位
 * - 自动添加应用前缀
 * - 过期数据自动清理
 *
 * UTS 适配说明：
 * - 使用 class 替代对象字面量（UTS 对 class 方法参数支持更完善）
 * - 移除泛型 <T>，使用 any | null 替代
 * - CacheWrapper 使用 UTSJSONObject 存储
 * - 统计信息返回具名类型 CacheStats
 */
import { SystemConfig } from '@/systemConfig'

/* 缓存键前缀，防止多应用冲突 */
const KEY_PREFIX = `${SystemConfig.app.id}:`

/**
 * 为缓存键添加应用前缀
 */
const getPrefixedKey = (key : string) : string => {
	return `${KEY_PREFIX}${key}`
}

/**
 * 缓存统计信息
 */
export type CacheStats = {
	totalKeys : number
	appKeys : number
	currentSize : number
	limitSize : number
	usagePercent : number
}

/**
 * 自动清理过期数据
 */
const autoCleanup = () => {
	try {
		const storageInfo = uni.getStorageInfoSync()
		const now = Date.now()
		const keysToRemove : string[] = []

		for (let i = 0; i < storageInfo.keys.length; i++) {
			const key = storageInfo.keys[i]
			if (key.startsWith(KEY_PREFIX)) {
				try {
					const raw = uni.getStorageSync(key)
					if (raw != null) {
						const rawObj = raw as UTSJSONObject
						const expire = rawObj['_expire'] as number | null
						if (expire != null && expire! < now) {
							keysToRemove.push(key)
						}
					}
				} catch (e) {
					keysToRemove.push(key)
				}
			}
		}

		for (let i = 0; i < keysToRemove.length; i++) {
			uni.removeStorageSync(keysToRemove[i])
		}

		if (keysToRemove.length > 0) {
			console.log(`清理了 ${keysToRemove.length} 个过期缓存项`)
		}
	} catch (e) {
		console.warn('自动清理失败:', e)
	}
}

/**
 * 缓存工具类
 *
 * 使用 class 实现（UTS 对 class 方法参数支持比对象字面量更完善）
 */
class CacheHelper {
	/**
	 * 设置缓存
	 * @param key 缓存键
	 * @param value 缓存值（UTSJSONObject 或 string 等）
	 * @param expireSeconds 过期时间（秒），0 或负数表示永不过期
	 */
	set(key : string, value : any | null, expireSeconds : number) : boolean {
		if (key.length == 0) {
			return false
		}

		try {
			const prefixedKey = getPrefixedKey(key)
			const wrapper = {} as UTSJSONObject
			wrapper['data'] = value
			if (expireSeconds > 0) {
				wrapper['_expire'] = Date.now() + expireSeconds * 1000
			}

			uni.setStorageSync(prefixedKey, wrapper)
			return true
		} catch (e) {
			console.error('缓存设置失败:', e)
			return false
		}
	}

	/**
	 * 获取缓存
	 * @param key 缓存键
	 * @returns 缓存值或 null
	 */
	get(key : string) : any | null {
		if (key.length == 0) {
			return null
		}

		try {
			const prefixedKey = getPrefixedKey(key)
			const raw = uni.getStorageSync(prefixedKey)

			if (raw == null) {
				return null
			}

			/* 检查过期时间 */
			const rawObj = raw as UTSJSONObject
			const expire = rawObj['_expire'] as number | null
			if (expire != null && expire! < Date.now()) {
				this.remove(key)
				return null
			}

			return rawObj['data']
		} catch (e) {
			console.error(`缓存获取失败 [${key}]:`, e)
			this.remove(key)
			return null
		}
	}

	/**
	 * 获取字符串类型缓存
	 */
	getString(key : string) : string | null {
		const val = this.get(key)
		if (val == null) return null
		return val as string
	}

	/**
	 * 获取数字类型缓存
	 */
	getNumber(key : string) : number | null {
		const val = this.get(key)
		if (val == null) return null
		return val as number
	}

	/**
	 * 获取布尔类型缓存
	 */
	getBoolean(key : string) : boolean | null {
		const val = this.get(key)
		if (val == null) return null
		return val as boolean
	}

	/**
	 * 移除缓存项
	 */
	remove(key : string) {
		if (key.length == 0) return

		try {
			const prefixedKey = getPrefixedKey(key)
			uni.removeStorageSync(prefixedKey)
		} catch (e) {
			console.error('缓存删除失败:', e)
		}
	}

	/**
	 * 检查缓存是否存在且未过期
	 */
	has(key : string) : boolean {
		return this.get(key) != null
	}

	/**
	 * 清除所有应用缓存
	 */
	clearAll() {
		try {
			const storageInfo = uni.getStorageInfoSync()
			let count = 0
			for (let i = 0; i < storageInfo.keys.length; i++) {
				const key = storageInfo.keys[i]
				if (key.startsWith(KEY_PREFIX)) {
					uni.removeStorageSync(key)
					count++
				}
			}
			console.log(`清除了 ${count} 个缓存项`)
		} catch (e) {
			console.error('清除缓存失败:', e)
		}
	}

	/**
	 * 手动清理过期缓存
	 */
	cleanup() {
		autoCleanup()
	}

	/**
	 * 获取缓存统计信息
	 */
	getStats() : CacheStats | null {
		try {
			const info = uni.getStorageInfoSync()
			let appKeyCount = 0
			for (let i = 0; i < info.keys.length; i++) {
				if (info.keys[i].startsWith(KEY_PREFIX)) {
					appKeyCount++
				}
			}

			const limitSize = info.limitSize > 0 ? info.limitSize : 10 * 1024 * 1024
			return {
				totalKeys: info.keys.length,
				appKeys: appKeyCount,
				currentSize: info.currentSize,
				limitSize: limitSize,
				usagePercent: Math.round((info.currentSize / limitSize) * 100),
			} as CacheStats
		} catch (e) {
			console.error('获取存储统计失败:', e)
			return null
		}
	}

	/**
	 * 获取缓存键的原始名称（移除前缀）
	 */
	getOriginalKey(prefixedKey : string) : string {
		if (prefixedKey.startsWith(KEY_PREFIX)) {
			return prefixedKey.substring(KEY_PREFIX.length)
		}
		return prefixedKey
	}
}

/**
 * 缓存工具实例（导出接口与原对象字面量完全一致）
 */
export const cache = new CacheHelper()

/* 应用启动时自动清理过期数据 */
setTimeout(() => {
	autoCleanup()
}, 1000)

/* 每10分钟清理一次过期数据 */
setInterval(() => {
	autoCleanup()
}, 10 * 60 * 1000)
