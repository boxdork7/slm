/**
 * 字符串工具类 (UniApp X 版本)
 *
 * 保持与 plus-app/utils/string.ts 核心功能一致
 *
 * 包含以下功能：
 * - 基本字符串操作 (parseStrEmpty, isEmpty, capitalize, truncate, byteLength, createUniqueString)
 * - 字符串格式化与替换 (sprintf)
 * - HTML 处理 (escapeHtml) - html2Text/getTextExcerpt 需要 DOM，仅 H5 可用
 * - URL 处理 (isExternal, isHttp, objectToQuery)
 * - 路径处理 (normalizePath, isPathMatch)
 * - 格式转换 (camelToKebab, kebabToCamel)
 * - 验证函数 (isValidJSON)
 *
 * UTS 适配说明：
 * - 移除依赖 document 的函数 (html2Text, getTextExcerpt, getQueryObject)
 * - any 参数改为 string | null
 * - Record<string, any> → UTSJSONObject
 */

/**
 * 转换可能为 null 的字符串为空字符串
 */
export const parseStrEmpty = (str : string | null) : string => {
	if (str == null) {
		return ''
	}
	const s = str as string
	if (s == 'undefined' || s == 'null') {
		return ''
	}
	return s
}

/**
 * 检查字符串是否为空
 */
export const isEmpty = (str : string | null) : boolean => {
	if (str == null) return true
	return (str as string).trim().length == 0
}

/**
 * 首字母大写
 */
export const capitalize = (str : string) : string => {
	if (str.length == 0) return ''
	return str.charAt(0).toUpperCase() + str.slice(1)
}

/**
 * 截断字符串到指定长度，并添加省略号
 */
export const truncate = (str : string, maxLength : number, ellipsis : string = '...') : string => {
	if (str.length == 0) return ''
	if (str.length <= maxLength) return str
	return str.substring(0, maxLength - ellipsis.length) + ellipsis
}

/**
 * 计算字符串的字节长度（UTF-8）
 */
export const byteLength = (str : string) : number => {
	if (str.length == 0) return 0

	let byteSize = 0
	for (let i = 0; i < str.length; i++) {
		const code = str.charCodeAt(i)
		if (code <= 0x7F) {
			byteSize += 1
		} else if (code <= 0x7FF) {
			byteSize += 2
		} else if (code >= 0xD800 && code <= 0xDFFF) {
			byteSize += 4
			i++
		} else {
			byteSize += 3
		}
	}
	return byteSize
}

/**
 * 创建唯一字符串标识
 */
export const createUniqueString = () : string => {
	const timestamp = Date.now().toString()
	const randomNum = Math.floor((1 + Math.random()) * 0x10000)
		.toString(16)
		.substring(1)
	return `${randomNum}${timestamp}`
}

/**
 * 格式化字符串 (类似于 printf 的 %s 格式)
 */
export const sprintf = (str : string, ...args : string[]) : string => {
	if (str.length == 0) return ''
	if (args.length == 0) return str

	let result = str
	let index = 0
	while (result.includes('%s') && index < args.length) {
		result = result.replace('%s', args[index])
		index++
	}
	/* 清理剩余的 %s */
	result = result.replace(/%s/g, '')
	return result
}

/**
 * 转义特殊字符，防止 XSS 攻击
 */
export const escapeHtml = (html : string) : string => {
	if (html.length == 0) return ''
	return html
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#039;')
}

/**
 * 判断 URL 是否为外部链接
 */
export const isExternal = (path : string) : boolean => {
	return path.startsWith('http://') || path.startsWith('https://') || path.startsWith('mailto:') || path.startsWith('tel:')
}

/**
 * 判断 URL 是否是 HTTP 或 HTTPS 链接
 */
export const isHttp = (url : string) : boolean => {
	return url.startsWith('http://') || url.startsWith('https://')
}

/**
 * 将参数对象转换为 URL 查询字符串
 */
export const objectToQuery = (params : UTSJSONObject) : string => {
	let result = ''
	const keys = Object.keys(params)

	for (let i = 0; i < keys.length; i++) {
		const key = keys[i]
		const value = params[key]
		if (value != null) {
			const strValue = `${value!}`
			if (strValue.length > 0) {
				result += `${encodeURIComponent(key)}=${encodeURIComponent(strValue)}&`
			}
		}
	}

	/* 移除末尾的 & */
	if (result.endsWith('&')) {
		result = result.substring(0, result.length - 1)
	}
	return result
}

/**
 * 处理路径，标准化路径格式
 */
export const normalizePath = (path : string) : string => {
	if (path.length == 0 || path == 'undefined') {
		return ''
	}

	/* 将多个连续斜杠替换为单个斜杠 */
	let normalized = path.replace(/\/+/g, '/')

	/* 移除末尾的斜杠 */
	if (normalized.endsWith('/')) {
		normalized = normalized.substring(0, normalized.length - 1)
	}

	return normalized
}

/**
 * 路径匹配器
 * 支持通配符 * (匹配单一段) 和 ** (匹配多段)
 */
export const isPathMatch = (pattern : string, path : string) : boolean => {
	if (pattern.length == 0 || path.length == 0) return false

	const regexPattern = pattern
		.replace(/\//g, '\\/')
		.replace(/\*\*/g, '__DOUBLE_STAR__')
		.replace(/\*/g, '[^\\/]*')
		.replace(/__DOUBLE_STAR__/g, '.*')

	const regex = new RegExp(`^${regexPattern}$`)
	return regex.test(path)
}

/**
 * 将驼峰命名转换为短横线命名(kebab-case)
 */
export const camelToKebab = (str : string) : string => {
	if (str.length == 0) return ''
	return str.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()
}

/**
 * 将短横线命名(kebab-case)转换为驼峰命名
 */
export const kebabToCamel = (str : string) : string => {
	if (str.length == 0) return ''
	return str.replace(/-([a-z])/g, (_, letter) => (letter as string).toUpperCase())
}

/**
 * 检查字符串是否是有效的 JSON
 */
export const isValidJSON = (str : string) : boolean => {
	if (str.length == 0) return false
	try {
		JSON.parse(str)
		return true
	} catch (_e) {
		return false
	}
}
