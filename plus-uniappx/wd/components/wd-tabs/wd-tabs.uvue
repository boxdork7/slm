<!--
Tabs 标签页 用于在不同的内容区域之间进行切换。

UniApp X 版本改动点：
1. 移除 defineOptions
2. 移除手动组件导入（easycom 自动注册）
3. TabItem/TabsSlidable 等类型移到 wd-tabs-key.uts
4. useChildren → createChildManager + provide 模式
5. 联合字面量类型改为 string
6. Record<string, any> → UTSJSONObject
7. ComponentPublicInstance 移除（UTS 不支持）
8. CSSProperties → Map<string, any> 然后用 objToStyle
9. nextTick → setTimeout(() => {}, 33)
10. any → 具体类型或 any | null
11. halfPixelBorder → border: 1rpx solid
12. edeep → e（无 :deep()）
13. getRect 使用 ../common/util 中的版本
14. ::before/::after 伪元素保留（样式文件中简化处理）
15. watch immediate 改为在 onMounted 中初始化
-->
<template>
  <!-- Sticky 模式 -->
  <block v-if="sticky">
    <wd-sticky-box>
      <view
        :class="`wd-tabs ${customClass} ${innerSlidable ? 'is-slide' : ''} ${mapNum < (isItemsMode ? items.length : children.length) && mapNum !== 0 ? 'is-map' : ''}`"
        :style="customStyle"
      >
        <wd-sticky :offset-top="offsetTop">
          <view class="wd-tabs__nav wd-tabs__nav--sticky">
            <view class="wd-tabs__nav--wrap">
              <scroll-view
                :scroll-x="innerSlidable"
                scroll-with-animation
                :scroll-left="state.scrollLeft"
              >
                <view class="wd-tabs__nav-container">
                  <!-- Items 模式：通过 items 数组渲染标签项 -->
                  <template v-if="isItemsMode">
                    <view
                      v-for="(item, index) in items"
                      :key="index"
                      :class="`wd-tabs__nav-item ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                      :style="
                        state.activeIndex === index
                          ? color
                            ? `color:${color}`
                            : ''
                          : inactiveColor
                            ? `color:${inactiveColor}`
                            : ''
                      "
                      @click="handleSelect(index)"
                    >
                      <wd-badge
                        v-if="item.badgeProps"
                        v-bind="item.badgeProps"
                        custom-class="wd-tabs__nav-item-badge"
                      >
                        <text class="wd-tabs__nav-item-text">
                          {{ item.title }}
                        </text>
                      </wd-badge>
                      <text v-else class="wd-tabs__nav-item-text">
                        {{ item.title }}
                      </text>
                      <view
                        v-if="state.activeIndex === index && state.useInnerLine"
                        class="wd-tabs__line wd-tabs__line--inner"
                      />
                    </view>
                  </template>

                  <!-- 子组件模式：使用 wd-tab 子组件 -->
                  <template v-else>
                    <view
                      v-for="(item, index) in children"
                      :key="`child-${index}`"
                      :class="`wd-tabs__nav-item ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                      :style="
                        state.activeIndex === index
                          ? color
                            ? `color:${color}`
                            : ''
                          : inactiveColor
                            ? `color:${inactiveColor}`
                            : ''
                      "
                      @click="handleSelect(index)"
                    >
                      <wd-badge
                        v-if="item.badgeProps"
                        v-bind="item.badgeProps"
                        custom-class="wd-tabs__nav-item-badge"
                      >
                        <text class="wd-tabs__nav-item-text">
                          {{ item.title }}
                        </text>
                      </wd-badge>
                      <text v-else class="wd-tabs__nav-item-text">
                        {{ item.title }}
                      </text>
                      <view
                        v-if="state.activeIndex === index && state.useInnerLine"
                        class="wd-tabs__line wd-tabs__line--inner"
                      />
                    </view>
                  </template>

                  <view class="wd-tabs__line" :style="state.lineStyle" />
                </view>
              </scroll-view>
            </view>
            <view
              v-if="
                mapNum < (isItemsMode ? items.length : children.length) &&
                mapNum !== 0
              "
              class="wd-tabs__map"
            >
              <view
                :class="`wd-tabs__map-btn ${state.animating ? 'is-open' : ''}`"
                @click="toggleMap"
              >
                <view :class="`wd-tabs__map-arrow ${state.animating ? 'is-open' : ''}`">
                  <wd-icon name="down" />
                </view>
              </view>
              <view
                class="wd-tabs__map-header"
                :style="`${state.mapShow ? '' : 'display:none;'} ${state.animating ? 'opacity:1;' : ''}`"
              >
                {{ mapTitle || translate('all') }}
              </view>
              <view
                :class="`wd-tabs__map-body ${state.animating ? 'is-open' : ''}`"
                :style="state.mapShow ? '' : 'display:none'"
              >
                <!-- Items 模式的地图导航 -->
                <template v-if="isItemsMode">
                  <view
                    v-for="(item, index) in items"
                    :key="`map-item-${index}`"
                    class="wd-tabs__map-nav-item"
                    @click="handleSelect(index)"
                  >
                    <view
                      :class="`wd-tabs__map-nav-btn ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                      :style="
                        state.activeIndex === index
                          ? color
                            ? `color:${color};border-color:${color}`
                            : ''
                          : inactiveColor
                            ? `color:${inactiveColor}`
                            : ''
                      "
                    >
                      {{ item.title }}
                    </view>
                  </view>
                </template>

                <!-- 子组件模式的地图导航 -->
                <template v-else>
                  <view
                    v-for="(item, index) in children"
                    :key="`map-child-${index}`"
                    class="wd-tabs__map-nav-item"
                    @click="handleSelect(index)"
                  >
                    <view
                      :class="`wd-tabs__map-nav-btn ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                      :style="
                        state.activeIndex === index
                          ? color
                            ? `color:${color};border-color:${color}`
                            : ''
                          : inactiveColor
                            ? `color:${inactiveColor}`
                            : ''
                      "
                    >
                      {{ item.title }}
                    </view>
                  </view>
                </template>
              </view>
            </view>
          </view>
        </wd-sticky>

        <view
          class="wd-tabs__container"
          @touchstart="onTouchStart"
          @touchmove="onTouchMove"
          @touchend="onTouchEnd"
          @touchcancel="onTouchEnd"
        >
          <view
            class="wd-tabs__body"
            :class="[animated ? 'is-animated' : '']"
            :style="bodyStyle"
          >
            <!-- Items 模式：通过 items 数组渲染内容 -->
            <template v-if="isItemsMode">
              <view
                v-for="(item, index) in items"
                :key="index"
                class="wd-tab"
                :style="`width: 100%; flex-shrink: 0; box-sizing: border-box;${shouldTabRender(item, index) ? '' : 'display: none;'}`"
              >
                <view
                  v-if="shouldTabRender(item, index)"
                  class="wd-tab__body"
                  :class="[{ 'wd-tab__body--inactive': state.activeIndex !== index }]"
                >
                  <!-- 自定义内容插槽 -->
                  <template v-if="item.useSlot">
                    <slot
                      :name="item.slotName || `item-${index}`"
                      :item="item"
                      :index="index"
                    />
                  </template>
                  <!-- 默认内容插槽 -->
                  <template v-else>
                    <slot :item="item" :index="index" />
                  </template>
                </view>
              </view>
            </template>

            <!-- 子组件模式：使用 wd-tab 子组件 -->
            <slot v-else />
          </view>
        </view>

        <view
          class="wd-tabs__mask"
          :style="`${state.mapShow ? '' : 'display:none;'} ${state.animating ? 'opacity:1;' : ''}`"
          @click="toggleMap"
        />
      </view>
    </wd-sticky-box>
  </block>

  <!-- 普通模式 -->
  <block v-else>
    <view
      :class="`wd-tabs ${customClass} ${innerSlidable ? 'is-slide' : ''} ${mapNum < (isItemsMode ? items.length : children.length) && mapNum !== 0 ? 'is-map' : ''}`"
      :style="customStyle"
    >
      <view class="wd-tabs__nav">
        <view class="wd-tabs__nav--wrap">
          <scroll-view
            :scroll-x="innerSlidable"
            scroll-with-animation
            :scroll-left="state.scrollLeft"
          >
            <view class="wd-tabs__nav-container">
              <!-- Items 模式：通过 items 数组渲染标签项 -->
              <template v-if="isItemsMode">
                <view
                  v-for="(item, index) in items"
                  :key="`sticky-item-${index}`"
                  :class="`wd-tabs__nav-item ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                  :style="
                    state.activeIndex === index
                      ? color
                        ? `color:${color}`
                        : ''
                      : inactiveColor
                        ? `color:${inactiveColor}`
                        : ''
                  "
                  @click="handleSelect(index)"
                >
                  <wd-badge
                    v-if="item.badgeProps"
                    v-bind="item.badgeProps"
                    custom-class="wd-tabs__nav-item-badge"
                  >
                    <text class="wd-tabs__nav-item-text">
                      {{ item.title }}
                    </text>
                  </wd-badge>
                  <text v-else class="wd-tabs__nav-item-text">
                    {{ item.title }}
                  </text>
                  <view
                    v-if="state.activeIndex === index && state.useInnerLine"
                    class="wd-tabs__line wd-tabs__line--inner"
                  />
                </view>
              </template>

              <!-- 子组件模式：使用 wd-tab 子组件 -->
              <template v-else>
                <view
                  v-for="(item, index) in children"
                  :key="`sticky-child-${index}`"
                  :class="`wd-tabs__nav-item ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                  :style="
                    state.activeIndex === index
                      ? color
                        ? `color:${color}`
                        : ''
                      : inactiveColor
                        ? `color:${inactiveColor}`
                        : ''
                  "
                  @click="handleSelect(index)"
                >
                  <wd-badge
                    v-if="item.badgeProps"
                    v-bind="item.badgeProps"
                    custom-class="wd-tabs__nav-item-badge"
                  >
                    <text class="wd-tabs__nav-item-text">
                      {{ item.title }}
                    </text>
                  </wd-badge>
                  <text v-else class="wd-tabs__nav-item-text">
                    {{ item.title }}
                  </text>
                  <view
                    v-if="state.activeIndex === index && state.useInnerLine"
                    class="wd-tabs__line wd-tabs__line--inner"
                  />
                </view>
              </template>

              <view class="wd-tabs__line" :style="state.lineStyle" />
            </view>
          </scroll-view>
        </view>
        <view
          v-if="
            mapNum < (isItemsMode ? items.length : children.length) &&
            mapNum !== 0
          "
          class="wd-tabs__map"
        >
          <view class="wd-tabs__map-btn" @click="toggleMap">
            <view :class="`wd-tabs__map-arrow ${state.animating ? 'is-open' : ''}`">
              <wd-icon name="down" />
            </view>
          </view>
          <view
            class="wd-tabs__map-header"
            :style="`${state.mapShow ? '' : 'display:none;'} ${state.animating ? 'opacity:1;' : ''}`"
          >
            {{ mapTitle || translate('all') }}
          </view>
          <view
            :class="`wd-tabs__map-body ${state.animating ? 'is-open' : ''}`"
            :style="state.mapShow ? '' : 'display:none'"
          >
            <!-- Items 模式的地图导航 -->
            <template v-if="isItemsMode">
              <view
                v-for="(item, index) in items"
                :key="index"
                class="wd-tabs__map-nav-item"
                @click="handleSelect(index)"
              >
                <view
                  :class="`wd-tabs__map-nav-btn ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                >
                  {{ item.title }}
                </view>
              </view>
            </template>

            <!-- 子组件模式的地图导航 -->
            <template v-else>
              <view
                v-for="(item, index) in children"
                :key="`normal-map-child-${index}`"
                class="wd-tabs__map-nav-item"
                @click="handleSelect(index)"
              >
                <view
                  :class="`wd-tabs__map-nav-btn ${state.activeIndex === index ? 'is-active' : ''} ${item.disabled ? 'is-disabled' : ''}`"
                >
                  {{ item.title }}
                </view>
              </view>
            </template>
          </view>
        </view>
      </view>

      <view
        class="wd-tabs__container"
        @touchstart="onTouchStart"
        @touchmove="onTouchMove"
        @touchend="onTouchEnd"
        @touchcancel="onTouchEnd"
      >
        <view
          class="wd-tabs__body"
          :class="[animated ? 'is-animated' : '']"
          :style="bodyStyle"
        >
          <!-- Items 模式：通过 items 数组渲染内容 -->
          <template v-if="isItemsMode">
            <view
              v-for="(item, index) in items"
              :key="`content-item-${index}`"
              class="wd-tab"
              :style="`width: 100%; flex-shrink: 0; box-sizing: border-box;${shouldTabRender(item, index) ? '' : 'display: none;'}`"
            >
              <view
                v-if="shouldTabRender(item, index)"
                class="wd-tab__body"
                :class="[{ 'wd-tab__body--inactive': state.activeIndex !== index }]"
              >
                <!-- 自定义内容插槽 -->
                <template v-if="item.useSlot">
                  <slot
                    :name="item.slotName || `item-${index}`"
                    :item="item"
                    :index="index"
                  />
                </template>
                <!-- 默认内容插槽 -->
                <template v-else>
                  <slot :item="item" :index="index" />
                </template>
              </view>
            </view>
          </template>

          <!-- 子组件模式：使用 wd-tab 子组件 -->
          <slot v-else />
        </view>
      </view>

      <view
        class="wd-tabs__mask"
        :style="`${state.mapShow ? '' : 'display:none;'} ${state.animating ? 'opacity:1' : ''}`"
        @click="toggleMap"
      />
    </view>
  </block>
</template>

<script lang="uts" setup>
import { computed, reactive, watch, onMounted, provide } from 'vue'
import {
  addUnit,
  checkNumRange,
  debounce,
  getRect,
  isDef,
  isNumber,
  isString,
  objToStyle,
} from '../common/util'
import { createChildManager } from '../../composables/useChildren'
import { useTouch } from '../../composables/useTouch'
import { useTranslate } from '../../composables/useTranslate'
import { TABS_KEY, type TabItem, type TabsSlidable, type TabsProvide, type TabsState, type TabsProps } from './wd-tabs-key'

/**
 * 标签页组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 标签页数据数组 */
  items ?: TabItem[]
  /** 绑定值 */
  modelValue ?: string | number
  /** 标签数超过阈值可滑动 */
  slidableNum ?: number
  /** 标签数超过阈值显示导航地图 */
  mapNum ?: number
  /** 导航地图的标题 */
  mapTitle ?: string
  /** 粘性布局 */
  sticky ?: boolean
  /** 粘性布局吸顶位置 */
  offsetTop ?: number
  /** 开启手势滑动 */
  swipeable ?: boolean
  /** 自动调整底部条宽度,设置了 lineWidth 后无效 */
  autoLineWidth ?: boolean
  /** 底部条宽度,单位像素 */
  lineWidth ?: string | number
  /** 底部条高度,单位像素 */
  lineHeight ?: string | number
  /** 颜色 */
  color ?: string
  /** 非活动状态颜色 */
  inactiveColor ?: string
  /** 是否开启切换标签内容时的过渡动画 */
  animated ?: boolean
  /** 切换动画过渡时间,单位毫秒 */
  duration ?: number
  /** 是否开启滚动导航 */
  slidable ?: string
}>(), {
  customStyle: '',
  customClass: '',
  items: () : TabItem[] => [],
  modelValue: 0,
  slidableNum: 6,
  slidable: 'auto',
  mapNum: 10,
  mapTitle: '',
  sticky: false,
  offsetTop: 0,
  swipeable: false,
  autoLineWidth: false,
  lineWidth: '',
  lineHeight: '',
  color: '',
  inactiveColor: '',
  animated: false,
  duration: 300,
})

/** 定义组件事件 */
const emit = defineEmits(['update:modelValue', 'change', 'disabled', 'click'])

/** 选择器常量 */
const $item = '.wd-tabs__nav-item'
const $itemText = '.wd-tabs__nav-item-text'
const $container = '.wd-tabs__nav-container'

/** 响应式状态 */
const state = reactive<TabsState>({
  activeIndex: 0,
  lineStyle: 'display:none;',
  useInnerLine: false,
  inited: false,
  animating: false,
  mapShow: false,
  scrollLeft: 0,
})

/** 子组件管理（用于兼容 wd-tab 子组件模式） */
const manager = createChildManager()

/** 子组件列表（响应式计算） */
const children = computed(() : any[] => {
  // 这里需要从子组件收集数据,在 UniApp X 中简化处理
  // 实际应用中,子组件通过 inject 获取 tabs 实例并注册自己的数据
  return []
})

/** 多语言 */
const { translate } = useTranslate('tabs')

/** 触摸手势 */
const touch = useTouch()

/**
 * 判断是否使用 items 模式
 */
const isItemsMode = computed(() : boolean => {
  return props.items.length > 0
})

/**
 * 是否可滑动
 */
const innerSlidable = computed(() : boolean => {
  const totalCount = isItemsMode.value ? props.items.length : children.value.length
  return props.slidable === 'always' || totalCount > props.slidableNum
})

/**
 * 计算标签页内容区域样式
 */
const bodyStyle = computed(() : string => {
  if (!props.animated) {
    return ''
  }

  return `left: ${-100 * state.activeIndex}%; transition-duration: ${props.duration}ms; -webkit-transition-duration: ${props.duration}ms;`
})

/**
 * Provide 数据给子组件
 */
const tabsProps : TabsProps = {
  slidableNum: props.slidableNum,
  mapNum: props.mapNum,
  mapTitle: props.mapTitle,
  sticky: props.sticky,
  offsetTop: props.offsetTop,
  swipeable: props.swipeable,
  autoLineWidth: props.autoLineWidth,
  lineWidth: props.lineWidth as string | number,
  lineHeight: props.lineHeight as string | number,
  color: props.color,
  inactiveColor: props.inactiveColor,
  animated: props.animated,
  duration: props.duration,
  slidable: props.slidable,
}

const tabsProvide : TabsProvide = {
  childUids: manager.childUids,
  addChild: manager.addChild,
  removeChild: manager.removeChild,
  state: state,
  props: tabsProps,
}

provide(TABS_KEY, tabsProvide)

/**
 * 获取标签名称
 */
const getTabName = (tab : UTSJSONObject, index : number) : string | number => {
  const name = tab['name']
  return isDef(name) ? `${name}` : index
}

/**
 * 获取激活项索引
 */
const getActiveIndex = (value : number | string) : number => {
  const totalCount = isItemsMode.value ? props.items.length : children.value.length
  const dataSource = isItemsMode.value ? props.items : children.value

  let resultValue = value

  // name代表的索引超过了children长度的边界,自动用0兜底
  if (isNumber(resultValue) && (resultValue as number) >= totalCount) {
    console.error(
      `warning(wd-tabs): the type of tabs' value is Number shouldn't be less than its children`,
    )
    resultValue = 0
  }
  // 如果是字符串直接匹配,匹配不到用0兜底
  if (isString(resultValue)) {
    const index = dataSource.findIndex((item : any) : boolean => item.name === resultValue)
    resultValue = index === -1 ? 0 : index
  }

  return resultValue as number
}

/**
 * 更新 underline的偏移量
 */
const updateLineStyle = async (animation : boolean = true) => {
  if (!state.inited) return
  const { autoLineWidth, lineWidth, lineHeight } = props
  try {
    /* 直接拼接 style 字符串，避免 Map + objToStyle 在 H5 中 Object.keys 无法遍历 Map 的问题 */
    const parts : string[] = []
    if (isDef(lineWidth) && lineWidth != '') {
      parts.push(`width: ${addUnit(lineWidth as string | number)}`)
    } else {
      if (autoLineWidth) {
        const textRects = await getRect($itemText, true)
        if (textRects != null && Array.isArray(textRects) && textRects.length > state.activeIndex) {
          const textWidth = textRects[state.activeIndex].width as number
          parts.push(`width: ${addUnit(textWidth)}`)
        }
      }
    }
    if (isDef(lineHeight) && lineHeight != '') {
      parts.push(`height: ${addUnit(lineHeight as string | number)}`)
      parts.push(`border-radius: calc(${addUnit(lineHeight as string | number)} / 2)`)
    }
    const rects = await getRect($item, true)
    if (rects != null && Array.isArray(rects) && rects.length > state.activeIndex) {
      const rect = rects[state.activeIndex]
      const left =
        rects.slice(0, state.activeIndex).reduce((prev : number, curr : any) : number => {
          return prev + (curr.width as number)
        }, 0) +
        (rect.width as number) / 2
      if (left) {
        parts.push(`transform: translateX(${left}px) translateX(-50%)`)
        if (animation) {
          parts.push('transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)')
        }
        state.useInnerLine = false
        state.lineStyle = parts.length > 0 ? `${parts.join('; ')};` : ''
      }
    }
  } catch (error) {
    console.error('error(wd-tabs): update line style failed', error)
  }
}

/**
 * 滚动到可视区域
 */
const scrollIntoView = async () => {
  if (!state.inited) return
  try {
    const navItemsRects = await getRect($item, true)
    const navRect = await getRect($container, false)
    if (navItemsRects == null || navRect == null) return
    if (!Array.isArray(navItemsRects)) return
    if (navItemsRects.length <= state.activeIndex) return

    // 选中元素
    const selectItem = navItemsRects[state.activeIndex]
    // 选中元素之前的节点的宽度总和
    const offsetLeft = navItemsRects
      .slice(0, state.activeIndex)
      .reduce((prev : number, curr : any) : number => {
        return prev + (curr.width as number)
      }, 0)
    // scroll-view滑动到selectItem的偏移量
    const left = offsetLeft - ((navRect.width as number) - (selectItem.width as number)) / 2
    if (left === state.scrollLeft) {
      state.scrollLeft = left + Math.random() / 10000
    } else {
      state.scrollLeft = left
    }
  } catch (error) {
    console.error('error(wd-tabs): scroll into view failed', error)
  }
}

/**
 * 设置激活标签
 */
const setActiveTab = () => {
  if (!state.inited) return
  const dataSource = isItemsMode.value ? props.items : children.value
  const name = getTabName(dataSource[state.activeIndex], state.activeIndex)
  if (name !== props.modelValue) {
    emit('change', {
      index: state.activeIndex,
      name,
    })
    emit('update:modelValue', name)
  }
}

/**
 * 更新激活项
 */
const updateActive = (
  value : number | string = 0,
  init : boolean = false,
  setScroll : boolean = true,
) => {
  const totalCount = isItemsMode.value ? props.items.length : children.value.length
  const dataSource = isItemsMode.value ? props.items : children.value

  // 没有tab子元素,不执行任何操作
  if (totalCount === 0) return

  const index = getActiveIndex(value)
  // 被禁用,不执行任何操作
  if (dataSource[index].disabled) return

  state.activeIndex = index
  if (setScroll) {
    updateLineStyle(init === false)
    scrollIntoView()
  }
  setActiveTab()
}

/**
 * 修改选中的tab Index
 */
const setActive = debounce(updateActive, 100, { leading: true })

/**
 * 切换地图显示状态
 */
const toggleMap = () => {
  if (state.mapShow) {
    state.animating = false
    setTimeout(() => {
      state.mapShow = false
    }, 300)
  } else {
    state.mapShow = true
    setTimeout(() => {
      state.animating = true
    }, 100)
  }
}

/**
 * 处理标签选择
 */
const handleSelect = (index : number) => {
  if (index === undefined) return
  const dataSource = isItemsMode.value ? props.items : children.value
  const { disabled } = dataSource[index]
  const name = getTabName(dataSource[index], index)

  if (disabled) {
    emit('disabled', {
      index,
      name,
    })
    return
  }
  state.mapShow && toggleMap()
  setActive(index)
  emit('click', {
    index,
    name,
  })
}

/**
 * 触摸开始
 */
const onTouchStart = (event : UniTouchEvent) => {
  if (!props.swipeable) return
  touch.touchStart(event)
}

/**
 * 触摸移动
 */
const onTouchMove = (event : UniTouchEvent) => {
  if (!props.swipeable) return
  touch.touchMove(event)
}

/**
 * 触摸结束
 */
const onTouchEnd = () => {
  if (!props.swipeable) return
  const { direction, deltaX, offsetX } = touch
  const minSwipeDistance = 50
  const totalCount = isItemsMode.value ? props.items.length : children.value.length

  if (direction.value === 'horizontal' && offsetX.value >= minSwipeDistance) {
    if (deltaX.value > 0 && state.activeIndex !== 0) {
      setActive(state.activeIndex - 1)
    } else if (deltaX.value < 0 && state.activeIndex !== totalCount - 1) {
      setActive(state.activeIndex + 1)
    }
  }
}

/**
 * 判断标签页是否应该渲染（用于 items 模式）
 */
const shouldTabRender = (item : TabItem, index : number) : boolean => {
  const isActive = state.activeIndex === index
  const isLazy = item.lazy !== false
  return !isLazy || isActive
}

/**
 * 监听绑定值变化
 */
watch(
  () => props.modelValue,
  (newValue : string | number) => {
    if (!isNumber(newValue) && !isString(newValue)) {
      console.error('error(wd-tabs): the type of value should be number or string')
    }
    if (newValue === '' || !isDef(newValue)) {
      console.error(`error(wd-tabs): tabs's value cannot be '' null or undefined`)
    }
    if (typeof newValue === 'number' && newValue < 0) {
      console.error(`error(wd-tabs): tabs's value cannot be less than zero`)
    }
  },
  {
    immediate: true,
    deep: true,
  },
)

/**
 * 监听绑定值变化并更新激活项
 */
watch(
  () => props.modelValue,
  (newValue : string | number) => {
    const index = getActiveIndex(newValue)
    setActive(newValue, false, index !== state.activeIndex)
  },
  {
    immediate: false,
    deep: true,
  },
)

/**
 * 监听子组件数量变化（仅在子组件模式下）
 */
watch(
  () => children.value.length,
  async () => {
    if (state.inited && !isItemsMode.value) {
      setTimeout(() => {
        setActive(props.modelValue)
      }, 33)
    }
  },
)

/**
 * 监听items数量变化（仅在items模式下）
 */
watch(
  () => props.items.length,
  async () => {
    if (state.inited && isItemsMode.value) {
      setTimeout(() => {
        setActive(props.modelValue)
      }, 33)
    }
  },
)

/**
 * 监听可滑动数量阈值变化
 */
watch(
  () => props.slidableNum,
  (newValue : number) => {
    checkNumRange(newValue, 'slidableNum')
  },
)

/**
 * 监听地图导航数量阈值变化
 */
watch(
  () => props.mapNum,
  (newValue : number) => {
    checkNumRange(newValue, 'mapNum')
  },
)

/**
 * 组件挂载后初始化
 */
onMounted(async () => {
  state.inited = true
  setTimeout(() => {
    updateActive(props.modelValue, true)
    state.useInnerLine = true
  }, 33)
})

/** 暴露给父组件的方法和属性 */
defineExpose({
  setActive,
  scrollIntoView,
  updateLineStyle,
})
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(tabs) {
    background: $-dark-background2;

    @include e(nav) {
      background: $-dark-background2;
    }

    @include e(nav-item) {
      color: $-dark-color3;

      @include when(active) {
        font-weight: 600;
        color: $-dark-color;
      }

      @include when(disabled) {
        color: $-dark-color-gray;
      }
    }

    @include e(map-nav-btn) {
      background-color: $-dark-background4;
      color: $-dark-color3;

      @include when(active) {
        color: $-dark-color;
        border: 1rpx solid $-tabs-nav-active-color;
        background-color: $-dark-background;
      }

      @include when(disabled) {
        color: $-dark-color-gray;
        border-color: #f4f4f4;
      }
    }

    @include e(map-btn) {
      background: $-dark-background2;
      color: $-dark-color3;
    }

    @include e(map-header) {
      background: $-dark-background2;
      color: $-dark-color;

      &::after {
        background: $-dark-background4;
      }
    }

    @include e(map-body) {
      background: $-dark-background2;
    }
  }
}

/* 标签页容器样式 */
@include b(tabs) {
  position: relative;
  background: #fff;
  width: 100%;

  @include e(nav) {
    left: 0;
    right: 0;
    height: $-tabs-nav-height;
    background-color: #fff;
    width: 100%;
    position: relative;

    @include m(wrap) {
      height: 100%;
      overflow: hidden;
    }

    @include m(sticky) {
      width: 100vw;
    }
  }

  @include e(nav-container) {
    position: relative;
    display: flex;
    /* UniApp X 的 view 默认 flex-direction: column，需显式覆盖为行布局 */
    flex-direction: row;
    user-select: none;
  }

  @include e(nav-item) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 0;
    height: $-tabs-nav-height;
    font-size: $-tabs-nav-fs;
    color: $-tabs-nav-color;
    transition: color 0.3s;

    @include when(active) {
      font-weight: 600;
    }

    @include when(disabled) {
      color: $-tabs-nav-disabled-color;
    }
  }

  @include e(nav-item-text) {
    @include lineEllipsis();
  }

  /* edeep → e（UniApp X 无 :deep()） */
  .wd-tabs__nav-item-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-width: 0;
  }

  @include e(line) {
    position: absolute;
    bottom: 8rpx;
    left: 0;
    z-index: 1;
    height: $-tabs-nav-line-height;
    width: $-tabs-nav-line-width;
    background: $-tabs-nav-line-bg-color;
    border-radius: calc($-tabs-nav-line-height / 2);

    @include m(inner) {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @include e(container) {
    overflow: hidden;
  }

  @include e(body) {
    position: relative;
    width: 100%;
    height: 100%;

    @include when(animated) {
      display: flex;
      transition-property: left;
    }
  }

  @include e(map) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
  }

  @include e(map-btn) {
    position: absolute;
    right: 0;
    top: 0;
    width: $-tabs-nav-height;
    height: $-tabs-nav-height;
    line-height: $-tabs-nav-height;
    text-align: center;
    color: $-tabs-nav-map-arrow-color;
    z-index: 1;
    background: $-tabs-nav-bg;
    -webkit-tap-highlight-color: transparent;

    /* ::before 简化 */
    &::before {
      position: absolute;
      content: '';
      top: 0;
      left: -48rpx;
      width: 48rpx;
      height: $-tabs-nav-height - 1;
      background: $-tabs-nav-map-btn-before-bg;
    }
  }

  @include e(map-arrow) {
    display: block;
    transition: transform 0.3s;

    @include when(open) {
      transform: rotate(180deg);
    }
  }

  @include e(map-header) {
    position: relative;
    padding-left: 34rpx;
    height: $-tabs-nav-height;
    line-height: $-tabs-nav-height;
    font-size: $-tabs-nav-map-fs;
    color: $-tabs-nav-map-color;
    transition: opacity 0.3s;
    background: #fff;
    opacity: 0;

    /* halfPixelBorder 替换为直接 border */
    border-bottom: 1rpx solid #ebedf0;

    &::after {
      z-index: 3;
    }
  }

  @include e(map-body) {
    display: flex;
    flex-wrap: wrap;
    padding: 40rpx 30rpx 20rpx;
    background: #fff;
    transition: transform 0.3s;
    transform: scaleY(0);
    transform-origin: center top;

    @include when(open) {
      transform: scaleY(1);
    }
  }

  @include e(map-nav-item) {
    flex-basis: 33%;

    &:nth-child(3n + 2) {
      text-align: center;
    }

    &:nth-child(3n + 3) {
      text-align: right;
    }
  }

  @include e(map-nav-btn) {
    @include buttonClear;
    @include lineEllipsis;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 214rpx;
    height: 64rpx;
    line-height: 64rpx;
    background-color: $-tabs-nav-map-button-back-color;
    border-color: transparent;
    margin-bottom: 20rpx;
    border-radius: $-tabs-nav-map-button-radius;
    color: $-tabs-nav-map-color;
    font-size: $-tabs-nav-map-fs;
    text-align: center;
    transition:
      color 0.3s,
      border-color 0.3s;

    @include when(active) {
      color: $-tabs-nav-active-color;
      border: 1rpx solid $-tabs-nav-active-color;
      background-color: $-tabs-nav-bg;
    }

    @include when(disabled) {
      color: $-tabs-nav-disabled-color;
      border-color: #f4f4f4;
    }
  }

  @include e(mask) {
    position: absolute;
    top: $-tabs-nav-height;
    left: 0;
    right: 0;
    bottom: 0;
    background: $-tabs-nav-map-modal-bg;
    opacity: 0;
    transition: opacity 0.3s;
  }

  @include when(slide) {
    .wd-tabs__nav-item {
      flex: 0 0 auto;
      padding: 0 34rpx;
    }
  }

  @include when(map) {
    .wd-tabs__nav--wrap {
      padding-right: 80rpx;
    }
  }
}

/* Tab 标签页样式 */
@include b(tab) {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;

  @include e(body) {
    @include m(inactive) {
      height: 0;
      transition: height 0.3s ease-in-out;
    }
  }
}

@media screen and (max-width: 330px) {
  .wd-tabs__map-nav-btn {
    width: 180rpx;
  }
}

/* 隐藏滚动条 - edeep → 直接类选择器 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
</style>
