<!--
CountDown 倒计时 用于实时展示倒计时数值,支持毫秒精度。

UniApp X 版本
- 移除 defineOptions
- 移除 ComponentPublicInstance
- 使用 composables/useCountDown.uts
- padZero 从 ../common/util 导入
-->
<template>
  <view :class="`wd-count-down ${customClass}`" :style="customStyle">
    <slot v-if="$slots.default" :current="current" />
    <block v-else>
      {{ parseFormat(format, current) }}
    </block>
  </view>
</template>

<script lang="uts" setup>
import { onMounted, watch } from 'vue'
import { padZero } from '../common/util'
import { useCountDown } from '../../composables/useCountDown'

/** 时间数据结构 */
type TimeData = {
  days: number
  hours: number
  minutes: number
  seconds: number
  milliseconds: number
}

/**
 * 倒计时组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 倒计时时长,单位毫秒 */
  time : number
  /** 是否开启毫秒 */
  millisecond ?: boolean
  /** 格式化时间 */
  format ?: string
  /** 是否自动开始 */
  autoStart ?: boolean
}>(), {
  customStyle: '',
  customClass: '',
  millisecond: false,
  format: 'HH:mm:ss',
  autoStart: true,
})

/** 组件事件 */
const emit = defineEmits<{
  /** 倒计时变化时触发 */
  change: [current: TimeData]
  /** 倒计时结束时触发 */
  finish: []
}>()

/** 使用倒计时组合函数 */
const { start, pause, reset, current } = useCountDown({
  time: props.time,
  millisecond: props.millisecond,
  onChange: (current) => {
    emit('change', {
      days: current.days,
      hours: current.hours,
      minutes: current.minutes,
      seconds: current.seconds,
      milliseconds: current.milliseconds,
    } as TimeData)
  },
  onFinish: () => { emit('finish') },
})

/**
 * 解析时间格式
 */
const parseFormat = (fmt : string, timeData : TimeData) : string => {
  let format = fmt
  const { days } = timeData
  let { hours, minutes, seconds, milliseconds } = timeData

  // 处理天数
  if (format.includes('DD')) {
    format = format.replace('DD', padZero(days))
  } else {
    hours += days * 24
  }

  // 处理小时
  if (format.includes('HH')) {
    format = format.replace('HH', padZero(hours))
  } else {
    minutes += hours * 60
  }

  // 处理分钟
  if (format.includes('mm')) {
    format = format.replace('mm', padZero(minutes))
  } else {
    seconds += minutes * 60
  }

  // 处理秒数
  if (format.includes('ss')) {
    format = format.replace('ss', padZero(seconds))
  } else {
    milliseconds += seconds * 1000
  }

  // 处理毫秒
  if (format.includes('S')) {
    const ms = padZero(milliseconds, 3)

    if (format.includes('SSS')) {
      format = format.replace('SSS', ms)
    } else if (format.includes('SS')) {
      format = format.replace('SS', ms.slice(0, 2))
    } else {
      format = format.replace('S', ms.charAt(0))
    }
  }

  return format
}

/**
 * 重置倒计时
 */
const resetTime = () : void => {
  reset(props.time)
  if (props.autoStart) {
    start()
  }
}

/** 监听 time 属性变化 */
watch(() => props.time, resetTime, { immediate: false })

/** 组件挂载后初始化倒计时 */
onMounted(() => {
  resetTime()
})

/** 暴露组件方法 */
defineExpose({
  start,
  pause,
  reset: resetTime,
})
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

.wot-theme-dark {
  @include b(count-down) {
    color: $-dark-color;
  }
}

@include b(count-down) {
  color: $-count-down-text-color;
  font-size: $-count-down-font-size;
  line-height: $-count-down-line-height;
}
</style>
