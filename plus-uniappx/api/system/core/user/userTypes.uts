import { SysRoleVo } from '../role/roleTypes'
import { SysPostVo } from '../post/postTypes'

/**
 * 用户信息查询类型
 */
export type SysUserQuery = {
  /** 用户账号 */
  userName?: string

  /** 用户昵称 */
  nickName?: string

  /** 手机号码 */
  phone?: string

  /** 部门id */
  deptId?: string | number

  /** 帐号状态 */
  status?: string

  /** 角色id */
  roleId?: string | number

  /** 租户ID */
  tenantId?: string

  /** 用户类型 */
  userType?: string

  /* PageQuery 扁平化字段 */
  /** 分页页码 */
  pageNum?: number

  /** 分页大小 */
  pageSize?: number

  /** 排序字段 */
  orderByColumn?: string

  /** 是否升序 */
  isAsc?: string
}

/**
 * 用户信息表单类型
 */
export type SysUserBo = {
  /** 用户ID */
  userId?: string | number

  /** 部门ID */
  deptId?: string | number

  /** 用户账号 */
  userName?: string

  /** 用户昵称 */
  nickName?: string

  /** 用户类型 */
  userType?: string

  /** 用户邮箱 */
  email?: string

  /** 手机号码 */
  phone?: string

  /** 用户性别 */
  sex?: string

  /** 头像地址 */
  avatar?: string

  /** 密码 */
  password?: string

  /** 帐号状态 */
  status?: string

  /** 备注 */
  remark?: string

  /** 角色id列表 */
  roleIds?: number[]

  /** 岗位id列表 */
  postIds?: number[]
}

/**
 * 用户部门信息
 */
export type SysUserDeptVo = {
  /** 部门ID */
  deptId: string | number

  /** 部门名称 */
  deptName: string

  /** 部门负责人 */
  leader: string
}

/**
 * 用户信息视图类型
 */
export type SysUserVo = {
  /** 用户ID */
  userId: string | number

  /** 租户id */
  tenantId: string

  /** 部门ID */
  deptId: string | number

  /** 用户账号 */
  userName: string

  /** 用户昵称 */
  nickName: string

  /** 用户类型 */
  userType: string

  /** 用户邮箱 */
  email: string

  /** 手机号码 */
  phone: string

  /** 用户性别 */
  sex: string

  /** 头像地址 */
  avatar: string

  /** 帐号状态 */
  status: string

  /** 最后登录IP */
  loginIp: string

  /** 最后登录时间 */
  loginDate: string

  /** 创建人 */
  createBy: string | number

  /** 创建时间 */
  createTime: string

  /** 更新时间 */
  updateTime: string

  /** 备注 */
  remark: string

  /** 角色列表 */
  roles: SysRoleVo[]

  /** 角色id列表 */
  roleIds: number[]

  /** 岗位id列表 */
  postIds: number[]

  /** 角色id */
  roleId: string | number

  /** 部门信息 */
  dept: SysUserDeptVo
}

/**
 * 用户信息
 */
export type UserInfoVo = {
  /** 用户基本信息 */
  user: SysUserVo

  /** 角色标识符列表 */
  roles: string[]

  /** 权限标识符列表 */
  permissions: string[]
}

/**
 * 用户密码信息
 */
export type SysUserPasswordBo = {
  /** 旧密码 */
  oldPassword: string

  /** 新密码 */
  newPassword: string
}

/**
 * 用户个人信息
 */
export type ProfileVo = {
  /** 用户信息 */
  user: SysUserVo

  /** 用户所属角色组 */
  roleGroup: string

  /** 用户所属岗位组 */
  postGroup: string
}

/**
 * 用户详细信息
 */
export type SysUserInfoVo = {
  /** 用户信息 */
  user: SysUserVo

  /** 角色列表 */
  roles: SysRoleVo[]

  /** 角色ID列表 */
  roleIds: number[]

  /** 岗位列表 */
  posts: SysPostVo[]

  /** 岗位ID列表 */
  postIds: number[]
}
