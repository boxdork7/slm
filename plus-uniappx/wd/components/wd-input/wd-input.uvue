<!--
Input 输入框 用户可以在文本框里输入内容。

UniApp X 版本
- 移除 defineOptions
- 移除手动组件导入（easycom 自动注册）
- 移除 useSlots / $slots（props 控制显隐）
- import type { Slots } → 移除
- import type { FormItemRule } → 从 wd-form-key.uts 导入
- useParent(FORM_KEY) → inject(FORM_KEY) + genChildUid 模式
- string | number → string（modelValue）
- InputType/InputSize 联合类型 → string
- InputConfirmType/InputMode/InputClearTrigger → string
- interface WdInputProps → defineProps 内联
- interface WdInputEmits → defineEmits 内联
- WdInputSlots interface → 移除
- ::after 伪元素 → 使用 view 替代
- :deep() → 直接类选择器
- edeep() → 直接类选择器
- halfPixelBorder() → border: 1rpx solid
- vertical-align → 移除
- ::-webkit-input-placeholder → placeholder-style prop
- display: inline-block → display: flex
- MouseEvent → any
-->
<template>
  <view :class="rootClass" :style="customStyle" @click="handleClick">
    <view
      v-if="label != ''"
      :class="`wd-input__label ${isRequired ? 'is-required' : ''}`"
      :style="labelWidthStyle"
    >
      <view v-if="prefixIcon != ''" class="wd-input__prefix">
        <wd-icon
          custom-class="wd-input__icon"
          :name="prefixIcon"
          @click="onClickPrefixIcon"
        />
      </view>
      <view class="wd-input__label-inner" :class="customLabelClass">
        <text>{{ label }}</text>
      </view>
    </view>
    <view class="wd-input__body">
      <view class="wd-input__input-wrapper" :class="customInputClass" :style="customInputStyle">
        <view class="wd-input__value">
          <view v-if="prefixIcon != '' && label == ''" class="wd-input__prefix">
            <wd-icon
              custom-class="wd-input__icon"
              :name="prefixIcon"
              @click="onClickPrefixIcon"
            />
          </view>
          <input
            v-model="inputValue"
            class="wd-input__inner"
            :class="`${prefixIcon != '' ? 'wd-input__inner--prefix' : ''} ${showWordCount ? 'wd-input__inner--count' : ''} ${alignRight ? 'is-align-right' : ''} ${customInnerClass}`"
            :type="type"
            :password="showPassword && !isPwdVisible"
            :placeholder="placeholderValue"
            :disabled="disabled || readonly"
            :maxlength="maxlength"
            :focus="focused"
            :confirm-type="confirmType"
            :confirm-hold="confirmHold"
            :cursor="cursor"
            :cursor-spacing="cursorSpacing"
            :placeholder-style="placeholderStyle"
            :selection-start="selectionStart"
            :selection-end="selectionEnd"
            :adjust-position="adjustPosition"
            :hold-keyboard="holdKeyboard"
            :always-embed="alwaysEmbed"
            :placeholder-class="`wd-input__placeholder ${placeholderClass}`"
            @input="handleInput"
            @focus="handleFocus"
            @blur="handleBlur"
            @confirm="handleConfirm"
            @keyboardheightchange="handleKeyboardheightchange"
          />
          <view v-if="readonly" class="wd-input__readonly-mask" />
          <view
            v-if="showClear || showPassword || suffixIcon != '' || showWordCount"
            class="wd-input__suffix"
          >
            <wd-icon
              v-if="showClear"
              custom-class="wd-input__clear"
              name="close-fill"
              @click="handleClear"
            />
            <wd-icon
              v-if="showPassword"
              custom-class="wd-input__icon"
              :name="isPwdVisible ? 'visible' : 'hidden'"
              @click="togglePwdVisible"
            />
            <view v-if="showWordCount" class="wd-input__count">
              <text
                :class="`${inputValue.length > 0 ? 'wd-input__count-current' : ''} ${inputValue.length > maxlength ? 'is-error' : ''}`"
              >
                {{ inputValue.length }}
              </text>
              <text>/{{ maxlength }}</text>
            </view>
            <wd-icon
              v-if="suffixIcon != ''"
              custom-class="wd-input__icon"
              :name="suffixIcon"
              @click="onClickSuffixIcon"
            />
          </view>
        </view>
      </view>
      <view
        v-if="errorMessage != ''"
        class="wd-input__error-message"
      >
        <text class="wd-input__error-text">{{ errorMessage }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
import { computed, ref, watch, inject } from 'vue'
import { addUnit, isDef, isEqual, pause } from '../common/util'
import { useCell } from '../../composables/useCell'
import { useTranslate } from '../../composables/useTranslate'
import { FORM_KEY, type FormProvide, type FormItemRule } from '../wd-form/wd-form-key'

/**
 * Input 组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 自定义输入框包装器样式类 */
  customInputClass ?: string
  /** 自定义输入框包装器样式 */
  customInputStyle ?: string
  /** 自定义输入框内部样式类 */
  customInnerClass ?: string
  /** 自定义标签样式类 */
  customLabelClass ?: string
  /** 占位文本 */
  placeholder ?: string
  /** 占位文本样式 */
  placeholderStyle ?: string
  /** 占位文本样式类 */
  placeholderClass ?: string
  /** 光标与键盘的距离 */
  cursorSpacing ?: number
  /** focus时的光标位置 */
  cursor ?: number
  /** 光标起始位置 */
  selectionStart ?: number
  /** 光标结束位置 */
  selectionEnd ?: number
  /** 键盘弹起时是否自动上推页面 */
  adjustPosition ?: boolean
  /** focus时点击页面不收起键盘 */
  holdKeyboard ?: boolean
  /** 键盘右下角按钮文字 */
  confirmType ?: string
  /** 点击确认按钮时是否保持键盘 */
  confirmHold ?: boolean
  /** 获取焦点 */
  focus ?: boolean
  /** 输入框类型 */
  type ?: string
  /** 最大长度 */
  maxlength ?: number
  /** 是否禁用 */
  disabled ?: boolean
  /** 强制处于同层状态 */
  alwaysEmbed ?: boolean
  /** 输入框的值靠右展示 */
  alignRight ?: boolean
  /** 绑定值 */
  modelValue ?: string
  /** 显示为密码框 */
  showPassword ?: boolean
  /** 显示清空按钮 */
  clearable ?: boolean
  /** 只读 */
  readonly ?: boolean
  /** 前置图标 */
  prefixIcon ?: string
  /** 后置图标 */
  suffixIcon ?: string
  /** 显示字数限制 */
  showWordLimit ?: boolean
  /** 设置左侧标题 */
  label ?: string
  /** 设置左侧标题宽度 */
  labelWidth ?: string
  /** 设置输入框大小 */
  size ?: string
  /** 设置输入框错误状态 */
  error ?: boolean
  /** 标题和输入框垂直居中 */
  center ?: boolean
  /** 非 cell 类型下是否隐藏下划线 */
  noBorder ?: boolean
  /** 是否必填 */
  required ?: boolean
  /** 表单域字段名 */
  prop ?: string
  /** 显示清除图标的时机 */
  clearTrigger ?: string
  /** 是否在点击清除按钮时聚焦 */
  focusWhenClear ?: boolean
}>(), {
  customStyle: '',
  customClass: '',
  customInputClass: '',
  customInputStyle: '',
  customInnerClass: '',
  customLabelClass: '',
  placeholder: '',
  placeholderStyle: '',
  placeholderClass: '',
  cursorSpacing: 0,
  cursor: -1,
  selectionStart: -1,
  selectionEnd: -1,
  adjustPosition: true,
  holdKeyboard: false,
  confirmType: 'done',
  confirmHold: false,
  focus: false,
  type: 'text',
  maxlength: -1,
  disabled: false,
  alwaysEmbed: false,
  alignRight: false,
  modelValue: '',
  showPassword: false,
  clearable: false,
  readonly: false,
  prefixIcon: '',
  suffixIcon: '',
  showWordLimit: false,
  label: '',
  labelWidth: '',
  size: '',
  error: false,
  center: false,
  noBorder: false,
  required: false,
  prop: '',
  clearTrigger: 'always',
  focusWhenClear: true,
})

const emit = defineEmits<{
  (e : 'update:modelValue', value : string) : void
  (e : 'clear') : void
  (e : 'blur', detail : UTSJSONObject) : void
  (e : 'focus', detail : any) : void
  (e : 'input', detail : any) : void
  (e : 'keyboardheightchange', detail : any) : void
  (e : 'confirm', detail : any) : void
  (e : 'clicksuffixicon') : void
  (e : 'clickprefixicon') : void
  (e : 'click', event : any) : void
}>();

/* 国际化翻译 */
const { translate } = useTranslate('input')

/* 获取父组件 Form 的 provide 数据 */
const form = inject<FormProvide | null>(FORM_KEY, null)

/* 使用 cell 组合函数 */
const cell = useCell()

/* 响应式数据 */
const isPwdVisible = ref(false)
const clearing = ref(false)
const focused = ref(false)
const focusing = ref(false)
const inputValue = ref('')

/**
 * 监听 focus 属性变化
 */
watch(() => props.focus, (newValue : boolean) => {
  focused.value = newValue
}, { immediate: true })

/**
 * 监听 modelValue 属性变化
 */
watch(() => props.modelValue, (newValue : string) => {
  inputValue.value = isDef(newValue) ? newValue : ''
}, { immediate: true })

/**
 * 监听输入值变化，处理字段级别的错误清除
 */
watch(() => inputValue.value, (newValue : string, oldValue : string) => {
  if (newValue != oldValue && form != null && form!.resetOnChange && props.prop != '') {
    form!.clearFieldMessage(props.prop)
  }
})

/**
 * 标签宽度样式
 */
const labelWidthStyle = computed(() : string => {
  if (props.labelWidth != '') {
    return `min-width: ${addUnit(props.labelWidth)}; max-width: ${addUnit(props.labelWidth)};`
  }
  return ''
})

/**
 * 计算占位符文本
 */
const placeholderValue = computed(() : string => {
  if (props.placeholder != '') {
    return props.placeholder
  }
  const base = translate('placeholder')
  if (props.label != '') {
    return `${base} ${props.label}`
  }
  return base
})

/**
 * 计算是否显示清空按钮
 */
const showClear = computed(() : boolean => {
  if (
    props.clearable &&
    !props.readonly &&
    !props.disabled &&
    inputValue.value != '' &&
    (props.clearTrigger == 'always' || (props.clearTrigger == 'focus' && focusing.value))
  ) {
    return true
  }
  return false
})

/**
 * 计算是否显示字数统计
 */
const showWordCount = computed(() : boolean => {
  return !props.disabled && !props.readonly && props.maxlength > -1 && props.showWordLimit
})

/**
 * 计算表单错误信息
 */
const errorMessage = computed(() : string => {
  if (form != null && props.prop != '' && form!.errorMessages.has(props.prop)) {
    return form!.errorMessages.get(props.prop)!
  }
  return ''
})

/**
 * 计算是否必填
 */
const isRequired = computed(() : boolean => {
  if (props.required) return true

  /* 检查 Form 中的规则 */
  if (form != null && props.prop != '' && form!.rules.has(props.prop)) {
    const rules = form!.rules.get(props.prop)!
    for (let i = 0; i < rules.length; i++) {
      if (rules[i].required == true) return true
    }
  }
  return false
})

/**
 * 计算根元素类名
 */
const rootClass = computed(() : string => {
  let classes = 'wd-input'
  if (props.label != '') classes += ' is-cell'
  if (props.center) classes += ' is-center'
  if (cell.border.value) classes += ' is-border'
  if (props.size != '') classes += ` is-${props.size}`
  if (props.error) classes += ' is-error'
  if (props.disabled) classes += ' is-disabled'
  if (inputValue.value.length > 0) classes += ' is-not-empty'
  if (props.noBorder) classes += ' is-no-border'
  if (props.customClass != '') classes += ` ${props.customClass}`
  return classes
})

/**
 * 切换密码可见性
 */
const togglePwdVisible = () => {
  isPwdVisible.value = !isPwdVisible.value
}

/**
 * 处理清空操作
 */
const handleClear = () => {
  focusing.value = false
  inputValue.value = ''
  if (props.focusWhenClear) {
    clearing.value = true
    focused.value = false
  }
  /* 使用 setTimeout 替代 await pause() */
  setTimeout(() => {
    if (props.focusWhenClear) {
      focused.value = true
      focusing.value = true
    }
    emit('update:modelValue', inputValue.value)
    emit('clear')
  }, 33)
}

/**
 * 处理失去焦点事件
 */
const handleBlur = () => {
  /* 等待150毫秒，clear执行完毕 */
  setTimeout(() => {
    if (clearing.value) {
      clearing.value = false
      return
    }
    focusing.value = false
    const detail : UTSJSONObject = { 'value': inputValue.value }
    emit('blur', detail)
  }, 150)
}

/**
 * 处理获得焦点事件
 */
const handleFocus = (event : any) => {
  focusing.value = true
  const detail = (event as UTSJSONObject)['detail']
  emit('focus', detail)
}

/**
 * 处理输入事件
 */
const handleInput = (event : any) => {
  emit('update:modelValue', inputValue.value)
  const detail = (event as UTSJSONObject)['detail']
  emit('input', detail)
}

/**
 * 处理键盘高度变化事件
 */
const handleKeyboardheightchange = (event : any) => {
  const detail = (event as UTSJSONObject)['detail']
  emit('keyboardheightchange', detail)
}

/**
 * 处理确认输入事件
 */
const handleConfirm = (event : any) => {
  const detail = (event as UTSJSONObject)['detail']
  emit('confirm', detail)
}

/**
 * 处理点击后置图标事件
 */
const onClickSuffixIcon = () => {
  emit('clicksuffixicon')
}

/**
 * 处理点击前置图标事件
 */
const onClickPrefixIcon = () => {
  emit('clickprefixicon')
}

/**
 * 处理点击事件
 */
const handleClick = (event : any) => {
  emit('click', event)
}
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(input) {
    background: $-dark-background2;

    @include when(not-empty) {
      &:not(.is-disabled) {
        .wd-input__border-line {
          background-color: $-dark-color;
        }
      }
    }

    @include e(inner) {
      color: $-dark-color;
    }

    @include e(count) {
      color: $-dark-color3;
      background: transparent;
    }

    .wd-input__count-current {
      color: $-dark-color;
    }

    .wd-input__icon,
    .wd-input__clear {
      color: $-dark-color;
      background: transparent;
    }

    @include when(cell) {
      background-color: $-dark-background2;
    }

    @include when(disabled) {
      .wd-input__inner {
        color: $-dark-color-gray;
        background: transparent;
      }
    }

    @include e(label) {
      color: $-dark-color;
    }

    @include e(placeholder) {
      color: $-dark-color3;
    }
  }
}

/* 输入框组件样式 */
@include b(input) {
  position: relative;
  text-align: left;
  background: $-input-bg;

  /* 底部边框线（替代 ::after） */
  .wd-input__border-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1rpx;
    background: $-input-border-color;
  }

  @include when(not-empty) {
    &:not(.is-disabled) {
      .wd-input__border-line {
        background-color: $-input-not-empty-border-color;
      }
    }
  }

  @include e(label) {
    position: relative;
    display: flex;
    /* UniApp X 的 view 默认 flex-direction: column，需显式覆盖为行布局 */
    flex-direction: row;
    width: $-input-cell-label-width;
    color: $-cell-title-color;
    margin-right: $-cell-padding;
    box-sizing: border-box;
    font-size: $-input-fs;
    flex-shrink: 0;

    @include when(required) {
      padding-left: 24rpx;
    }
  }

  /* 必填星号（替代 ::after） */
  .wd-input__required-mark {
    position: absolute;
    left: 0;
    top: 4px;
    font-size: $-cell-required-size;
    line-height: 1.1;
    color: $-cell-required-color;
  }

  @include e(label-inner) {
    display: flex;
    font-size: $-input-fs;
    line-height: $-cell-line-height;
  }

  @include e(input-wrapper) {
    position: relative;
  }

  @include e(body) {
    flex: 1;
    position: relative;
  }

  @include e(value) {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  @include e(prefix) {
    margin-right: $-input-icon-margin;
    font-size: $-input-fs;

    .wd-input__icon,
    .wd-input__clear {
      margin-left: 0;
    }
  }

  @include e(suffix) {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
  }

  @include e(error-message) {
    display: flex;
  }

  .wd-input__error-text {
    color: $-form-item-error-message-color;
    font-size: $-form-item-error-message-font-size;
    line-height: $-form-item-error-message-line-height;
    text-align: left;
  }

  @include e(placeholder) {
    color: $-input-placeholder-color;

    &.is-error {
      color: $-input-error-color;
    }
  }

  @include when(disabled) {
    .wd-input__inner {
      color: $-input-disabled-color;
      background: transparent;
    }
  }

  @include when(error) {
    .wd-input__inner {
      color: $-input-error-color;
      background: transparent;
    }
  }

  @include when(no-border) {
    .wd-input__border-line {
      display: none;
    }

    .wd-input__inner {
      height: $-input-inner-height-no-border;
      padding-top: 0;
      padding-bottom: 0;
    }
  }

  @include when(cell) {
    display: flex;
    /* UniApp X 的 view 默认 flex-direction: column，需显式覆盖为行布局 */
    flex-direction: row;
    align-items: flex-start;
    padding: $-input-cell-padding $-input-padding;
    background-color: $-input-cell-bg;

    &.is-error {
      .wd-input__border-line {
        background: $-input-cell-border-color;
      }
    }

    .wd-input__icon,
    .wd-input__clear {
      display: flex;
      align-items: center;
      height: $-input-cell-height;
      line-height: $-input-cell-height;
    }

    .wd-input__prefix {
      display: flex;
      margin-right: $-cell-icon-right;
    }

    .wd-input__inner {
      height: $-input-cell-height;
    }

    .wd-input__border-line {
      display: none;
    }

    @include when(center) {
      align-items: center;
    }

    @include when(border) {
      border-top: 1rpx solid $-input-cell-border-color;
    }
  }

  @include when(large) {
    padding: $-input-cell-padding-large;

    .wd-input__prefix {
      font-size: $-input-fs-large;
    }

    .wd-input__label-inner {
      font-size: $-input-fs-large;
    }

    .wd-input__inner {
      font-size: $-input-fs-large;
    }

    .wd-input__count {
      font-size: $-input-count-fs-large;
    }

    .wd-input__icon,
    .wd-input__clear {
      font-size: $-input-icon-size-large;
    }
  }

  @include e(inner) {
    flex: 1;
    height: $-input-inner-height;
    font-size: $-input-fs;
    color: $-input-color;
    border: none;
    background: none;
    padding: 0;
    box-sizing: border-box;

    @include when(align-right) {
      text-align: right;
    }
  }

  @include e(readonly-mask) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .wd-input__icon {
    margin-left: $-input-icon-margin;
    font-size: $-input-icon-size;
    color: $-input-icon-color;
    background: $-input-bg;
  }

  .wd-input__clear {
    margin-left: $-input-icon-margin;
    font-size: $-input-icon-size;
    color: $-input-clear-color;
    background: $-input-bg;
  }

  @include e(count) {
    margin-left: 30rpx;
    font-size: $-input-count-fs;
    color: $-input-count-color;
    background: $-input-bg;
    display: flex;
    flex-direction: row;
  }

  .wd-input__count-current {
    color: $-input-count-current-color;

    &.is-error {
      color: $-input-error-color;
    }
  }

  .wd-input__count,
  .wd-input__count-current {
    display: flex;
  }
}
</style>
