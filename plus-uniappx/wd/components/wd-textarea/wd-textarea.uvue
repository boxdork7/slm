<!--
Textarea 文本域 用于输入多行文本信息。

UniApp X 版本
- 移除 defineOptions
- 移除手动组件导入（easycom 自动注册）
- 移除 useSlots / $slots（props 控制显隐）
- import type { Slots } → 移除
- import type { FormItemRule } → 从 wd-form-key.uts 导入
- useParent(FORM_KEY) → inject(FORM_KEY) 模式
- string | number → string（modelValue）
- ConfirmType/InputMode/InputClearTrigger 联合类型 → string
- interface WdTextareaProps → defineProps 内联
- interface WdTextareaEmits → defineEmits 内联
- TextareaSlots interface → 移除
- ::after 伪元素 → 移除（文本域无底部边框）
- :deep() → 直接类选择器
- edeep() → 直接类选择器
- vertical-align → 移除
- ::-webkit-input-placeholder → placeholder-style prop
- display: inline-block → display: flex
- #ifdef MP-WEIXIN → 移除（UniApp X 不运行微信小程序）
- MouseEvent → any
- Array.from() → 直接 .length（UTS 字符串处理）
-->
<template>
  <view
    :class="`wd-textarea ${label != '' ? 'is-cell' : ''} ${center ? 'is-center' : ''} ${size != '' ? 'is-' + size : ''} ${error ? 'is-error' : ''} ${disabled ? 'is-disabled' : ''} ${autoHeight ? 'is-auto-height' : ''} ${currentLength > 0 ? 'is-not-empty' : ''} ${customClass}`"
    :style="customStyle"
  >
    <view
      v-if="label != ''"
      :class="`wd-textarea__label ${customLabelClass} ${isRequired ? 'is-required' : ''}`"
      :style="labelWidthStyle"
    >
      <view v-if="prefixIcon != ''" class="wd-textarea__prefix">
        <wd-icon
          custom-class="wd-textarea__icon"
          :name="prefixIcon"
          @click="onClickPrefixIcon"
        />
      </view>
      <view class="wd-textarea__label-inner">
        <text>{{ label }}</text>
      </view>
    </view>

    <!-- 文本域 -->
    <view
      :class="`wd-textarea__value ${showClear ? 'is-suffix' : ''} ${customTextareaContainerClass} ${showWordCount ? 'is-show-limit' : ''}`"
    >
      <textarea
        v-model="inputValue"
        :class="`wd-textarea__inner ${customTextareaClass}`"
        :show-count="false"
        :placeholder="placeholderValue"
        :disabled="disabled || readonly"
        :maxlength="maxlength"
        :focus="focused"
        :auto-focus="autoFocus"
        :placeholder-style="placeholderStyle"
        :placeholder-class="inputPlaceholderClass"
        :auto-height="autoHeight"
        :cursor-spacing="cursorSpacing"
        :fixed="fixed"
        :cursor="cursor"
        :show-confirm-bar="showConfirmBar"
        :selection-start="selectionStart"
        :selection-end="selectionEnd"
        :adjust-position="adjustPosition"
        :hold-keyboard="holdKeyboard"
        :confirm-type="confirmType"
        :confirm-hold="confirmHold"
        :disable-default-padding="disableDefaultPadding"
        @input="handleInput"
        @focus="handleFocus"
        @blur="handleBlur"
        @confirm="handleConfirm"
        @linechange="handleLineChange"
        @keyboardheightchange="handleKeyboardheightchange"
      />
      <view v-if="errorMessage != ''" class="wd-textarea__error-message">
        <text class="wd-textarea__error-text">{{ errorMessage }}</text>
      </view>

      <view v-if="readonly" class="wd-textarea__readonly-mask" />
      <view class="wd-textarea__suffix">
        <wd-icon
          v-if="showClear"
          custom-class="wd-textarea__clear"
          name="close-outline-fill"
          @click="handleClear"
        />
        <view v-if="showWordCount" class="wd-textarea__count">
          <text
            :class="`${currentLength > 0 ? 'wd-textarea__count-current' : ''} ${currentLength > maxlength ? 'is-error' : ''}`"
          >
            {{ currentLength }}
          </text>
          <text>/{{ maxlength }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
import { computed, ref, watch, inject, onBeforeMount } from 'vue'
import { isDef, objToStyle } from '../common/util'
import { useCell } from '../../composables/useCell'
import { useTranslate } from '../../composables/useTranslate'
import { FORM_KEY, type FormProvide } from '../wd-form/wd-form-key'

/**
 * Textarea 组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 自定义文本域容器样式类 */
  customTextareaContainerClass ?: string
  /** 自定义文本域样式类 */
  customTextareaClass ?: string
  /** 自定义标签样式类 */
  customLabelClass ?: string
  /** 绑定值 */
  modelValue ?: string
  /** 占位文本 */
  placeholder ?: string
  /** 占位文本样式 */
  placeholderStyle ?: string
  /** 占位文本样式类 */
  placeholderClass ?: string
  /** 是否禁用 */
  disabled ?: boolean
  /** 最大输入长度 */
  maxlength ?: number
  /** 自动聚焦 */
  autoFocus ?: boolean
  /** 获取焦点 */
  focus ?: boolean
  /** 是否自动增高 */
  autoHeight ?: boolean
  /** 是否在 fixed 区域 */
  fixed ?: boolean
  /** 光标与键盘的距离 */
  cursorSpacing ?: number
  /** focus时的光标位置 */
  cursor ?: number
  /** 键盘右下角按钮文字 */
  confirmType ?: string
  /** 点击确认按钮时是否保持键盘 */
  confirmHold ?: boolean
  /** 是否显示键盘上方完成栏 */
  showConfirmBar ?: boolean
  /** 光标起始位置 */
  selectionStart ?: number
  /** 光标结束位置 */
  selectionEnd ?: number
  /** 键盘弹起时是否自动上推页面 */
  adjustPosition ?: boolean
  /** 是否去掉iOS下默认内边距 */
  disableDefaultPadding ?: boolean
  /** focus时点击页面不收起键盘 */
  holdKeyboard ?: boolean
  /** 是否显示清空按钮 */
  clearable ?: boolean
  /** 只读 */
  readonly ?: boolean
  /** 前置图标 */
  prefixIcon ?: string
  /** 是否显示字数限制 */
  showWordLimit ?: boolean
  /** 设置左侧标题 */
  label ?: string
  /** 设置左侧标题宽度 */
  labelWidth ?: string
  /** 设置输入框大小 */
  size ?: string
  /** 设置输入框错误状态 */
  error ?: boolean
  /** 标题和输入框垂直居中 */
  center ?: boolean
  /** 是否必填 */
  required ?: boolean
  /** 表单域字段名 */
  prop ?: string
  /** 显示清除图标的时机 */
  clearTrigger ?: string
  /** 是否在点击清除按钮时聚焦 */
  focusWhenClear ?: boolean
}>(), {
  customStyle: '',
  customClass: '',
  customTextareaContainerClass: '',
  customTextareaClass: '',
  customLabelClass: '',
  modelValue: '',
  placeholder: '',
  placeholderStyle: '',
  placeholderClass: '',
  disabled: false,
  maxlength: -1,
  autoFocus: false,
  focus: false,
  autoHeight: false,
  fixed: false,
  cursorSpacing: 0,
  cursor: -1,
  confirmType: 'done',
  confirmHold: false,
  showConfirmBar: true,
  selectionStart: -1,
  selectionEnd: -1,
  adjustPosition: true,
  disableDefaultPadding: false,
  holdKeyboard: false,
  clearable: false,
  readonly: false,
  prefixIcon: '',
  showWordLimit: false,
  label: '',
  labelWidth: '',
  size: '',
  error: false,
  center: false,
  required: false,
  prop: '',
  clearTrigger: 'always',
  focusWhenClear: true,
})

const emit = defineEmits<{
  (e : 'update:modelValue', value : string) : void
  (e : 'clear') : void
  (e : 'blur', detail : UTSJSONObject) : void
  (e : 'focus', detail : any) : void
  (e : 'input', detail : any) : void
  (e : 'keyboardheightchange', detail : any) : void
  (e : 'confirm', detail : any) : void
  (e : 'linechange', detail : any) : void
  (e : 'clickprefixicon') : void
}>();

/* 国际化翻译 */
const { translate } = useTranslate('textarea')

/* 获取父组件 Form 的 provide 数据 */
const form = inject<FormProvide | null>(FORM_KEY, null)

/* 使用 cell 组合函数 */
const cell = useCell()

/* 响应式数据 */
const clearing = ref(false)
const focused = ref(false)
const focusing = ref(false)
const inputValue = ref('')

/**
 * 格式化输入值
 */
const formatValue = (value : string) : string => {
  if (props.showWordLimit && props.maxlength != -1 && value.length > props.maxlength) {
    return value.substring(0, props.maxlength)
  }
  return value
}

/**
 * 监听 focus 属性变化
 */
watch(() => props.focus, (newValue : boolean) => {
  focused.value = newValue
}, { immediate: true })

/**
 * 监听 modelValue 属性变化
 */
watch(() => props.modelValue, (newValue : string) => {
  inputValue.value = isDef(newValue) ? newValue : ''
}, { immediate: true })

/**
 * 计算占位符文本
 */
const placeholderValue = computed(() : string => {
  if (props.placeholder != '') {
    return props.placeholder
  }
  return translate('placeholder')
})

/**
 * 计算是否显示清空按钮
 */
const showClear = computed(() : boolean => {
  return (
    props.clearable &&
    !props.readonly &&
    !props.disabled &&
    inputValue.value != '' &&
    (props.clearTrigger == 'always' || (props.clearTrigger == 'focus' && focusing.value))
  )
})

/**
 * 计算是否显示字数统计
 */
const showWordCount = computed(() : boolean => {
  return !props.disabled && !props.readonly && props.maxlength > -1 && props.showWordLimit
})

/**
 * 计算表单校验错误信息
 */
const errorMessage = computed(() : string => {
  if (form != null && props.prop != '' && form!.errorMessages.has(props.prop)) {
    return form!.errorMessages.get(props.prop)!
  }
  return ''
})

/**
 * 计算是否必填
 */
const isRequired = computed(() : boolean => {
  if (props.required) return true
  if (form != null && props.prop != '' && form!.rules.has(props.prop)) {
    const rules = form!.rules.get(props.prop)!
    for (let i = 0; i < rules.length; i++) {
      if (rules[i].required == true) return true
    }
  }
  return false
})

/**
 * 计算当前文本域文字长度
 */
const currentLength = computed(() : number => {
  return formatValue(props.modelValue).length
})

/**
 * 计算占位符类名
 */
const inputPlaceholderClass = computed(() : string => {
  return `wd-textarea__placeholder ${props.placeholderClass}`
})

/**
 * 标签宽度样式
 */
const labelWidthStyle = computed(() : string => {
  if (props.labelWidth != '') {
    return `min-width: ${props.labelWidth}; max-width: ${props.labelWidth};`
  }
  return ''
})

/**
 * 状态初始化
 */
const initState = () => {
  inputValue.value = formatValue(inputValue.value)
  emit('update:modelValue', inputValue.value)
}

/**
 * 处理清空按钮点击事件
 */
const handleClear = () => {
  focusing.value = false
  inputValue.value = ''
  if (props.focusWhenClear) {
    clearing.value = true
    focused.value = false
  }
  setTimeout(() => {
    if (props.focusWhenClear) {
      focused.value = true
      focusing.value = true
    }
    emit('update:modelValue', inputValue.value)
    emit('clear')
  }, 33)
}

/**
 * 处理失去焦点事件
 */
const handleBlur = (event : any) => {
  setTimeout(() => {
    if (clearing.value) {
      clearing.value = false
      return
    }
    focusing.value = false
    const detail : UTSJSONObject = { 'value': inputValue.value, 'cursor': null }
    emit('blur', detail)
  }, 150)
}

/**
 * 处理获得焦点事件
 */
const handleFocus = (event : any) => {
  focusing.value = true
  const detail = (event as UTSJSONObject)['detail']
  emit('focus', detail)
}

/**
 * 处理输入事件
 */
const handleInput = (event : any) => {
  inputValue.value = formatValue(inputValue.value)
  emit('update:modelValue', inputValue.value)
  const detail = (event as UTSJSONObject)['detail']
  emit('input', detail)
}

/**
 * 处理键盘高度变化事件
 */
const handleKeyboardheightchange = (event : any) => {
  const detail = (event as UTSJSONObject)['detail']
  emit('keyboardheightchange', detail)
}

/**
 * 处理确认按钮点击事件
 */
const handleConfirm = (event : any) => {
  const detail = (event as UTSJSONObject)['detail']
  emit('confirm', detail)
}

/**
 * 处理行数变化事件
 */
const handleLineChange = (event : any) => {
  const detail = (event as UTSJSONObject)['detail']
  emit('linechange', detail)
}

/**
 * 处理前置图标点击事件
 */
const onClickPrefixIcon = () => {
  emit('clickprefixicon')
}

/**
 * 组件挂载前的处理
 */
onBeforeMount(() => {
  initState()
})
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(textarea) {
    background: $-dark-background2;

    @include e(value) {
      background: $-dark-background2;
    }

    @include e(inner) {
      color: $-dark-color;
    }

    @include e(count) {
      color: $-dark-color3;
      background: transparent;
    }

    .wd-textarea__count-current {
      color: $-dark-color;
    }

    .wd-textarea__icon,
    .wd-textarea__clear {
      color: $-dark-color;
      background: transparent;
    }

    @include when(cell) {
      background-color: $-dark-background2;
    }

    @include when(disabled) {
      .wd-textarea__inner {
        color: $-dark-color-gray;
        background: transparent;
      }
    }

    @include e(label) {
      color: $-dark-color;
    }

    @include e(placeholder) {
      color: $-dark-color3;
    }
  }
}

/* 文本域组件样式 */
@include b(textarea) {
  position: relative;
  text-align: left;
  background: $-textarea-bg;
  padding: $-textarea-cell-padding $-textarea-padding;

  @include e(label) {
    position: relative;
    display: flex;
    width: $-input-cell-label-width;
    color: $-cell-title-color;
    margin-right: $-cell-padding;
    box-sizing: border-box;
    font-size: $-textarea-fs;

    @include when(required) {
      padding-left: 24rpx;
    }
  }

  @include e(label-inner) {
    display: flex;
    line-height: $-cell-line-height;
    font-size: $-textarea-fs;
  }

  @include e(prefix) {
    margin-right: $-textarea-icon-margin;
    font-size: $-textarea-fs;

    .wd-textarea__icon {
      margin-left: 0;
    }
  }

  @include e(suffix) {
    flex-shrink: 0;
  }

  @include e(value) {
    position: relative;
    padding: 0;
    font-size: 0;
    background: $-textarea-bg;
    box-sizing: border-box;

    @include when(show-limit) {
      padding-bottom: 56rpx;
    }

    @include when(suffix) {
      padding-right: calc($-textarea-icon-size + 16rpx);
    }
  }

  @include e(inner) {
    padding: 0;
    width: 100%;
    font-size: $-textarea-fs;
    line-height: $-cell-line-height;
    color: $-textarea-color;
    background: none;
    border: none;
    box-sizing: border-box;
    min-height: 48rpx;
  }

  @include e(suffix) {
    position: absolute;
    z-index: 1;
    right: 0;
    top: 0;
    bottom: 0;
  }

  .wd-textarea__icon {
    margin-left: $-textarea-icon-margin;
    font-size: $-textarea-icon-size;
    color: $-textarea-icon-color;
    background: $-textarea-bg;
  }

  .wd-textarea__clear {
    margin-left: $-textarea-icon-margin;
    font-size: $-textarea-icon-size;
    color: $-textarea-clear-color;
    background: $-textarea-bg;
    line-height: $-cell-line-height;
  }

  @include e(count) {
    position: absolute;
    bottom: 0;
    right: 0;
    font-size: $-textarea-count-fs;
    color: $-textarea-count-color;
    background: $-textarea-bg;
    line-height: 40rpx;
    display: flex;
    flex-direction: row;
  }

  .wd-textarea__count-current {
    color: $-textarea-count-current-color;

    &.is-error {
      color: $-input-error-color;
    }
  }

  @include e(readonly-mask) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  @include e(error-message) {
    display: flex;
  }

  .wd-textarea__error-text {
    color: $-form-item-error-message-color;
    font-size: $-form-item-error-message-font-size;
    line-height: $-form-item-error-message-line-height;
    text-align: left;
  }

  @include e(placeholder) {
    color: $-input-placeholder-color;

    &.is-error {
      color: $-input-error-color;
    }
  }

  @include when(disabled) {
    .wd-textarea__inner {
      color: $-input-disabled-color;
      background: transparent;
    }
  }

  @include when(error) {
    .wd-textarea__inner {
      color: $-input-error-color;
      background: transparent;
    }
  }

  @include when(auto-height) {
    &:not(.is-cell) {
      padding: 10rpx 0;
    }
  }

  @include when(cell) {
    display: flex;
    line-height: $-cell-line-height;

    .wd-textarea__value {
      flex: 1;
    }

    .wd-textarea__icon {
      display: flex;
      align-items: center;
      height: $-textarea-cell-height;
      line-height: $-textarea-cell-height;
    }

    .wd-textarea__prefix {
      display: flex;
      margin-right: $-cell-icon-right;
    }

    .wd-textarea__suffix {
      right: 0;
    }

    @include when(center) {
      align-items: center;
    }
  }

  @include when(large) {
    padding: $-textarea-cell-padding-large;

    .wd-textarea__prefix {
      font-size: $-textarea-fs-large;
    }

    .wd-textarea__label-inner {
      font-size: $-textarea-fs-large;
    }

    .wd-textarea__inner {
      font-size: $-textarea-fs-large;
    }

    .wd-textarea__count {
      font-size: $-textarea-count-fs-large;
    }

    .wd-textarea__icon,
    .wd-textarea__clear {
      font-size: $-textarea-icon-size-large;
    }
  }
}
</style>
