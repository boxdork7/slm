/**
 * 移动端国际化配置 (UniApp X 版本)
 *
 * 保持与 plus-app/locales/i18n.ts 完全相同的导出接口
 *
 * UTS 适配说明：
 * - LanguageCode enum 从 systemConfig.uts 导入
 * - 语言包使用 UTSJSONObject 类型（而非 TypeScript 默认导出对象）
 * - computed 映射对象改为具体字段
 * - Locale.use() 注释掉（WD UI 阶段 2 迁移后启用）
 * - Object.values(LanguageCode).includes() → 手动字符串判断
 * - cache.get<LanguageCode>() → cache.getString()
 * - switch → if/else
 */
import { LanguageCode } from '@/systemConfig'
import { cache } from '@/utils/cache'
import { ref, computed } from 'vue'
import { zhCN } from './zh-CN'
import { enUS } from './en-US'

/* 语言缓存键 */
const LANGUAGE_CACHE_KEY = 'app_language'

/* 语言包映射 */
const messagesMap = new Map<string, UTSJSONObject>()
messagesMap.set(LanguageCode.zh_CN, zhCN)
messagesMap.set(LanguageCode.en_US, enUS)

/* 当前语言状态（响应式） */
const currentLanguage = ref<string>(LanguageCode.zh_CN)

/**
 * 验证是否为支持的语言代码
 */
const isSupportedLanguage = (lang : string) : boolean => {
	return lang == LanguageCode.zh_CN || lang == LanguageCode.en_US
}

/**
 * 从缓存获取语言设置
 */
const getLanguageFromCache = () : string => {
	try {
		const cachedLanguage = cache.getString(LANGUAGE_CACHE_KEY)
		if (cachedLanguage != null && isSupportedLanguage(cachedLanguage!)) {
			return cachedLanguage!
		}
	} catch (_error) {
		console.warn('[i18n] 读取缓存语言失败')
	}

	/* 尝试获取系统语言 */
	try {
		const systemInfo = uni.getSystemInfoSync()
		const systemLanguage = systemInfo.language

		if (systemLanguage.includes('zh') || systemLanguage.includes('cn')) {
			return LanguageCode.zh_CN
		} else if (systemLanguage.includes('en')) {
			return LanguageCode.en_US
		}
	} catch (_error) {
		console.warn('[i18n] 获取系统语言失败')
	}

	/* 默认返回中文 */
	return LanguageCode.zh_CN
}

/**
 * 设置语言到缓存
 */
export const setLanguageToCache = (language : string) : boolean => {
	try {
		cache.set(LANGUAGE_CACHE_KEY, language, 0)
		return true
	} catch (_error) {
		console.error('[i18n] 设置语言到缓存失败')
		return false
	}
}

/**
 * 获取当前语言
 */
export const getLanguage = () : string => {
	return currentLanguage.value
}

/**
 * 获取当前语言的翻译消息
 */
export const getCurrentMessages = () : UTSJSONObject => {
	return messagesMap.get(currentLanguage.value) ?? zhCN
}

/**
 * 翻译函数 - 根据 key 获取翻译文本
 *
 * 支持点号分隔的嵌套 key，如 'login.userName'、'message.success'
 *
 * @param key 翻译键，支持嵌套路径
 * @returns 翻译后的字符串，未找到时返回 key 本身
 */
export const t = (key : string) : string => {
	if (key.length == 0) return ''

	const messages = getCurrentMessages()
	const parts = key.split('.')

	if (parts.length == 1) {
		/* 简单 key */
		return messages.getString(key) ?? key
	}

	/* 嵌套 key：逐层查找 */
	let current : UTSJSONObject | null = messages
	for (let i = 0; i < parts.length - 1; i++) {
		if (current == null) return key
		current = current!.getJSON(parts[i])
	}

	if (current == null) return key
	return current!.getString(parts[parts.length - 1]) ?? key
}

/**
 * 设置语言
 */
export const setLanguage = (language : string) : boolean => {
	if (!isSupportedLanguage(language)) {
		console.warn(`Language ${language} is not supported`)
		return false
	}

	try {
		/* 更新当前语言状态 */
		currentLanguage.value = language

		/* TODO: 阶段 2 WD UI 迁移后启用 */
		/* Locale.use(language) */

		/* 保存到缓存 */
		const success = setLanguageToCache(language)

		if (success) {
			console.log(`[i18n] 语言切换成功: ${language}`)
			return true
		} else {
			console.error('[i18n] 保存语言设置到缓存失败')
			return false
		}
	} catch (_error) {
		console.error('[i18n] 设置语言失败')
		return false
	}
}

/**
 * 初始化语言设置
 */
export const initLanguage = () : void => {
	const cachedLanguage = getLanguageFromCache()
	setLanguage(cachedLanguage)
}

/**
 * 语言选项类型
 */
export type LanguageOption = {
	value : string
	label : string
	name : string
}

/**
 * 语言状态（响应式）
 */
export const languageState = {
	/* 当前语言 */
	current: computed(() : string => currentLanguage.value),

	/* 当前语言名称 */
	currentName: computed(() : string => {
		if (currentLanguage.value == LanguageCode.zh_CN) {
			return '简体中文'
		} else if (currentLanguage.value == LanguageCode.en_US) {
			return 'English'
		}
		return currentLanguage.value
	}),

	/* 是否为中文 */
	isChinese: computed(() : boolean => currentLanguage.value == LanguageCode.zh_CN),

	/* 是否为英文 */
	isEnglish: computed(() : boolean => currentLanguage.value == LanguageCode.en_US),
}

/**
 * 获取语言选项列表
 */
export const getLanguageOptions = () : LanguageOption[] => {
	return [
		{ value: LanguageCode.zh_CN, label: '简体中文', name: '简体中文' } as LanguageOption,
		{ value: LanguageCode.en_US, label: 'English', name: 'English' } as LanguageOption,
	]
}

/* 自动初始化 */
initLanguage()
