/**
 * 日期工具类 (UniApp X 版本)
 *
 * 保持与 plus-app/utils/date.ts 完全相同的导出接口
 *
 * 包含以下功能：
 * - 日期格式化 (formatDate, formatTableDate, formatDay, formatRelativeTime, formatDateRange)
 * - 日期解析 (parseDate)
 * - 当前时间获取 (getCurrentTime, getCurrentDate, getCurrentDateTime)
 * - 日期范围获取 (getTimeStamp, getDateRange, getCurrentWeekRange, getCurrentMonthRange)
 * - 日期范围预设 (getDateRangeByType)
 * - 日期计算 (getDaysBetween, isSameDay, getWeekOfYear, dateAdd)
 *
 * UTS 适配说明：
 * - Record<string, any> → 具体的映射处理
 * - 保持所有函数签名不变
 */

/**
 * 数字前补零
 */
const padZero = (num : number, targetLength : number = 2) : string => {
	return num.toString().padStart(targetLength, '0')
}

/**
 * 日期格式化
 * 自动兼容两种格式语法 (yyyy-MM-dd 和 YYYY-MM-DD)
 */
export const formatDate = (time : Date | string | number, pattern : string = 'yyyy-MM-dd HH:mm:ss') : string => {
	if (time == null) {
		return ''
	}

	let date : Date
	if (time instanceof Date) {
		date = time as Date
	} else {
		let timeValue = time
		if (typeof timeValue == 'string') {
			const timeStr = timeValue as string
			if (timeStr.length == 0) return ''

			/* 检查是否全是数字 */
			let allDigits = true
			for (let i = 0; i < timeStr.length; i++) {
				const c = timeStr.charAt(i)
				if (c < '0' || c > '9') {
					allDigits = false
					break
				}
			}

			if (allDigits) {
				timeValue = parseInt(timeStr) as number
			} else {
				/* 处理 ISO 日期字符串 */
				const processed = timeStr.replace(/-/g, '/').replace('T', ' ').replace(/\.\d+/, '')
				date = new Date(processed)
				if (isNaN(date.getTime())) return ''

				return formatDateInternal(date, pattern)
			}
		}

		if (typeof timeValue == 'number') {
			let numTime = timeValue as number
			if (numTime.toString().length == 10) {
				numTime = numTime * 1000
			}
			date = new Date(numTime)
		} else {
			return ''
		}
	}

	return formatDateInternal(date, pattern)
}

/**
 * 内部格式化方法
 */
const formatDateInternal = (date : Date, pattern : string) : string => {
	const year = date.getFullYear()
	const month = date.getMonth() + 1
	const day = date.getDate()
	const hours = date.getHours()
	const minutes = date.getMinutes()
	const seconds = date.getSeconds()
	const milliseconds = date.getMilliseconds()
	const week = date.getDay()

	let result = pattern
	result = result.replace('yyyy', year.toString())
	result = result.replace('YYYY', year.toString())
	result = result.replace('MM', padZero(month))
	result = result.replace('dd', padZero(day))
	result = result.replace('DD', padZero(day))
	result = result.replace('HH', padZero(hours))
	result = result.replace('mm', padZero(minutes))
	result = result.replace('SSS', padZero(milliseconds, 3))
	result = result.replace('ss', padZero(seconds))

	/* 单字符替换放在后面避免冲突 */
	if (result.includes('w')) {
		const weekNames = ['日', '一', '二', '三', '四', '五', '六']
		result = result.replace('w', weekNames[week])
	}

	return result
}

/**
 * 表格时间格式化
 */
export const formatTableDate = (cellValue : string, pattern : string = 'yyyy-MM-dd HH:mm:ss') : string => {
	if (cellValue.length == 0) return ''
	return formatDate(new Date(cellValue), pattern)
}

/**
 * 日期格式化简化版 - 只返回年月日
 */
export const formatDay = (time : Date | string | number) : string => {
	return formatDate(time, 'yyyy-MM-dd')
}

/**
 * 相对时间格式化
 */
export const formatRelativeTime = (time : string | number, option ?: string) : string => {
	let t : number
	const timeStr = `${time}`
	if (timeStr.length == 10) {
		t = parseInt(timeStr) * 1000
	} else {
		t = typeof time == 'number' ? time as number : parseInt(time as string)
	}
	const date = new Date(t)
	const now = Date.now()
	const diff = (now - date.getTime()) / 1000

	if (diff < 30) {
		return '刚刚'
	} else if (diff < 3600) {
		return `${Math.ceil(diff / 60)}分钟前`
	} else if (diff < 3600 * 24) {
		return `${Math.ceil(diff / 3600)}小时前`
	} else if (diff < 3600 * 24 * 2) {
		return '1天前'
	}

	if (option != null) {
		return formatDate(date, option!)
	} else {
		return `${date.getMonth() + 1}月${date.getDate()}日${date.getHours()}时${date.getMinutes()}分`
	}
}

/**
 * 格式化日期范围为字符串
 */
export const formatDateRange = (dateRange : Date[], separator : string = '~', format : string = 'yyyy-MM-dd') : string => {
	if (dateRange.length != 2) {
		return ''
	}
	return `${formatDate(dateRange[0], format)} ${separator} ${formatDate(dateRange[1], format)}`
}

/**
 * 获取当前时间
 */
export const getCurrentTime = (pattern : string = 'HH:mm:ss') : string => {
	return formatDate(new Date(), pattern)
}

/**
 * 获取当前年月日
 */
export const getCurrentDate = () : string => {
	return formatDate(new Date(), 'yyyy-MM-dd')
}

/**
 * 获取当前完整日期时间
 */
export const getCurrentDateTime = () : string => {
	return formatDate(new Date(), 'yyyy-MM-dd HH:mm:ss')
}

/**
 * 解析日期字符串为 Date 对象
 */
export const parseDate = (dateStr : string) : Date | null => {
	if (dateStr.length == 0) {
		return null
	}

	const date = new Date(dateStr)
	return isNaN(date.getTime()) ? null : date
}

/**
 * 获取时间戳
 */
export const getTimeStamp = (type : string = 'ms') : number => {
	const now = new Date().getTime()
	return type == 'ms' ? now : Math.floor(now / 1000)
}

/**
 * 获取日期范围
 * @param days 天数，负数表示过去，正数表示未来
 */
export const getDateRange = (days : number) : Date[] => {
	const end = new Date()
	const start = new Date()
	start.setTime(start.getTime() + 3600 * 1000 * 24 * days)
	return [start, end]
}

/**
 * 获取本周的开始和结束日期
 */
export const getCurrentWeekRange = () : Date[] => {
	const now = new Date()
	let currentDay = now.getDay()
	if (currentDay == 0) currentDay = 7

	const monday = new Date(now)
	monday.setDate(now.getDate() - (currentDay - 1))
	monday.setHours(0, 0, 0, 0)

	const sunday = new Date(now)
	sunday.setDate(now.getDate() + (7 - currentDay))
	sunday.setHours(23, 59, 59, 999)

	return [monday, sunday]
}

/**
 * 获取本月的开始和结束日期
 */
export const getCurrentMonthRange = () : Date[] => {
	const now = new Date()
	const firstDay = new Date(now.getFullYear(), now.getMonth(), 1)
	const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0)
	lastDay.setHours(23, 59, 59, 999)

	return [firstDay, lastDay]
}

/**
 * 根据日期类型获取日期范围
 */
export const getDateRangeByType = (dateType : string) : string[] | null => {
	if (dateType.length == 0) return null

	const today = new Date()
	const endDate = new Date(today)
	endDate.setHours(23, 59, 59, 999)

	let startDate : Date

	if (dateType == 'today') {
		startDate = new Date(today)
		startDate.setHours(0, 0, 0, 0)
	} else if (dateType == 'yesterday') {
		startDate = new Date(today)
		startDate.setDate(startDate.getDate() - 1)
		startDate.setHours(0, 0, 0, 0)
		endDate.setDate(endDate.getDate() - 1)
		endDate.setHours(23, 59, 59, 999)
	} else if (dateType == 'week') {
		startDate = new Date(today)
		const dayOfWeek = startDate.getDay()
		const daysToMonday = dayOfWeek == 0 ? 6 : dayOfWeek - 1
		startDate.setDate(startDate.getDate() - daysToMonday)
		startDate.setHours(0, 0, 0, 0)
	} else if (dateType == 'month') {
		startDate = new Date(today.getFullYear(), today.getMonth(), 1)
	} else if (dateType == 'year') {
		startDate = new Date(today.getFullYear(), 0, 1)
	} else {
		return null
	}

	return [
		formatDate(startDate, 'yyyy-MM-dd HH:mm:ss'),
		formatDate(endDate, 'yyyy-MM-dd HH:mm:ss'),
	]
}

/**
 * 计算两个日期之间的天数
 */
export const getDaysBetween = (start : Date, end : Date) : number => {
	const startTime = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime()
	const endTime = new Date(end.getFullYear(), end.getMonth(), end.getDate()).getTime()
	const days = (endTime - startTime) / (1000 * 60 * 60 * 24)
	return Math.abs(Math.round(days))
}

/**
 * 判断是否为同一天
 */
export const isSameDay = (date1 : Date, date2 : Date) : boolean => {
	return date1.getFullYear() == date2.getFullYear()
		&& date1.getMonth() == date2.getMonth()
		&& date1.getDate() == date2.getDate()
}

/**
 * 获取日期是一年中的第几周
 */
export const getWeekOfYear = (date : Date) : number => {
	const firstDayOfYear = new Date(date.getFullYear(), 0, 1)
	const pastDaysOfYear = (date.getTime() - firstDayOfYear.getTime()) / 86400000
	return Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7)
}

/**
 * 日期加减
 */
export const dateAdd = (date : Date, type : string, value : number) : Date => {
	const result = new Date(date)

	if (type == 'day') {
		result.setDate(result.getDate() + value)
	} else if (type == 'month') {
		result.setMonth(result.getMonth() + value)
	} else if (type == 'year') {
		result.setFullYear(result.getFullYear() + value)
	}

	return result
}
