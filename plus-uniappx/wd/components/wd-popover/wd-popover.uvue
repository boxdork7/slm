<!--
Popover 气泡 常用于展示提示信息。

UniApp X 版本
- 移除 defineOptions
- 移除 export type PlacementType
- 移除手动 wdIcon/wdTransition 导入（easycom 自动注册）
- any → UTSJSONObject
- PlacementType → string
- PopoverMode → string
- edeep → e（UniApp X mixin）
- :deep() → 直接类选择器
- display: inline-block → display: flex
- usePopover 需要传递组件实例
-->
<template>
  <view
    id="popover"
    :class="`wd-popover ${customClass}`"
    :style="customStyle"
    @click.stop="popover.noop"
  >
    <!-- 使用插槽时无法获取正确宽高 -->
    <view id="pos" class="wd-popover__pos wd-popover__hidden">
      <view :class="`wd-popover__container ${customPop}`">
        <view v-if="!useContentSlot && mode === 'normal'" class="wd-popover__inner">
          {{ content }}
        </view>
        <view
          v-if="!useContentSlot && mode === 'menu' && typeof content === 'object'"
          class="wd-popover__menu"
        >
          <view
            v-for="(item, index) in content"
            :key="index"
            class="wd-popover__menu-inner"
            @click="menuClick(index)"
          >
            <wd-icon v-if="item.iconClass" :name="item.iconClass" custom-class="wd-popover__icon" />
            <text>{{ item.content }}</text>
          </view>
        </view>
      </view>
    </view>
    <wd-transition
      custom-class="wd-popover__pos"
      :custom-style="popover.popStyle.value"
      :show="showPopover"
      name="fade"
      :duration="200"
    >
      <view :class="`wd-popover__container ${customPop}`">
        <view
          v-if="visibleArrow"
          :class="`wd-popover__arrow ${popover.arrowClass.value} ${customArrow}`"
          :style="popover.arrowStyle.value"
        />
        <!-- 普通模式 -->
        <view v-if="!useContentSlot && mode === 'normal'" class="wd-popover__inner">
          {{ content }}
        </view>
        <!-- 列表模式 -->
        <view v-if="!useContentSlot && mode === 'menu'" class="wd-popover__menu">
          <view
            v-for="(item, index) in content"
            :key="index"
            class="wd-popover__menu-inner"
            :style="index === 0 ? 'border-top: none' : ''"
            @click="menuClick(index)"
          >
            <wd-icon
              v-if="typeof item === 'object' && item.iconClass"
              :name="item.iconClass"
              custom-class="wd-popover__icon"
            />
            <view style="display: flex">
              {{ typeof item === 'object' && item.content ? item.content : '' }}
            </view>
          </view>
        </view>
        <!-- 用户自定义样式 -->
        <slot v-else name="content" />
      </view>
      <wd-icon
        v-if="showClose"
        name="close"
        custom-class="wd-popover__close-icon"
        @click="toggle"
      />
    </wd-transition>
    <view id="target" class="wd-popover__target" @click="toggle">
      <slot />
    </view>
  </view>
</template>

<script lang="uts" setup>
import { getCurrentInstance, onBeforeMount, onBeforeUnmount, onMounted, ref, watch } from 'vue'
import { closeOther, pushToQueue, removeFromQueue } from '../common/clickoutside'
import { isArray } from '../common/util'
import { usePopover } from '../../composables/usePopover'

/**
 * 气泡组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 自定义箭头样式类 */
  customArrow ?: string
  /** 自定义弹出层样式类 */
  customPop ?: string
  /** 是否显示 popover 箭头 */
  visibleArrow ?: boolean
  /** 显示的内容，也可以通过 slot#content 传入 */
  content ?: string | UTSJSONObject[]
  /** 指定 popover 的放置位置 */
  placement ?: string
  /** 偏移量 */
  offset ?: number
  /** 是否使用内容插槽 */
  useContentSlot ?: boolean
  /** 是否禁用 popover */
  disabled ?: boolean
  /** 是否显示关闭按钮 */
  showClose ?: boolean
  /** 控制 popover 的显示状态 */
  modelValue ?: boolean
  /** 当前显示的模式，决定内容的展现形式，可选值：normal（普通模式）/ menu（菜单模式） */
  mode ?: string
}>(), {
  customStyle: '',
  customClass: '',
  customArrow: '',
  customPop: '',
  visibleArrow: true,
  placement: 'bottom',
  offset: 0,
  useContentSlot: false,
  disabled: false,
  showClose: false,
  modelValue: false,
  mode: 'normal',
})

/** 组件事件 */
const emit = defineEmits([
  'update:modelValue',
  'menuclick',
  'change',
  'open',
  'close',
])

/** 响应式数据 */
const showPopover = ref(false)

/** 获取组件实例 */
const instance = getCurrentInstance()!
const selector = 'popover'
const popover = usePopover(props.visibleArrow)

/**
 * 监听内容变化
 * 验证不同模式下内容类型的正确性
 */
watch(
  () : string | UTSJSONObject[] | null => props.content,
  (newVal : string | UTSJSONObject[] | null) => {
    const mode = props.mode
    if (mode === 'normal' && typeof newVal !== 'string') {
      console.error('气泡组件在普通模式下内容必须是字符串类型')
    } else if (mode === 'menu' && !isArray(newVal)) {
      console.error('气泡组件在菜单模式下内容必须是数组类型')
    }
  },
)

/**
 * 监听位置变化
 * 重新初始化弹出框位置
 */
watch(
  () : string => props.placement,
  () => {
    popover.init(props.placement, props.visibleArrow, selector, instance)
  },
)

/**
 * 监听外部控制的显示状态
 * 同步内部状态
 */
watch(
  () : boolean => props.modelValue,
  (newValue : boolean) => {
    showPopover.value = newValue
  },
)

/**
 * 监听内部显示状态变化
 * 处理弹出框的显示逻辑和事件触发
 */
watch(
  () : boolean => showPopover.value,
  (newValue : boolean) => {
    if (newValue) {
      popover.control(props.placement, props.offset)
      closeOther(instance)
    }
    popover.showStyle.value = newValue ? 'display: flex;' : 'display: none;'
    emit('change', { show: newValue })
    newValue ? emit('open') : emit('close')
  },
)

/**
 * 更新显示状态
 */
const updateModelValue = (value : boolean) => {
  showPopover.value = value
  emit('update:modelValue', value)
}

/**
 * 菜单项点击处理
 */
const menuClick = (index : number) => {
  updateModelValue(false)
  const contentArray = props.content as UTSJSONObject[]
  emit('menuclick', {
    item: contentArray[index],
    index,
  })
}

/**
 * 切换显示状态
 */
const toggle = () => {
  if (props.disabled) return
  updateModelValue(!showPopover.value)
}

/**
 * 打开弹出框
 */
const open = () => {
  updateModelValue(true)
}

/**
 * 关闭弹出框
 */
const close = () => {
  updateModelValue(false)
}

/**
 * 组件挂载后初始化
 */
onMounted(() => {
  popover.init(props.placement, props.visibleArrow, selector, instance)
})

/**
 * 组件挂载前处理
 */
onBeforeMount(() => {
  pushToQueue(instance)
  popover.showStyle.value = showPopover.value ? 'opacity: 1;' : 'opacity: 0;'
})

/**
 * 组件卸载前清理
 */
onBeforeUnmount(() => {
  removeFromQueue(instance)
})

/** 暴露组件方法 */
defineExpose({
  open,
  close,
})
</script>

<style lang="scss">
@import '../../common/abstracts/_mixin.scss';
@import '../../common/abstracts/variable.scss';

/* 暗色主题样式 */
.wot-theme-dark {
  .wd-popover__pos {
    background: rgb(75, 76, 77);
    color: $-dark-color;
    box-shadow: 0 4rpx 20rpx 0 rgba(75, 76, 77, 0.1);
  }

  .wd-popover__menu {
    background: rgb(75, 76, 77);
  }

  .wd-popover__inner {
    background-color: rgb(75, 76, 77);
  }

  .wd-popover__menu-inner {
    @include halfPixelBorder('top', 0, $-dark-border-color);
  }

  @include squareArrow(
    $-popover-arrow-size,
    rgb(75, 76, 77),
    $-popover-z-index - 1,
    $-popover-arrow-box-shadow
  );
}

/* 气泡组件主体样式 */
@include b(popover) {
  position: relative;
  display: flex;

  /* 图标样式 */
  @include e(icon) {
    vertical-align: middle;
    font-size: 36rpx;
    margin-right: 10rpx;
  }

  /* 菜单内部样式 */
  @include e(menu-inner) {
    position: relative;
    padding: $-popover-padding 0;
    display: flex;
    align-items: center;

    @include halfPixelBorder('top', 0, $-popover-border-color);

    &:first-child::after {
      display: none;
    }
  }

  /* 菜单样式 */
  @include e(menu) {
    display: flex;
    padding: 0 $-popover-padding;
    white-space: nowrap;
    z-index: $-popover-z-index;
    position: relative;
    background: $-popover-bg;
    border-radius: $-popover-radius;
  }

  /* 弹出位置样式 */
  @include e(pos) {
    position: absolute;
    box-sizing: border-box;
    background-clip: padding-box;
    text-align: center;
    min-height: 72rpx;
    z-index: $-popover-z-index;
    line-height: $-popover-line-height;
    font-size: $-popover-fs;
    border-radius: $-popover-radius;
    transition: opacity 0.2s;
    background: $-popover-bg;
    box-shadow: $-popover-box-shadow;
    color: $-popover-color;
  }

  /* 隐藏状态 */
  @include e(hidden) {
    left: -100vw;
    visibility: hidden;
  }

  /* 容器样式 */
  @include e(container) {
    position: relative;
    line-height: $-tooltip-line-height;
    font-size: $-tooltip-fs;
  }

  /* 内部样式 */
  @include e(inner) {
    position: relative;
    white-space: nowrap;
    padding: $-popover-padding;
    line-height: $-popover-line-height;
    z-index: $-popover-z-index;
    background-color: $-popover-bg;
    border-radius: $-popover-radius;
  }

  /* 关闭图标样式 */
  @include e(close-icon) {
    font-size: 24rpx;
    position: absolute;
    right: -16rpx;
    top: -20rpx;
    transform: translateY(-50%) rotate(-45deg);
    padding: 20rpx;
  }

  /* 箭头样式 */
  @include squareArrow(
    $-popover-arrow-size,
    $-popover-bg,
    $-popover-z-index - 1,
    $-popover-arrow-box-shadow
  );
}
</style>
