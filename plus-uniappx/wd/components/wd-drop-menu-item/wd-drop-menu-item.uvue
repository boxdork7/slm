<!--
DropMenu 下拉菜单每一项

UniApp X 版本改动说明：
- 移除 defineOptions（UTS 不支持）
- 移除手动组件导入（easycom 自动注册）
- DropMenuItemBeforeToggle 类型定义移到 wd-drop-menu-key.uts
- useParent(DROP_MENU_KEY) → inject(DROP_MENU_KEY) + genChildUid 模式
- getCurrentInstance() → inject + getCurrentInstance 结合使用
- ComponentPublicInstance → 移除（UTS 不支持）
- Record<string, any> → UTSJSONObject
- PopupType → string
- isFunction → 直接判断 != null
- pushToQueue/removeFromQueue → 通过队列注入
- <text> 代替文本内容
- v-if 中的表达式简化（UTS 不支持复杂三元表达式）
- 子组件通过父组件的 registerChildInfo 方法注册信息
-->
<template>
  <view
    v-if="showWrapper"
    :class="`wd-drop-item ${customClass}`"
    :style="`pointer-events: none; z-index: ${zIndex}; ${positionStyle};${customStyle}`"
  >
    <wd-popup
      v-model="showPop"
      :z-index="zIndex"
      :duration="duration"
      :position="position"
      :custom-style="`position: absolute; pointer-events: auto; max-height: 80%;${customPopupStyle}`"
      :custom-class="customPopupClass"
      :modal="false"
      :close-on-click-modal="false"
      @before-enter="beforeEnter"
      @after-enter="afterEnter"
      @before-leave="beforeLeave"
      @after-leave="afterLeave"
    >
      <view v-if="options.length > 0">
        <view
          v-for="(item, index) in options"
          :key="index"
          :class="`wd-drop-item__option ${getOptionValue(item) === modelValue ? 'is-active' : ''}`"
          @click="choose(index)"
        >
          <view :class="`wd-drop-item__title ${customTitle}`">
            <text>{{ getOptionLabel(item) }}</text>
            <text v-if="getOptionTip(item) !== ''" class="wd-drop-item__tip">
              {{ getOptionTip(item) }}
            </text>
          </view>
          <wd-icon
            v-if="getOptionValue(item) === modelValue"
            :name="iconName"
            :custom-class="`wd-drop-item__icon ${customIcon}`"
          />
        </view>
      </view>
      <slot v-else />
    </wd-popup>
  </view>
</template>

<script lang="uts" setup>
import { computed, getCurrentInstance, inject, onBeforeMount, onBeforeUnmount, ref, watch } from 'vue'
import { addUnit, isDef } from '../common/util'
import { genChildUid } from '../../composables/useChildren'
import { DROP_MENU_KEY, type DropMenuProvide, type DropMenuItemInfo } from '../wd-drop-menu/wd-drop-menu-key'

/**
 * 下拉菜单项切换前回调选项
 */
type DropMenuItemBeforeToggleOption = {
	/** 操作状态：true 打开下拉菜单，false 关闭下拉菜单 */
	status : boolean
	/** 回调函数，用于控制是否允许打开或关闭下拉菜单，true 允许打开或关闭，false 不允许打开或关闭 */
	resolve : (isPass : boolean) => void
}

/**
 * 下拉菜单项切换前回调函数
 */
type DropMenuItemBeforeToggle = (option : DropMenuItemBeforeToggleOption) => void

/**
 * 下拉菜单项组件属性接口
 */
const props = withDefaults(defineProps<{
	/** 自定义根节点样式 */
	customStyle ?: string
	/** 自定义根节点样式类 */
	customClass ?: string
	/** DropMenuItem 左侧文字样式 */
	customTitle ?: string
	/** DropMenuItem 右侧 icon 样式 */
	customIcon ?: string
	/** 当前选中项对应选中的 value */
	modelValue ?: string | number
	/** 列表数据，对应数据结构 [{text: '标题', value: '0', tip: '提示文字'}] */
	options ?: UTSJSONObject[]
	/** 禁用菜单 */
	disabled ?: boolean
	/** 选中的图标名称(可选名称在 wd-icon 组件中) */
	iconName ?: string
	/** 菜单标题 */
	title ?: string
	/** 菜单图标 */
	icon ?: string
	/** 菜单图标大小 */
	iconSize ?: string | number
	/** 自定义点击事件 */
	beforeToggle ?: DropMenuItemBeforeToggle | null
	/** 选项对象中，value 对应的 key */
	valueKey ?: string
	/** 选项对象中，展示的文本对应的 key */
	labelKey ?: string
	/** 选项对象中，选项说明对应的 key */
	tipKey ?: string
	/** 自定义下拉菜单popup样式类 */
	customPopupClass ?: string
	/** 自定义下拉菜单popup样式 */
	customPopupStyle ?: string
}>(), {
	customStyle: '',
	customClass: '',
	customTitle: '',
	customIcon: '',
	modelValue: null,
	options: () : UTSJSONObject[] => [],
	disabled: false,
	iconName: 'check',
	title: '',
	icon: 'arrow-down',
	iconSize: '',
	beforeToggle: null,
	valueKey: 'value',
	labelKey: 'label',
	tipKey: 'tip',
	customPopupClass: '',
	customPopupStyle: '',
})

/**
 * 下拉菜单项组件事件接口
 */
const emit = defineEmits<{
	/** 更新选中值时触发 */
	'update:modelValue': [value : string | number | null]
	/** 选中项改变时触发 */
	change: [event : { value : string | number | null, selectedItem : UTSJSONObject }]
	/** 下拉菜单打开前触发 */
	open: []
	/** 下拉菜单打开后触发 */
	opened: []
	/** 下拉菜单关闭前触发 */
	close: []
	/** 下拉菜单关闭后触发 */
	closed: []
}>()

/* 注入队列管理器 */
const queue = inject<UTSJSONObject | null>('wd-queue', null)

/* 获取父级下拉菜单组件 */
const dropMenu = inject<DropMenuProvide | null>(DROP_MENU_KEY, null)

/* 当前组件的唯一 ID */
const uid = genChildUid()

/* 获取当前组件实例（用于访问父组件方法） */
const instance = getCurrentInstance()

/* 响应式数据 */
const showWrapper = ref<boolean>(false)
const showPop = ref<boolean>(false)
const position = ref<string>('top')
const zIndex = ref<number>(12)
const duration = ref<number>(0)

/**
 * 计算位置样式
 * 根据父级下拉菜单的方向和偏移量计算位置
 */
const positionStyle = computed(() : string => {
	let style : string = ''
	if (showWrapper.value && dropMenu != null) {
		style =
			dropMenu!.props.direction == 'down'
				? `top: ${addUnit(dropMenu!.offset)}; bottom: 0;`
				: `top: 0; bottom: ${addUnit(dropMenu!.offset)}`
	} else {
		style = ''
	}
	return style
})

/**
 * 获取选项的值
 */
const getOptionValue = (item : UTSJSONObject) : string | number | null => {
	const value = item[props.valueKey]
	if (value != null) {
		return value as (string | number)
	}
	return null
}

/**
 * 获取选项的标签
 */
const getOptionLabel = (item : UTSJSONObject) : string => {
	const label = item[props.labelKey]
	if (label != null) {
		return label as string
	}
	return ''
}

/**
 * 获取选项的提示
 */
const getOptionTip = (item : UTSJSONObject) : string => {
	const tip = item[props.tipKey]
	if (tip != null) {
		return tip as string
	}
	return ''
}

/**
 * 监听 modelValue 变化
 * 验证 modelValue 的类型是否正确
 */
watch(
	() : string | number | null => props.modelValue,
	(newValue : string | number | null) => {
		if (isDef(newValue) && typeof newValue != 'number' && typeof newValue != 'string') {
			console.error('[wot-design] warning(wd-drop-menu-item): the type of value should be a number or a string.')
		}
		/* 更新父组件中的信息 */
		updateParentInfo()
	},
	{
		deep: true,
		immediate: true,
	},
)

/**
 * 监听 showPop 变化
 * 更新父组件中的信息
 */
watch(
	() : boolean => showPop.value,
	() => {
		updateParentInfo()
	},
)

/**
 * 获取弹出层显示状态
 * @returns 弹出层是否显示
 */
const getShowPop = () : boolean => {
	return showPop.value
}

/**
 * 处理关闭操作
 */
const handleClose = () : void => {
	if (showPop.value) {
		showPop.value = false
	}
}

/**
 * 外部关闭弹出框
 */
const close = () : void => {
	if (!showPop.value) {
		return
	}
	if (props.beforeToggle != null) {
		props.beforeToggle!({
			status: false,
			resolve: (isPass : boolean) => {
				if (isPass) {
					handleClose()
				}
			},
		})
	} else {
		handleClose()
	}
}

/**
 * 模拟单选操作
 * 默认根据 value 选中操作
 * @param index 选项索引
 */
const choose = (index : number) : void => {
	if (props.disabled) return

	const item = props.options[index]
	const newValue = getOptionValue(item)
	emit('update:modelValue', newValue)
	emit('change', {
		value: newValue,
		selectedItem: item,
	})
	close()
}

/**
 * 处理打开操作
 */
const handleOpen = () : void => {
	showWrapper.value = true
	showPop.value = true
	if (dropMenu != null) {
		duration.value = Number(dropMenu!.props.duration)
		position.value = dropMenu!.props.direction == 'down' ? 'top' : 'bottom'
	}
}

/**
 * 打开下拉菜单
 */
const open = () : void => {
	if (showPop.value) {
		return
	}
	if (props.beforeToggle != null) {
		props.beforeToggle!({
			status: true,
			resolve: (isPass : boolean) => {
				if (isPass) {
					handleOpen()
				}
			},
		})
	} else {
		handleOpen()
	}
}

/**
 * 切换下拉菜单显示状态
 */
const toggle = () : void => {
	if (showPop.value) {
		close()
	} else {
		open()
	}
}

/**
 * 弹出层进入前的处理
 */
const beforeEnter = () : void => {
	emit('open')
}

/**
 * 弹出层进入后的处理
 */
const afterEnter = () : void => {
	emit('opened')
}

/**
 * 弹出层离开前的处理
 */
const beforeLeave = () : void => {
	emit('close')
}

/**
 * 弹出层离开后的处理
 */
const afterLeave = () : void => {
	showWrapper.value = false
	emit('closed')
}

/**
 * 更新父组件中的子组件信息
 */
const updateParentInfo = () : void => {
	const parentInstance = instance?.proxy?.$parent
	if (parentInstance != null && typeof parentInstance.updateChildInfo == 'function') {
		const info : DropMenuItemInfo = {
			uid: uid,
			disabled: props.disabled,
			showPop: showPop.value,
			title: props.title,
			modelValue: props.modelValue,
			options: props.options,
			valueKey: props.valueKey,
			labelKey: props.labelKey,
			icon: props.icon,
			iconSize: props.iconSize != null ? String(props.iconSize) : '',
			toggle: toggle,
			close: close,
		}
		parentInstance.updateChildInfo(info)
	}
}

/**
 * 注册到父组件
 */
const registerToParent = () : void => {
	const parentInstance = instance?.proxy?.$parent
	if (parentInstance != null && typeof parentInstance.registerChildInfo == 'function') {
		const info : DropMenuItemInfo = {
			uid: uid,
			disabled: props.disabled,
			showPop: showPop.value,
			title: props.title,
			modelValue: props.modelValue,
			options: props.options,
			valueKey: props.valueKey,
			labelKey: props.labelKey,
			icon: props.icon,
			iconSize: props.iconSize != null ? String(props.iconSize) : '',
			toggle: toggle,
			close: close,
		}
		parentInstance.registerChildInfo(info)
	}
}

/**
 * 从父组件注销
 */
const unregisterFromParent = () : void => {
	const parentInstance = instance?.proxy?.$parent
	if (parentInstance != null && typeof parentInstance.unregisterChildInfo == 'function') {
		parentInstance.unregisterChildInfo(uid)
	}
}

/**
 * 组件挂载前的处理
 * 注册到父组件和队列中
 */
onBeforeMount(() => {
	/* 注册到父组件 */
	if (dropMenu != null) {
		dropMenu!.addChild(uid)
	}

	/* 注册子组件信息到父组件 */
	registerToParent()

	/* 将当前组件添加到队列中 */
	if (queue != null && queue['pushToQueue'] != null) {
		const pushToQueue = queue['pushToQueue'] as ((item : any) => void)
		pushToQueue(instance?.proxy)
	}
})

/**
 * 组件卸载前的处理
 * 从父组件和队列中移除
 */
onBeforeUnmount(() => {
	/* 从父组件注销 */
	if (dropMenu != null) {
		dropMenu!.removeChild(uid)
	}

	/* 从父组件注销子组件信息 */
	unregisterFromParent()

	/* 将当前组件从队列中移除 */
	if (queue != null && queue['removeFromQueue'] != null) {
		const removeFromQueue = queue['removeFromQueue'] as ((item : any) => void)
		removeFromQueue(instance?.proxy)
	}
})

/* 暴露组件方法 */
defineExpose({ getShowPop, open, close, toggle })
</script>

<style lang="scss">
/* 引入外部样式文件 */
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(drop-item) {
    color: $-dark-color;

    @include e(tip) {
      color: $-dark-color3;
    }
  }
}

/* 下拉菜单项主体样式 */
@include b(drop-item) {
  position: fixed;
  right: 0;
  left: 0;
  overflow: hidden;
  font-size: $-drop-menu-item-fs;
  color: $-drop-menu-item-color;
  width: 100%;
  z-index: 101;

  /* 弹出层样式 */
  @include e(popup) {
    position: absolute;
    max-height: 80%;
  }

  /* 选项样式 */
  @include e(option) {
    display: flex;
    height: $-drop-menu-item-height;
    line-height: $-drop-menu-item-height;
    padding: 0 $-drop-menu-side-padding;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s;

    /* 激活状态样式 */
    @include when(active) {
      color: $-drop-menu-item-color-active;
    }
  }

  /* 标题样式 */
  @include e(title) {
    display: block;
  }

  /* 提示文字样式 */
  @include e(tip) {
    display: inline-block;
    color: $-drop-menu-item-color-tip;
    font-size: $-drop-menu-item-fs-tip;
    margin-left: 2px;
  }

  /* 图标样式（移除 edeep，直接使用类选择器） */
  .wd-drop-item__icon {
    display: block;
    font-size: $-drop-menu-option-check-size;
  }

  /* 遮罩层样式 */
  @include e(modal) {
    position: fixed;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.7);
    height: 100%;
  }
}
</style>
