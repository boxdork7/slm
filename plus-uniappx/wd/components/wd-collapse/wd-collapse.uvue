<!--
Collapse 折叠面板 将一组内容放置在多个折叠面板中，点击面板的标题可以展开或收缩其内容。

UniApp X 版本改动说明：
- 移除 defineOptions（UTS 不支持）
- 移除手动组件导入（easycom 自动注册）
- CollapseToggleAllOptions 类型定义移到 wd-collapse-key.uts
- useChildren(COLLAPSE_KEY) → createChildManager() + provide 模式
- ComponentPublicInstance → 移除（UTS 不支持）
- 'string | string[] | boolean' 联合类型保持不变（UTS 支持）
- isBoolean/isDef/isArray 保留使用
- children 访问改为通过 inject 的 childRefs 数组（需要子组件注册）
- toggleAll 需要重新设计（无法直接访问子组件实例）
- <span> → <text>（UniApp X 标准）
-->
<template>
  <view
    :class="`wd-collapse ${viewmore ? 'is-viewmore' : ''} ${customClass}`"
    :style="customStyle"
  >
    <!-- 普通或手风琴 -->
    <block v-if="!viewmore">
      <slot />
    </block>
    <!-- 查看更多模式 -->
    <view v-else>
      <view
        :class="`wd-collapse__content ${!modelValue ? 'is-retract' : ''}`"
        :style="`-webkit-line-clamp: ${contentLineNum}; -webkit-box-orient: vertical`"
      >
        <slot />
      </view>
      <view class="wd-collapse__more" @click="handleMore">
        <!-- 自定义展开按钮 -->
        <view v-if="useMoreSlot" :class="customMoreSlotClass">
          <slot name="more" />
        </view>
        <!-- 显示展开或折叠按钮 -->
        <block v-else>
          <text class="wd-collapse__more-txt">
            {{ !modelValue ? translate('expand') : translate('retract') }}
          </text>
          <view :class="`wd-collapse__arrow ${modelValue ? 'is-retract' : ''}`">
            <wd-icon name="down" />
          </view>
        </block>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
import { onBeforeMount, ref, watch, provide, reactive, computed } from 'vue'
import { isArray, isBoolean, isDef } from '../common/util'
import { createChildManager } from '../../composables/useChildren'
import { useTranslate } from '../../composables/useTranslate'
import { COLLAPSE_KEY, type CollapseProvide, type CollapseToggleAllOptions, type CollapseItemRef } from './wd-collapse-key'

/**
 * 折叠面板组件属性接口
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 查看更多模式下的插槽外部自定义样式 */
  customMoreSlotClass ?: string
  /** 绑定值 */
  modelValue ?: string | string[] | boolean
  /** 手风琴模式 */
  accordion ?: boolean
  /** 查看更多的折叠面板 */
  viewmore ?: boolean
  /** 查看更多的自定义插槽使用标志 */
  useMoreSlot ?: boolean
  /** 查看更多的折叠面板，收起时的显示行数 */
  lineNum ?: number
}>(), {
  customStyle: '',
  customClass: '',
  customMoreSlotClass: '',
  modelValue: () : string[] => [],
  accordion: false,
  viewmore: false,
  useMoreSlot: false,
  lineNum: 2,
})

/**
 * 折叠面板组件事件接口
 */
const emit = defineEmits<{
  /** 更新绑定值时触发 */
  'update:modelValue': [value : string | string[] | boolean]
  /** 面板状态改变时触发 */
  change: [event : { value : string | string[] | boolean }]
}>()

/* 获取翻译函数 */
const { translate } = useTranslate('collapse')

/* 响应式数据：查看更多的折叠面板，收起时的显示行数 */
const contentLineNum = ref<number>(0)

/* 子组件管理器 */
const manager = createChildManager()

/* 子组件引用注册表（子组件通过 registerChild 注册自己的方法） */
const childRefs = reactive<Map<number, CollapseItemRef>>(new Map<number, CollapseItemRef>())

/**
 * 注册子组件引用（子组件调用）
 */
const registerChildRef = (ref : CollapseItemRef) => {
  childRefs.set(ref.uid, ref)
}

/**
 * 注销子组件引用（子组件调用）
 */
const unregisterChildRef = (uid : number) => {
  childRefs.delete(uid)
}

/**
 * 获取已注册的子组件引用列表（按注册顺序）
 */
const getChildRefs = computed(() : CollapseItemRef[] => {
  const refs : CollapseItemRef[] = []
  for (let i = 0; i < manager.childUids.length; i++) {
    const uid = manager.childUids[i]
    const ref = childRefs.get(uid)
    if (ref != null) {
      refs.push(ref!)
    }
  }
  return refs
})

/**
 * 更新状态变化
 * @param activeNames 激活的面板名称
 */
const updateChange = (activeNames : string | string[] | boolean) => {
  emit('update:modelValue', activeNames)
  emit('change', {
    value: activeNames,
  })
}

/**
 * 切换面板状态
 * @param name 面板名称
 * @param expanded 是否展开
 */
const toggle = (name : string, expanded : boolean) => {
  if (props.accordion) {
    updateChange(name == (props.modelValue as string) ? '' : name)
  } else if (expanded) {
    updateChange((props.modelValue as string[]).concat(name))
  } else {
    updateChange((props.modelValue as string[]).filter((activeName : string) : boolean => activeName != name))
  }
}

/**
 * 切换所有面板展开状态
 * 传 true 为全部展开，false 为全部收起，不传参为全部切换
 * @param options 面板状态
 */
const toggleAll = (options : CollapseToggleAllOptions | null = null) => {
  if (props.accordion) {
    return
  }

  /* 处理参数 */
  let expanded : boolean | null = null
  let skipDisabled = false
  if (options != null) {
    expanded = options!.expanded
    skipDisabled = options!.skipDisabled ?? false
  }

  const names : string[] = []
  const childRefList = getChildRefs.value
  for (let i = 0; i < childRefList.length; i++) {
    const item = childRefList[i]
    if (item.disabled && skipDisabled) {
      if (item.getExpanded()) {
        names.push(item.name)
      }
    } else if (expanded != null ? expanded! : !item.getExpanded()) {
      names.push(item.name)
    }
  }
  updateChange(names)
}

/**
 * 查看更多点击处理
 */
const handleMore = () => {
  emit('update:modelValue', !(props.modelValue as boolean))
  emit('change', {
    value: !(props.modelValue as boolean),
  })
}

/**
 * 监听 modelValue 变化
 * 验证不同模式下的数据类型
 */
watch(
  () : string | string[] | boolean => props.modelValue!,
  (newVal : string | string[] | boolean) => {
    /* 手风琴状态下 value 类型只能为 string */
    if (props.accordion && typeof newVal != 'string') {
      console.error('accordion value must be string')
    } else if (!props.accordion && !props.viewmore && !isArray(newVal)) {
      console.error('value must be Array')
    }
  },
  { deep: true },
)

/**
 * 监听 lineNum 变化
 * 验证行数必须大于0
 */
watch(
  () : number => props.lineNum,
  (newVal : number) => {
    if (newVal <= 0) {
      console.error('lineNum must greater than 0')
    }
  },
  { deep: true, immediate: true },
)

/**
 * 组件挂载前的处理
 * 初始化查看更多模式的行数
 */
onBeforeMount(() => {
  contentLineNum.value = props.viewmore && !props.modelValue ? props.lineNum : 0
})

/* Provide 数据给子组件 */
const collapseProvide : CollapseProvide = {
  childUids: manager.childUids,
  addChild: manager.addChild,
  removeChild: manager.removeChild,
  modelValue: props.modelValue!,
  accordion: props.accordion,
  viewmore: props.viewmore,
  toggle: toggle,
}

provide(COLLAPSE_KEY, collapseProvide)

/* 暴露组件方法 */
defineExpose({
  toggleAll,
  registerChildRef,
  unregisterChildRef,
})
</script>

<style lang="scss">
/* 引入外部样式文件 */
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(collapse) {
    background: $-dark-background2;

    @include e(content) {
      color: $-dark-color3;
    }
  }
}

/* 折叠面板主体样式 */
@include b(collapse) {
  background: $-color-white;

  /* 查看更多模式样式 */
  @include when(viewmore) {
    padding: $-collapse-side-padding;
  }

  /* 内容区域样式 */
  @include e(content) {
    font-size: $-collapse-body-fs;
    color: $-collapse-body-color;

    /* 收起状态样式 */
    @include when(retract) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: $-collapse-retract-fs;
    }
  }

  /* 更多按钮样式 */
  @include e(more) {
    display: inline-block;
    font-size: $-collapse-retract-fs;
    margin-top: 8px;
    color: $-collapse-more-color;
    user-select: none;
  }

  /* 更多按钮文字样式 */
  @include e(more-txt) {
    display: inline-block;
    vertical-align: middle;
    margin-right: 4px;
  }

  /* 箭头样式 */
  @include e(arrow) {
    display: inline-block;
    vertical-align: middle;
    transition: transform 0.1s;
    font-size: $-collapse-arrow-size;
    height: $-collapse-arrow-size;
    line-height: $-collapse-arrow-size;

    /* 收起状态的箭头样式 */
    @include when(retract) {
      transform: rotate(-180deg);
    }
  }
}
</style>
