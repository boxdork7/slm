<!--
Tooltip 文字提示 常用于展示提示信息。

UniApp X 版本
- 移除 defineOptions
- 移除手动 wdIcon/wdTransition 导入（easycom 自动注册）
- PlacementType → string
- edeep → e（UniApp X mixin）
- :deep() → 直接类选择器
- display: inline-block → display: flex
- usePopover 需要传递组件实例
-->
<template>
  <view
    id="tooltip"
    :class="`wd-tooltip ${customClass}`"
    :style="customStyle"
    @click.stop="popover.noop"
  >
    <!-- 用于为渲染获取宽高的元素 -->
    <view id="pos" class="wd-tooltip__pos wd-tooltip__hidden">
      <view class="custom-pop wd-tooltip__container">
        <view v-if="!useContentSlot" class="wd-tooltip__inner">
          {{ content }}
        </view>
      </view>
    </view>
    <wd-transition
      custom-class="wd-tooltip__pos"
      :custom-style="popover.popStyle.value"
      :show="showTooltip"
      name="fade"
      :duration="200"
    >
      <view class="wd-tooltip__container custom-pop">
        <view
          v-if="visibleArrow"
          :class="`wd-tooltip__arrow ${popover.arrowClass.value} ${customArrow}`"
          :style="popover.arrowStyle.value"
        />
        <!-- 普通模式 -->
        <view v-if="!useContentSlot" class="wd-tooltip__inner">
          {{ content }}
        </view>
        <!-- 用户自定义样式 -->
        <slot v-else name="content" />
      </view>
      <wd-icon
        v-if="showClose"
        name="close"
        custom-class="wd-tooltip__close-icon"
        @click="toggle"
      />
    </wd-transition>
    <view id="target" class="wd-tooltip__target" @click="toggle">
      <slot />
    </view>
  </view>
</template>

<script lang="uts" setup>
import { getCurrentInstance, onBeforeMount, onBeforeUnmount, onMounted, ref, watch } from 'vue'
import { closeOther, pushToQueue, removeFromQueue } from '../common/clickoutside'
import { usePopover } from '../../composables/usePopover'

/**
 * Tooltip组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 自定义箭头内容 */
  customArrow ?: string
  /** 自定义弹出内容 */
  customPop ?: string
  /** 是否显示Tooltip箭头 */
  visibleArrow ?: boolean
  /** 显示的内容，也可以通过slot#content传入 */
  content ?: string | UTSJSONObject[]
  /** Tooltip的出现位置 */
  placement ?: string
  /** 出现位置的偏移量 */
  offset ?: number
  /** 是否使用slot来传入content内容 */
  useContentSlot ?: boolean
  /** Tooltip是否可用 */
  disabled ?: boolean
  /** 是否显示Tooltip内部的关闭按钮 */
  showClose ?: boolean
  /** Tooltip的状态是否可见 */
  modelValue ?: boolean
}>(), {
  customStyle: '',
  customClass: '',
  customArrow: '',
  customPop: '',
  visibleArrow: true,
  placement: 'bottom',
  offset: 0,
  useContentSlot: false,
  disabled: false,
  showClose: false,
  modelValue: false,
})

/** 组件事件 */
const emit = defineEmits([
  'update:modelValue',
  'menuclick',
  'change',
  'open',
  'close',
])

/** 响应式数据 */
const showTooltip = ref(false)

/** 获取组件实例 */
const instance = getCurrentInstance()!
const selector = 'tooltip'
const popover = usePopover(props.visibleArrow)

/**
 * 监听内容变化
 */
watch(
  () : string | UTSJSONObject[] | null => props.content,
  (newVal : string | UTSJSONObject[] | null) => {
    if (newVal === null || newVal === undefined) {
      console.error('[wot-design] 警告(wd-tooltip): content 不能为 null 或 undefined')
    }
  },
)

/**
 * 监听位置变化
 */
watch(
  () : string => props.placement,
  () => {
    popover.init(props.placement, props.visibleArrow, selector, instance)
  },
)

/**
 * 监听modelValue变化
 */
watch(
  () : boolean => props.modelValue,
  (newValue : boolean) => {
    showTooltip.value = newValue
  },
)

/**
 * 监听内部显示状态变化
 */
watch(
  () : boolean => showTooltip.value,
  (newValue : boolean) => {
    if (newValue) {
      popover.control(props.placement, props.offset)
      closeOther(instance)
    }
    popover.showStyle.value = newValue ? 'display: flex;' : 'display: none;'
    emit('change', { show: newValue })
    newValue ? emit('open') : emit('close')
  },
)

/**
 * 组件挂载后初始化
 */
onMounted(() => {
  popover.init(props.placement, props.visibleArrow, selector, instance)
})

/**
 * 组件挂载前的处理
 */
onBeforeMount(() => {
  pushToQueue(instance)
  popover.showStyle.value = props.modelValue ? 'opacity: 1;' : 'opacity: 0;'
})

/**
 * 组件卸载前的清理
 */
onBeforeUnmount(() => {
  removeFromQueue(instance)
})

/**
 * 更新modelValue值
 */
const updateModelValue = (value : boolean) => {
  showTooltip.value = value
  emit('update:modelValue', value)
}

/**
 * 切换tooltip显示状态
 */
const toggle = () => {
  if (props.disabled) return
  updateModelValue(!showTooltip.value)
}

/**
 * 打开tooltip
 */
const open = () => {
  updateModelValue(true)
}

/**
 * 关闭tooltip
 */
const close = () => {
  updateModelValue(false)
}

/** 暴露组件方法 */
defineExpose({
  open,
  close,
})
</script>

<style lang="scss">
@import '../../common/abstracts/_mixin.scss';
@import '../../common/abstracts/variable.scss';

/* 暗色主题样式 */
.wot-theme-dark {
  .wd-tooltip__pos {
    background: $-dark-background4;
    color: $-tooltip-color;
  }

  @include triangleArrow($-tooltip-arrow-size, $-dark-background4);
}

/* Tooltip组件样式 */
@include b(tooltip) {
  position: relative;
  display: flex;

  @include e(pos) {
    position: absolute;
    min-width: 276rpx;
    min-height: 72rpx;
    font-size: $-tooltip-fs;
    backdrop-filter: blur($-tooltip-blur);
    background-clip: padding-box;
    border-radius: $-tooltip-radius;
    background: $-tooltip-bg;
    color: $-tooltip-color;
    text-align: center;
    box-sizing: border-box;
    z-index: $-tooltip-z-index;
  }

  @include e(hidden) {
    left: -100vw;
    bottom: -100vh;
    visibility: hidden;
  }

  @include e(container) {
    line-height: $-tooltip-line-height;
    font-size: $-tooltip-fs;
  }

  @include e(inner) {
    padding: $-tooltip-padding;
    white-space: nowrap;
    line-height: $-tooltip-line-height;
  }

  @include e(close-icon) {
    font-size: 24rpx;
    position: absolute;
    right: -16rpx;
    top: -20rpx;
    transform: scale(0.5);
    padding: 20rpx;
  }

  @include triangleArrow($-tooltip-arrow-size, $-tooltip-bg);
}
</style>
