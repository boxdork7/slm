/*
 * Calendar 工具函数
 * UniApp X 版本 - 从 wd-calendar-utils.ts 迁移
 *
 * 迁移说明:
 * 1. .ts → .uts
 * 2. dayjs → 使用原生 Date 对象
 * 3. useTranslate → 直接使用中文文本
 * 4. CalendarType 等类型定义移至此处(uts不支持export type)
 */

/**
 * 日历类型
 */
export type CalendarType = 'date' | 'dates' | 'datetime' | 'week' | 'month' | 'daterange' | 'datetimerange' | 'weekrange' | 'monthrange'

/**
 * 日历项类型
 */
export type CalendarDayType = '' | 'start' | 'middle' | 'end' | 'selected' | 'same' | 'current' | 'multiple-middle' | 'multiple-selected'

/**
 * 日历项数据结构
 */
export type CalendarDayItem = {
  date : number
  text ?: number | string
  topInfo ?: string
  bottomInfo ?: string
  type ?: CalendarDayType
  disabled ?: boolean
  isLastRow ?: boolean
}

/**
 * 日历项接口
 */
export type CalendarItem = {
  label : string
  value : number
  disabled : boolean
}

/**
 * 补零函数
 */
export function padZero(num : number) : string {
  return num < 10 ? `0${num}` : `${num}`
}

/**
 * 比较两个时间戳的日期是否相等
 */
export function compareDate(date1 : number, date2 : number | null) : number {
  if (date2 == null) return -1

  const dateValue1 = new Date(date1)
  const dateValue2 = new Date(date2)

  const year1 = dateValue1.getFullYear()
  const year2 = dateValue2.getFullYear()
  const month1 = dateValue1.getMonth()
  const month2 = dateValue2.getMonth()
  const day1 = dateValue1.getDate()
  const day2 = dateValue2.getDate()

  if (year1 === year2) {
    if (month1 === month2) {
      return day1 === day2 ? 0 : day1 > day2 ? 1 : -1
    }
    return month1 === month2 ? 0 : month1 > month2 ? 1 : -1
  }

  return year1 > year2 ? 1 : -1
}

/**
 * 判断日历类型是否为范围选择模式
 */
export function isRange(type : CalendarType) : boolean {
  return type.includes('range')
}

/**
 * 比较两个时间戳的月份是否相等
 */
export function compareMonth(date1 : number, date2 : number) : number {
  const dateValue1 = new Date(date1)
  const dateValue2 = new Date(date2)

  const year1 = dateValue1.getFullYear()
  const year2 = dateValue2.getFullYear()
  const month1 = dateValue1.getMonth()
  const month2 = dateValue2.getMonth()

  if (year1 === year2) {
    return month1 === month2 ? 0 : month1 > month2 ? 1 : -1
  }

  return year1 > year2 ? 1 : -1
}

/**
 * 比较两个时间戳的年份是否一致
 */
export function compareYear(date1 : number, date2 : number) : number {
  const dateValue1 = new Date(date1)
  const dateValue2 = new Date(date2)

  const year1 = dateValue1.getFullYear()
  const year2 = dateValue2.getFullYear()

  return year1 === year2 ? 0 : year1 > year2 ? 1 : -1
}

/**
 * 获取指定年月的最后一天的日期
 */
export function getMonthEndDay(year : number, month : number) : number {
  return 32 - new Date(year, month - 1, 32).getDate()
}

/**
 * 格式化时间戳为年月标题
 */
export function formatMonthTitle(date : number) : string {
  const d = new Date(date)
  const year = d.getFullYear()
  const month = d.getMonth() + 1
  return `${year}年${month}月`
}

/**
 * 根据索引获取对应的星期标签
 */
export function getWeekLabel(index : number) : string {
  const weeks = ['日', '一', '二', '三', '四', '五', '六']
  let i = index
  if (i >= 7) {
    i = i % 7
  }
  return weeks[i]
}

/**
 * 格式化时间戳为年份标题
 */
export function formatYearTitle(date : number) : string {
  const d = new Date(date)
  return `${d.getFullYear()}年`
}

/**
 * 根据最小日期和最大日期获取这之间的所有月份时间戳数组
 */
export function getMonths(minDate : number, maxDate : number) : number[] {
  const months : number[] = []
  const month = new Date(minDate)
  month.setDate(1)

  while (compareMonth(month.getTime(), maxDate) < 1) {
    months.push(month.getTime())
    month.setMonth(month.getMonth() + 1)
  }

  return months
}

/**
 * 根据最小日期和最大日期获取这之间的所有年份时间戳数组
 */
export function getYears(minDate : number, maxDate : number) : number[] {
  const years : number[] = []
  const year = new Date(minDate)
  year.setMonth(0)
  year.setDate(1)

  while (compareYear(year.getTime(), maxDate) < 1) {
    years.push(year.getTime())
    year.setFullYear(year.getFullYear() + 1)
  }

  return years
}

/**
 * 获取指定日期所在周的第一天和最后一天时间戳
 */
export function getWeekRange(date : number, firstDayOfWeek : number) : number[] {
  let firstDay = firstDayOfWeek
  if (firstDay >= 7) {
    firstDay = firstDay % 7
  }

  const dateValue = new Date(date)
  dateValue.setHours(0, 0, 0, 0)
  const year = dateValue.getFullYear()
  const month = dateValue.getMonth()
  const day = dateValue.getDate()
  const week = dateValue.getDay()

  const weekStart = new Date(year, month, day - ((7 + week - firstDay) % 7))
  const weekEnd = new Date(year, month, day + 6 - ((7 + week - firstDay) % 7))

  return [weekStart.getTime(), weekEnd.getTime()]
}

/**
 * 计算两个日期之间的天数差
 */
export function getDayOffset(date1 : number, date2 : number) : number {
  return (date1 - date2) / (24 * 60 * 60 * 1000) + 1
}

/**
 * 根据基准日期和偏移天数获取目标日期时间戳
 */
export function getDayByOffset(date : number, offset : number) : number {
  const dateValue = new Date(date)
  dateValue.setDate(dateValue.getDate() + offset)
  return dateValue.getTime()
}

/**
 * 获取前一天的时间戳
 */
export function getPrevDay(date : number) : number {
  return getDayByOffset(date, -1)
}

/**
 * 获取后一天的时间戳
 */
export function getNextDay(date : number) : number {
  return getDayByOffset(date, 1)
}

/**
 * 计算两个日期之间的月份差
 */
export function getMonthOffset(date1 : number, date2 : number) : number {
  const dateValue1 = new Date(date1)
  const dateValue2 = new Date(date2)

  const year1 = dateValue1.getFullYear()
  const year2 = dateValue2.getFullYear()
  let month1 = dateValue1.getMonth()
  const month2 = dateValue2.getMonth()

  month1 = (year1 - year2) * 12 + month1

  return month1 - month2 + 1
}

/**
 * 根据基准日期和偏移月数获取目标日期时间戳
 */
export function getMonthByOffset(date : number, offset : number) : number {
  const dateValue = new Date(date)
  dateValue.setMonth(dateValue.getMonth() + offset)
  return dateValue.getTime()
}

/**
 * 获取默认时间配置,将字符串或数组格式化为统一的二维数组格式
 */
export function getDefaultTime(defaultTime : string | string[] | null) : number[][] {
  if (Array.isArray(defaultTime)) {
    const startTime = (defaultTime[0] != null ? defaultTime[0] : '00:00:00').split(':').map((item : string) : number => {
      return parseInt(item)
    })
    const endTime = (defaultTime[1] != null ? defaultTime[1] : '00:00:00').split(':').map((item : string) : number => {
      return parseInt(item)
    })
    return [startTime, endTime]
  } else {
    const time = (defaultTime != null ? defaultTime : '00:00:00').split(':').map((item : string) : number => {
      return parseInt(item)
    })
    return [time, time]
  }
}

/**
 * 根据日期和默认时间配置获取完整的日期时间戳
 */
export function getDateByDefaultTime(date : number, defaultTime : number[]) : number {
  const dateValue = new Date(date)
  dateValue.setHours(defaultTime[0])
  dateValue.setMinutes(defaultTime[1])
  dateValue.setSeconds(defaultTime[2])
  return dateValue.getTime()
}

/**
 * 获取指定日期是当年的第几周
 */
export function getWeekNumber(date : number) : number {
  const d = new Date(date)
  d.setHours(0, 0, 0, 0)
  d.setDate(d.getDate() + 3 - ((d.getDay() + 6) % 7))
  const week = new Date(d.getFullYear(), 0, 4)
  return 1 + Math.round(((d.getTime() - week.getTime()) / 86400000 - 3 + ((week.getDay() + 6) % 7)) / 7)
}

/**
 * 根据月份类型、选中值和日历类型生成日历项的CSS类名
 */
export function getItemClass(
  monthType : CalendarDayType,
  value : number | null | (number | null)[],
  type : CalendarType
) : string {
  const classList = ['is-' + monthType]

  if (type.includes('range') && Array.isArray(value)) {
    if (value == null || value[1] == null) {
      classList.push('is-without-end')
    }
  }

  return classList.join(' ')
}
