import App from './App.uvue'
import { createSSRApp } from 'vue'

export function createApp() {
	const app = createSSRApp(App)

	/*
	 * 状态管理：UniApp X 使用模块级 reactive 模式（非 Pinia）
	 * 各 store 模块通过 import { useXxxStore } from '@/stores/store' 使用
	 */

	/*
	 * UniApp X 使用 easycom 自动注册组件（pages.json 已配置）
	 * 无需 import.meta.glob 手动注册 WD UI 组件
	 */

	return {
		app,
	}
}
