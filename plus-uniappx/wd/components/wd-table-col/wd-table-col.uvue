<!--
Table 表格每一列

UniApp X 版本改动点:
1. 移除 defineOptions
2. 移除手动组件导入(easycom 自动注册)
3. AlignType/SortDirection 类型从 wd-table-key.uts 导入
4. useParent → inject + genChildUid 模式
5. CSSProperties → Map<string, any> 然后用 objToStyle
6. ComponentPublicInstance 移除(UTS 不支持)
7. 计算属性返回类型需要显式标注
8. watch 的回调参数需要显式类型标注
9. onMounted 时注册到父组件,提供完整的 childInfo
10. sortDirection 通过父组件的 childrenMap 管理
-->
<template>
  <view
    :class="`wd-table-col ${fixed ? 'wd-table-col--fixed' : ''} ${isLastFixed && isDef(table) && table.state.scrollLeft > 0 ? 'is-shadow' : ''} ${customClass}`"
    :style="`${columnStyle}${customStyle}`"
  >
    <view
      v-for="(row, index) in column"
      :key="index"
      :class="`wd-table__cell ${stripe && isOdd(index) ? 'is-stripe' : ''} ${border ? 'is-border' : ''} is-${align}`"
      :style="cellStyle"
      @click="handleRowClick(index)"
    >
      <slot v-if="$slots.value" name="value" :row="getScope(index)" :index="index" />
      <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
        {{ row }}
      </text>
    </view>
  </view>
</template>

<script lang="uts" setup>
import { computed, inject, ref, onMounted, onUnmounted } from 'vue'
import { addUnit, isDef, isOdd, objToStyle } from '../common/util'
import { genChildUid } from '../../composables/useChildren'
import { TABLE_KEY, type TableProvide, type AlignType, type SortDirection, type TableColChild } from '../wd-table/wd-table-key'

/**
 * 表格列组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 列对应字段 */
  prop : string
  /** 列对应字段标题 */
  label : string
  /** 列宽度,单位px */
  width ?: string | number
  /** 是否开启列排序 */
  sortable ?: boolean
  /** 是否固定本列 */
  fixed ?: boolean
  /** 列的对齐方式,可选值left,center,right */
  align ?: string
}>(), {
  customStyle: '',
  customClass: '',
  width: 200,
  sortable: false,
  fixed: false,
  align: 'left',
})

/** 获取父组件(Table)实例 */
const table = inject<TableProvide | null>(TABLE_KEY, null)

/** 当前组件的唯一 ID */
const myUid = ref<number>(0)

/** 当前组件在父组件中的索引 */
const index = computed(() : number => {
  if (table == null) return -1
  const idx = table.childUids.indexOf(myUid.value)
  return idx
})

/** 排序方向状态(初始值) */
const sortDirection = ref<number>(0)

/**
 * 是否开启斑马纹
 */
const stripe = computed(() : boolean => {
  return table != null ? table.props.stripe : false
})

/**
 * 是否有边框
 */
const border = computed(() : boolean => {
  return table != null ? table.props.border : false
})

/**
 * 是否超出省略
 */
const ellipsis = computed(() : boolean => {
  return table != null ? table.props.ellipsis : false
})

/**
 * 是否最后一个固定元素
 */
const isLastFixed = computed(() : boolean => {
  let isLastFixed = false
  if (props.fixed && isDef(table) && table != null) {
    isLastFixed = table.getIsLastFixed({ fixed: props.fixed, prop: props.prop })
  }
  return isLastFixed
})

/**
 * 列样式
 */
const columnStyle = computed(() : string => {
  let style = new Map<string, any>()
  if (isDef(props.width)) {
    style.set('width', addUnit(props.width as string | number))
  }
  if (props.fixed && isDef(table) && table != null) {
    style = table.getFixedStyle(index.value, style)
  }
  return objToStyle(style)
})

/**
 * 单元格样式
 */
const cellStyle = computed(() : string => {
  let style = new Map<string, any>()
  const rowHeight = table != null ? table.props.rowHeight : 100
  if (isDef(rowHeight)) {
    style.set('height', addUnit(rowHeight as string | number))
  }
  if (props.fixed && isDef(table) && table != null) {
    style = table.getFixedStyle(index.value, style)
  }
  return objToStyle(style)
})

/**
 * 列数据
 */
const column = computed(() : any[] => {
  if (table == null || table.props.data == null || !Array.isArray(table.props.data)) {
    return []
  }

  return table.props.data.map((item : any) : any => item[props.prop])
})

/**
 * 处理行点击事件
 * @param index 行下标
 */
const handleRowClick = (index : number) => {
  if (table == null) {
    return
  }
  table.rowClick(index)
}

/**
 * 获取行数据
 * @param index 行索引
 */
const getScope = (index : number) : any => {
  if (table == null || table.props.data == null || !Array.isArray(table.props.data)) {
    return {}
  }
  return table.props.data[index] ?? {}
}

/**
 * 组件挂载时注册到父组件
 */
onMounted(() => {
  myUid.value = genChildUid()
  if (table != null) {
    const childInfo : TableColChild = {
      prop: props.prop,
      label: props.label,
      width: props.width as string | number,
      sortable: props.sortable ?? false,
      fixed: props.fixed ?? false,
      align: props.align ?? 'left',
      sortDirection: sortDirection.value,
      uid: myUid.value,
    }
    table.addChild(myUid.value, childInfo)
  }
})

/**
 * 组件卸载时从父组件注销
 */
onUnmounted(() => {
  if (table != null) {
    table.removeChild(myUid.value)
  }
})
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(table-col) {
    @include when(shadow) {
      &::after {
        background: linear-gradient(270deg, rgba(17, 17, 17, 0.2) 0%, rgba(0, 0, 0, 0) 100%);
      }
    }
  }
}

/* 表格列样式 */
@include b(table-col) {
  .wd-table__cell {
    width: 100%;
    @include when(stripe) {
      background: $-table-stripe-bg;
    }
  }

  @include m(fixed) {
    position: sticky;
    z-index: 1;
    left: 0;
  }

  @include when(shadow) {
    &::after {
      content: ' ';
      position: absolute;
      height: 100%;
      right: -30rpx;
      top: 0;
      width: 30rpx;
      height: 100%;
      background: linear-gradient(270deg, rgba(255, 255, 255, 0) 0%, rgba(0, 0, 0, 0.04) 100%);
    }
  }

  .wd-table__cell:last-child {
    @include when(border) {
      border-bottom: none;
    }
  }
}
</style>
