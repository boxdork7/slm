# 应用id (每个项目唯一,避免不同项目键产生冲突)
VITE_APP_ID = 'ryplus_uni'

VITE_APP_TITLE = 'ryplus-uni'

VITE_UNI_APPID = 'UNI__6E229FA'
# 微信小程序appid
VITE_WECHAT_MINI_APP_ID = 'wxd44a6eaefd42428c'
# 微信公众号appid
VITE_WECHAT_OFFICIAL_APP_ID = 'wx08728cf8ec97725f'
# 支付宝小程序appid
VITE_ALIPAY_MINI_APP_ID = 'your_alipay_app_id'
# 字节跳动小程序appid
VITE_BYTEDANCE_MINI_APP_ID = 'your_bytedance_app_id'
# 百度小程序appid
VITE_BAIDU_MINI_APP_ID = 'your_baidu_app_id'
# QQ小程序appid
VITE_QQ_MINI_APP_ID = 'your_qq_app_id'

# h5部署网站的base，配置到 manifest.config.ts 里的 h5.router.base 如/demo/ 注意前后都需加斜杠
VITE_APP_PUBLIC_PATH = '/'

# ===== 安全配置 =====
# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_API_ENCRYPT = 'true'

# 下方 RSA / SM2 密钥均为框架默认值 生产必须更换 且三端与后端必须成对更换
# 生成方式：运行后端单元测试 ApiEncryptKeyGeneratorTest（generateRsaKeys / generateSm2Keys），复制控制台第 ③ 段到这里

# 接口加密算法 必须与后端 api-decrypt.algorithm 一致
# RSA: RSA+AES(默认)  SM2: SM2+SM4(国密，信创/密评项目使用)
# 切换为 SM2：后端 api-decrypt.algorithm（docker 为 compose 的 API_ENCRYPT_ALGORITHM）与 plus-ui / plus-uniapp / plus-app
# 三端必须一起改为 SM2，任一处不一致都会导致登录失败；默认 SM2 密钥已与后端默认值配对，开发环境只改开关即可
# 注意：小程序 / APP 没有同步的安全随机数接口，SM2 方案在这两端退化为 Math.random 生成随机数（与 RSA 方案的 jsencrypt 相同），
# 对随机数强度有硬性要求的项目请确保全链路 HTTPS
VITE_APP_API_ENCRYPT_ALGORITHM = 'RSA'

# 接口加密传输 RSA 公钥与后端解密私钥对应 如更换需前后端一同更换
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAK9s1Pbnn5W+l1hx3ukHLtevayF5nOFIb140zvIPksw8h7bZWY05zyWdsQ2I51ypiC53KnyfhibPk3AJ2yr+qnkCAwEAAQ=='

# 接口响应解密 RSA 私钥与后端加密公钥对应 如更换需前后端一同更换
VITE_APP_RSA_PRIVATE_KEY = ''

# 接口加密传输 SM2 公钥(Hex 04 开头) 与后端 api-decrypt.sm2.private-key 对应 如更换需前后端一同更换
VITE_APP_SM2_PUBLIC_KEY = '04b545121b1aed3c7c59b25f8da50b1af7080cc0a7438fa095f8ce95ea61afd6b75170ac82241894f604cb4e1b3c3dbb09125c17497805ce0b5c54381baeea5897'

# 接口响应解密 SM2 私钥(Hex) 与后端 api-decrypt.sm2.public-key 对应 如更换需前后端一同更换
VITE_APP_SM2_PRIVATE_KEY = '261af8bdfd10e14b8d87b04bc4e42c6fc44e3c41380cf4346b4bfa87afa74e92'

# ===== 功能开关 =====
# websocket 开关
VITE_APP_WEBSOCKET = 'false'
