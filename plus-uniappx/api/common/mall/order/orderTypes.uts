/** 支付方式常量 */
export const PAYMENT_WECHAT = 'wechat'
export const PAYMENT_ALIPAY = 'alipay'
export const PAYMENT_BALANCE = 'balance'

/** 支付状态常量 */
export const PAYMENT_STATUS_IDLE = 'idle'
export const PAYMENT_STATUS_LOADING = 'loading'
export const PAYMENT_STATUS_SUCCESS = 'success'
export const PAYMENT_STATUS_FAILED = 'failed'
export const PAYMENT_STATUS_CANCELLED = 'cancelled'

/** 交易类型常量 */
export const TRADE_TYPE_JSAPI = 'JSAPI'
export const TRADE_TYPE_NATIVE = 'NATIVE'
export const TRADE_TYPE_APP = 'APP'
export const TRADE_TYPE_H5 = 'H5'
export const TRADE_TYPE_WAP = 'WAP'
export const TRADE_TYPE_PAGE = 'PAGE'

/** 订单查询类型 */
export type OrderQuery = {
	/** 订单ID */
	id?: string | number

	/** 订单编号 */
	orderNo?: string

	/** 用户ID */
	userId?: string | number

	/** 商品ID */
	goodsId?: string | number

	/** 商品名称 */
	goodsName?: string

	/** 商品图片 */
	goodsImg?: string

	/** 商品价格 */
	price?: string

	/** 购买数量 */
	quantity?: number

	/** 订单总金额 */
	totalAmount?: string

	/** 实付金额 */
	actualAmount?: string

	/** 订单状态 */
	orderStatus?: string

	/** 支付方式 */
	paymentMethod?: string

	/** 支付时间 */
	paymentTime?: string

	/** 交易流水号 */
	transactionId?: string | number

	/** 买家备注 */
	buyerRemark?: string

	/** 订单扩展信息 */
	orderExtInfo?: string

	/** 收货信息 */
	receiverInfo?: string

	/** 物流信息 */
	shippingInfo?: string

	/** 创建时间 */
	createTime?: string

	/** 分页：当前页码 */
	pageNum?: number

	/** 分页：每页数量 */
	pageSize?: number

	/** 分页：排序列 */
	orderByColumn?: string

	/** 分页：是否升序 */
	isAsc?: string
}

