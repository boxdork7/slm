<script lang="uts">
	/* #ifdef APP-ANDROID || APP-HARMONY */
	let firstBackTime = 0
	/* #endif */

	export default {
		onLaunch() {
			console.log('App Launch')
			/* TODO: 阶段 3 迁移后启用
			 * await featureStore.initFeatures()
			 * await initializeApp()
			 * checkAppUpdate()
			 */
		},
		onShow() {
			console.log('App Show')
			/* TODO: 阶段 3 迁移后启用 WebSocket 重连 */
		},
		onHide() {
			console.log('App Hide')
		},
		onError(error : string) {
			console.error('App Error:', error)
		},
		/* #ifdef APP-ANDROID || APP-HARMONY */
		onLastPageBackPress() {
			if (firstBackTime == 0) {
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				firstBackTime = Date.now()
				setTimeout(() => {
					firstBackTime = 0
				}, 2000)
			} else if (Date.now() - firstBackTime < 2000) {
				firstBackTime = Date.now()
				uni.exit()
			}
		},
		/* #endif */
		onExit() {
			console.log('App Exit')
		},
	}
</script>

