<!--
Badge 徽标 出现在按钮、图标旁的数字或状态标记。

UniApp X 版本
- 移除 export type BadgeType（UTS 不支持 script setup 内 export type）
- 移除 export interface（同上）
- 字符串字面量联合类型改为 string
-->
<template>
  <view :class="`wd-badge ${customClass}`" :style="customStyle">
    <slot />
    <view
      v-if="shouldShowBadge"
      :class="`wd-badge__content is-fixed ${type != '' ? `wd-badge__content--${type}` : ''} ${isDot ? 'is-dot' : ''}`"
      :style="`${bgColor != '' ? `background-color: ${bgColor};` : ''} ${top != '' ? `top: ${addUnit(top)};` : ''} ${right != '' ? `right: ${addUnit(right)};` : ''}`"
    >
      {{ content }}
    </view>
  </view>
</template>

<script lang="uts" setup>
import { computed } from 'vue'
import { addUnit, isNumber } from '../common/util'

/**
 * 徽章组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 显示值 */
  modelValue ?: string | number
  /** 当数值为 0 时，是否展示徽标 */
  showZero ?: boolean
  /** 背景颜色 */
  bgColor ?: string
  /** 最大值，超过最大值会显示 '{max}+'，要求 value 是 Number 类型 */
  max ?: number
  /** 是否为红色点状标注 */
  isDot ?: boolean
  /** 是否隐藏 badge */
  hidden ?: boolean
  /** badge类型，可选值：primary / success / warning / danger / info */
  type ?: string
  /** 为正时，角标向下偏移对应的像素 */
  top ?: string | number
  /** 为正时，角标向左偏移对应的像素 */
  right ?: string | number
}>(), {
  customStyle: '',
  customClass: '',
  modelValue: '',
  showZero: false,
  bgColor: '',
  isDot: false,
  hidden: false,
  type: '',
  top: '',
  right: '',
})

/**
 * 计算显示的内容
 */
const content = computed(() : string | number => {
  const modelValue = props.modelValue
  const max = props.max
  const isDot = props.isDot

  if (isDot) return ''

  if (max != null && isNumber(modelValue) && isNumber(max)) {
    const numVal = Number(modelValue)
    const numMax = Number(max)
    if (!Number.isNaN(numVal) && !Number.isNaN(numMax)) {
      return numMax < numVal ? `${numMax}+` : modelValue
    }
  }

  return modelValue
})

/**
 * 计算是否应该显示徽章
 */
const shouldShowBadge = computed(() : boolean => {
  if (props.hidden) return false
  if (props.isDot) return true
  if (content.value === 0 && props.showZero) return true
  if (content.value != null && content.value !== '' && content.value !== 0) return true
  return false
})
</script>

<style lang="scss">
@import './../common/abstracts/_mixin.scss';
@import './../common/abstracts/variable.scss';

.wot-theme-dark {
  @include b(badge) {
    @include e(content) {
      border-color: $-dark-background2;
    }
  }
}

@include b(badge) {
  position: relative;
  vertical-align: middle;
  /* UniApp X: inline-block 不支持，使用 align-self: flex-start 模拟 inline 收缩 */
  align-self: flex-start;

  @include e(content) {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: content-box;
    height: $-badge-height;
    line-height: $-badge-height;
    padding: $-badge-padding;
    background-color: $-badge-bg;
    border-radius: calc($-badge-height / 2 + 4rpx);
    color: $-badge-color;
    font-size: $-badge-fs;
    text-align: center;
    white-space: nowrap;
    border: $-badge-border;
    font-weight: 500;

    @include when(fixed) {
      position: absolute;
      top: 0;
      right: 0;
      transform: translateY(-50%) translateX(50%);
    }

    @include when(dot) {
      height: $-badge-dot-size;
      width: $-badge-dot-size;
      padding: 0;
      border-radius: 50%;
    }

    @each $type in (primary, success, warning, info, danger) {
      @include m($type) {
        @if $type == primary {
          background-color: $-badge-primary;
        } @else if $type == success {
          background-color: $-badge-success;
        } @else if $type == warning {
          background-color: $-badge-warning;
        } @else if $type == info {
          background-color: $-badge-info;
        } @else {
          background-color: $-badge-danger;
        }
      }
    }
  }
}
</style>
