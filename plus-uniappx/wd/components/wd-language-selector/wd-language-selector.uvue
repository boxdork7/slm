<!-- Language Selector 语言选择器 提供语言切换功能的弹出选择器。 -->
<template>
  <wd-action-sheet
    v-model="visible"
    title="选择语言"
    :actions="languageActions"
    @select="handleLanguageSelect"
    @cancel="handleCancel"
  />
</template>

<script lang="uts" setup>
import { computed } from 'vue'

/**
 * 语言选项接口
 */
interface LanguageOption {
  value: string
  label: string
  name: string
}

/**
 * Action选项接口
 */
interface ActionItem {
  label: string
  value: string
  color: string
}

/**
 * 语言选择器组件属性接口
 */
interface WdLanguageSelectorProps {
  /** 自定义根节点样式 */
  customStyle?: string
  /** 自定义根节点样式类 */
  customClass?: string
  /** 控制显示隐藏 */
  modelValue: boolean
  /** 自定义语言选项，如果不提供则使用默认配置 */
  languageOptions?: LanguageOption[]
  /** 当前语言 */
  currentLanguage?: string
  /** 选中项颜色 */
  selectedColor?: string
  /** 默认项颜色 */
  defaultColor?: string
}

/**
 * 语言选择器组件事件接口
 */
interface WdLanguageSelectorEmits {
  /** 更新显示状态 */
  'update:modelValue': [value: boolean]
  /** 语言切换事件 */
  change: [language: string]
  /** 取消选择事件 */
  cancel: []
}

// 使用 withDefaults 定义组件属性和默认值
const props = withDefaults(defineProps<WdLanguageSelectorProps>(), {
  customStyle: '',
  customClass: '',
  modelValue: false,
  currentLanguage: 'zh-CN',
  selectedColor: '#4F86FD',
  defaultColor: '#333333',
})

// 定义组件事件
const emit = defineEmits<WdLanguageSelectorEmits>()

// 控制显示隐藏
const visible = computed<boolean>({
  get: (): boolean => props.modelValue,
  set: (value: boolean) => emit('update:modelValue', value),
})

// 默认语言选项
const defaultLanguageOptions: LanguageOption[] = [
  { value: 'zh-CN', label: '简体中文', name: 'Chinese Simplified' },
  { value: 'zh-TW', label: '繁體中文', name: 'Chinese Traditional' },
  { value: 'en-US', label: 'English', name: 'English' },
]

// 语言选项 - 优先使用传入的选项，否则使用默认配置
const finalLanguageOptions = computed<LanguageOption[]>(() => {
  return props.languageOptions || defaultLanguageOptions
})

// 转换为 ActionSheet 的 actions 格式
const languageActions = computed<ActionItem[]>(() => {
  return finalLanguageOptions.value.map((option: LanguageOption): ActionItem => {
    return {
      label: option.label,
      value: option.value,
      // 当前选中的语言显示不同颜色
      color: props.currentLanguage === option.value ? props.selectedColor : props.defaultColor,
    }
  })
})

// 处理语言选择
const handleLanguageSelect = (data: any) => {
  const selectedLang = data.value as string

  if (selectedLang === props.currentLanguage) {
    visible.value = false
    return
  }

  emit('change', selectedLang)
  visible.value = false
}

// 处理取消
const handleCancel = () => {
  visible.value = false
  emit('cancel')
}
</script>

<style lang="scss">
// 引入外部样式文件
@import './../common/abstracts/_mixin.scss';
@import './../common/abstracts/variable.scss';

// 暗色主题样式
.wot-theme-dark {
  // 如果需要特殊的暗色主题样式，可以在这里添加
}

// 语言选择器样式
@include b(language-selector) {
  // 基础样式继承自 action-sheet，通常不需要额外样式
  // 如果需要自定义样式可以在这里添加
}
</style>
