<!--
Loading 加载指示器 加载动画，用于表示加载中的过渡状态。

UniApp X 版本
- background-image url() 不支持 data URI，改用 <image :src /> 方式
- 移除 defineOptions
- 移除 export type/interface
- context.id++ 用于唯一 SVG ID
-->
<template>
  <view
    :class="`wd-loading ${customClass}`"
    :style="`${iconSize != '' ? `height: ${iconSize}; width: ${iconSize};` : ''}${customStyle}`"
  >
    <view class="wd-loading__body">
      <image
        class="wd-loading__svg"
        :src="svgSrc"
        mode="aspectFit"
      />
    </view>
  </view>
</template>

<script lang="uts" setup>
import { onBeforeMount, ref, watch } from 'vue'
import { encode } from '../common/base64'
import { addUnit, context, gradient, isDef } from '../common/util'

/**
 * 加载组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 加载指示器类型：outline / ring */
  type ?: string
  /** 设置加载指示器颜色 */
  color ?: string
  /** 设置加载指示器大小 */
  size ?: number | string
}>(), {
  customStyle: '',
  customClass: '',
  type: 'ring',
  color: '#4D80F0',
  size: '45',
})

/** 唯一 SVG ID */
const svgDefineId = context.id; context.id = context.id + 1
const svgDefineId1 = context.id; context.id = context.id + 1
const svgDefineId2 = context.id; context.id = context.id + 1

/** SVG data URI */
const svgSrc = ref<string>('')
const intermediateColor = ref<string>('')
const iconSize = ref<string>('')

/**
 * 生成 outline 类型 SVG
 */
const outlineSvg = (color : string) : string => {
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 42 42"><defs><linearGradient x1="100%" y1="0%" x2="0%" y2="0%" id="${svgDefineId}"><stop stop-color="#FFF" offset="0%" stop-opacity="0"/><stop stop-color="#FFF" offset="100%"/></linearGradient></defs><g fill="none" fill-rule="evenodd"><path d="M21 1c11.046 0 20 8.954 20 20s-8.954 20-20 20S1 32.046 1 21 9.954 1 21 1zm0 7C13.82 8 8 13.82 8 21s5.82 13 13 13 13-5.82 13-13S28.18 8 21 8z" fill="${color}"/><path d="M4.599 21c0 9.044 7.332 16.376 16.376 16.376 9.045 0 16.376-7.332 16.376-16.376" stroke="url(#${svgDefineId}) " stroke-width="3.5" stroke-linecap="round"/></g></svg>`
}

/**
 * 生成 ring 类型 SVG
 */
const ringSvg = (color : string, midColor : string) : string => {
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><linearGradient id="${svgDefineId1}" gradientUnits="userSpaceOnUse" x1="50" x2="50" y2="180"><stop offset="0" stop-color="${color}"></stop> <stop offset="1" stop-color="${midColor}"></stop></linearGradient> <path fill="url(#${svgDefineId1})" d="M20 100c0-44.1 35.9-80 80-80V0C44.8 0 0 44.8 0 100s44.8 100 100 100v-20c-44.1 0-80-35.9-80-80z"></path> <linearGradient id="${svgDefineId2}" gradientUnits="userSpaceOnUse" x1="150" y1="20" x2="150" y2="180"><stop offset="0" stop-color="#fff" stop-opacity="0"></stop> <stop offset="1" stop-color="${midColor}"></stop></linearGradient> <path fill="url(#${svgDefineId2})" d="M100 0v20c44.1 0 80 35.9 80 80s-35.9 80-80 80v20c55.2 0 100-44.8 100-100S155.2 0 100 0z"></path> <circle cx="100" cy="10" r="10" fill="${color}"></circle></svg>`
}

/** 监听尺寸变化 */
watch(
  () => props.size,
  (newVal) => {
    iconSize.value = addUnit(newVal)
  },
  {
    deep: true,
    immediate: true,
  },
)

/** 构建 SVG data URI */
const buildSvg = () : void => {
  const ringType = isDef(props.type) ? props.type : 'ring'
  const color = props.color

  let svgContent : string
  if (ringType == 'ring') {
    svgContent = ringSvg(color, intermediateColor.value)
  } else {
    svgContent = outlineSvg(color)
  }

  svgSrc.value = `data:image/svg+xml;base64,${encode(svgContent)}`
}

/** 监听类型变化 */
watch(
  () => props.type,
  () => {
    buildSvg()
  },
  {
    deep: true,
    immediate: true,
  },
)

/** 组件挂载前计算中间渐变颜色并构建 SVG */
onBeforeMount(() => {
  intermediateColor.value = gradient(props.color, '#ffffff', 2)[1]
  buildSvg()
})
</script>

<style lang="scss">
@import '../common/abstracts/_mixin.scss';
@import '../common/abstracts/variable.scss';

@include b(loading) {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $-loading-size;
  height: $-loading-size;

  @include e(body) {
    width: 100%;
    height: 100%;
    animation: wd-rotate 0.8s linear infinite;
    animation-duration: 2s;
  }

  @include e(svg) {
    width: 100%;
    height: 100%;
  }
}

@keyframes wd-rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
</style>
