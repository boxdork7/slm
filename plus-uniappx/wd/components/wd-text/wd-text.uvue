<!--
Text 文本 用于展示文本信息，支持格式化（日期、手机号、价格等）、图标。

UniApp X 版本
- 移除 defineOptions
- 移除 export type/interface
- IconName 改为 string
- dayjs 从本地 common/dayjs 导入
- 联合类型 TextMode/TextType → string
- @for SCSS 循环保留
-->
<template>
  <view
    :class="rootClass"
    :style="`${color != '' ? `color: ${color};` : ''}${size != '' ? `font-size: ${size};` : ''}${customStyle}`"
    @click="handleClick"
  >
    <!-- 前缀图标 -->
    <wd-icon
      v-if="prefixIcon != ''"
      :name="prefixIcon"
      custom-class="wd-text__prefix-icon"
      :size="size"
      :color="color"
    />

    <!-- 文本内容 -->
    <text :class="`wd-text__body ${bold ? 'is-bold' : ''} ${lines > 0 ? `wd-text__lines--${lines}` : ''}`">
      {{ displayText }}
    </text>

    <!-- 后缀图标 -->
    <wd-icon
      v-if="suffixIcon != ''"
      :name="suffixIcon"
      custom-class="wd-text__suffix-icon"
      :size="size"
      :color="color"
    />
  </view>
</template>

<script lang="uts" setup>
import { computed } from 'vue'
import { dayjsFromString } from '../common/dayjs'

/**
 * 文本组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 文本内容 */
  text ?: string | number
  /** 文本类型，可选值：default / primary / success / warning / error */
  type ?: string
  /** 格式化模式，可选值：date / phone / price / name */
  mode ?: string
  /** 字体大小 */
  size ?: string
  /** 文本颜色 */
  color ?: string
  /** 是否加粗 */
  bold ?: boolean
  /** 文本行数（超出省略） */
  lines ?: number
  /** 日期格式化模式 */
  format ?: string
  /** 前缀图标名称 */
  prefixIcon ?: string
  /** 后缀图标名称 */
  suffixIcon ?: string
  /** 是否可点击 */
  clickable ?: boolean
  /** 价格小数位数 */
  decimals ?: number
  /** 手机号脱敏符号 */
  desensitize ?: string
  /** 姓名脱敏符号 */
  nameDesensitize ?: string
}>(), {
  customStyle: '',
  customClass: '',
  text: '',
  type: 'default',
  mode: '',
  size: '',
  color: '',
  bold: false,
  lines: 0,
  format: 'YYYY-MM-DD HH:mm:ss',
  prefixIcon: '',
  suffixIcon: '',
  clickable: false,
  decimals: 2,
  desensitize: '****',
  nameDesensitize: '*',
})

/** 组件事件 */
const emit = defineEmits(['click'])

/**
 * 根节点类名
 */
const rootClass = computed(() : string => {
  const classes : string[] = ['wd-text']
  if (props.type != '' && props.type != 'default') {
    classes.push(`wd-text--${props.type}`)
  }
  if (props.clickable) {
    classes.push('is-clickable')
  }
  if (props.customClass != '') {
    classes.push(props.customClass)
  }
  return classes.join(' ')
})

/**
 * 格式化日期
 * UTS 版本：dayjs 不支持参数构造，使用 dayjsFromString + Date 验证
 */
const formatDate = (value : string) : string => {
  if (value == '') return ''
  try {
    const testDate = new Date(value)
    if (isNaN(testDate.getTime())) return value
    const d = dayjsFromString(value)
    return d.format(props.format)
  } catch (_e) {
    return value
  }
}

/**
 * 格式化手机号（脱敏）
 */
const formatPhone = (value : string) : string => {
  if (value.length < 7) return value
  return value.substring(0, 3) + props.desensitize + value.substring(value.length - 4)
}

/**
 * 格式化价格
 */
const formatPrice = (value : string) : string => {
  const num = Number(value)
  if (Number.isNaN(num)) return value
  return num.toFixed(props.decimals)
}

/**
 * 格式化姓名（脱敏）
 */
const formatName = (value : string) : string => {
  if (value.length <= 1) return value
  return value.substring(0, 1) + props.nameDesensitize.repeat(value.length - 1)
}

/**
 * 显示文本（经过格式化处理）
 */
const displayText = computed(() : string => {
  const val = `${props.text}`
  if (val == '') return ''

  if (props.mode == 'date') return formatDate(val)
  if (props.mode == 'phone') return formatPhone(val)
  if (props.mode == 'price') return formatPrice(val)
  if (props.mode == 'name') return formatName(val)

  return val
})

/** 处理点击 */
const handleClick = () => {
  if (props.clickable) {
    emit('click')
  }
}
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

.wot-theme-dark {
  @include b(text) {
    color: $-dark-color;
  }
}

@include b(text) {
  /* UniApp X: inline-block 不支持，使用 flex-direction: row + align-self 模拟 inline 收缩 */
  flex-direction: row;
  align-self: flex-start;
  align-items: center;
  color: $-color-content;
  font-size: $-fs-content;
  line-height: 1.5;

  @include e(body) {
    @include when(bold) {
      font-weight: bold;
    }
  }

  /* 前缀图标 */
  @include e(prefix-icon) {
    margin-right: 8rpx;
  }

  /* 后缀图标 */
  @include e(suffix-icon) {
    margin-left: 8rpx;
  }

  /* 文本类型颜色 */
  @include m(primary) {
    color: $-text-primary-color;
  }

  @include m(success) {
    color: $-text-success-color;
  }

  @include m(warning) {
    color: $-text-warning-color;
  }

  @include m(error) {
    color: $-text-error-color;
  }

  /* 可点击 */
  @include when(clickable) {
    cursor: pointer;
  }

  /* 行数限制 */
  @for $i from 1 through 5 {
    .wd-text__lines--#{$i} {
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: #{$i};
      -webkit-box-orient: vertical;
    }
  }
}
</style>
