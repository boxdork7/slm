/**
 * APP 应用初始化状态管理 (UniApp X 版本)
 *
 * 从 plus-app/composables/useAppInit.ts 迁移的 UTS 版本
 *
 * 只处理 APP 环境的初始化逻辑：
 * - 检查用户token状态
 * - 获取用户信息
 * - 初始化WebSocket连接
 *
 * UTS 适配说明：
 * - Pinia useUserStore → 模块级 useUserStore
 * - undefined → null
 * - 可选链 ?. → 显式 null 检查
 */
import { ref } from 'vue'
import { webSocket } from './useWebSocket'
import { useUserStore } from '@/stores/modules/user'

/** 是否已完成初始化 */
const isInitialized = ref<boolean>(false)

/**
 * 初始化WebSocket连接
 */
const initializeWebSocket = () => {
	const wsInstance = webSocket.initialize(null, {
		onConnected: () => {
			/* WebSocket连接建立成功 */
		},
		onDisconnected: (_code : number, _reason : string) => {
			/* WebSocket连接断开 */
		},
		onError: (error : any) => {
			console.error('[应用初始化] WebSocket连接错误', error)
		},
		onMessage: (_data : any) => {
			/* 应用级别的消息处理 */
		},
	})

	if (wsInstance != null) {
		webSocket.connect()
	}
}

/**
 * 执行APP应用初始化
 *
 * 注意：APP环境下不需要等待 fetchUserInfo 完成，
 * 因为 HTTP 请求会调用 waitForInit()，如果使用 await 会造成死锁。
 * 正确做法是使用 .then() 异步处理用户信息获取。
 */
const initializeApp = () : Promise<void> => {
	if (isInitialized.value) {
		console.log('[应用初始化] APP环境已完成，跳过重复初始化')
		return Promise.resolve()
	}

	/* 立即标记为已初始化，防止并发调用 */
	isInitialized.value = true
	console.log('[应用初始化] APP环境开始初始化...')

	const userStore = useUserStore()

	/* 检查是否有token，有则异步获取用户信息 */
	if (userStore.token.value != null && (userStore.token.value as string).length > 0) {
		console.log('[应用初始化] APP检测到token，异步获取用户信息')
		userStore.fetchUserInfo().then(() => {
			console.log('[应用初始化] APP用户信息获取成功')
			initializeWebSocket()
		}).catch((err : any) => {
			console.warn('[应用初始化] APP获取用户信息失败:', err)
		})
	} else {
		console.log('[应用初始化] APP无token，跳过用户信息获取')
	}

	console.log('[应用初始化] APP环境初始化完成')
	return Promise.resolve()
}

/**
 * 等待应用初始化完成
 * APP 环境下初始化是同步完成的，此方法主要用于兼容 HTTP 请求中的调用
 */
const waitForInit = (_timeout : number = 10000) : Promise<void> => {
	if (isInitialized.value) return Promise.resolve()
	return initializeApp()
}

/**
 * useAppInit composable
 */
export const useAppInit = () => {
	return {
		initializeApp,
		waitForInit,
	}
}

/* 导出全局快捷方式 */
export { initializeApp, waitForInit }
