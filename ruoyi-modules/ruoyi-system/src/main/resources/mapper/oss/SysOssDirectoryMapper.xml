<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="plus.ruoyi.system.oss.mapper.SysOssDirectoryMapper">

    <!--
        按祖先ID匹配 ancestors 逗号串的三种位置：中间、末尾、开头。
        跨数据库注意：concat 一律嵌套成两参写法，不能写成 concat(a, b, c)。
        Oracle 的 concat 只接受 2 个参数，三参会抛 ORA-00909(参数个数无效)；
        两参写法在 MySQL / Oracle / PostgreSQL / SQL Server 上均可用。
    -->
    <select id="selectChildrenByAncestors" resultType="plus.ruoyi.system.oss.domain.SysOssDirectory">
        select *
        from sys_oss_directory
        where ancestors like concat(concat('%,', #{ancestorId}), ',%')
           or ancestors like concat('%,', #{ancestorId})
           or ancestors like concat(#{ancestorId}, ',%')
    </select>
</mapper>
