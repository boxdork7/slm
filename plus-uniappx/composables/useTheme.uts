/**
 * 主题配置管理组合函数 - UniApp X 版本
 *
 * 从 plus-app/composables/useTheme.ts 迁移的 UTS 版本
 *
 * 提供统一的主题配置管理，支持默认主题、全局覆盖和局部定制
 *
 * UTS 适配说明：
 * - ConfigProviderThemeVars → UTSJSONObject（主题变量本质是键值对）
 * - Partial<ConfigProviderThemeVars> → UTSJSONObject
 * - 对象展开运算符 {...obj} → mergeObjects 辅助函数
 * - import type 移除（直接使用 UTSJSONObject）
 */
import { ref, computed } from 'vue'

/**
 * 合并多个 UTSJSONObject 对象
 * 替代对象展开运算符 {...a, ...b, ...c}
 * 后面的对象属性会覆盖前面的
 */
const mergeObjects = (...sources : UTSJSONObject[]) : UTSJSONObject => {
	const result = {} as UTSJSONObject
	for (let i = 0; i < sources.length; i++) {
		const source = sources[i]
		const keys = Object.keys(source)
		for (let j = 0; j < keys.length; j++) {
			const key = keys[j]
			result[key] = source[key]
		}
	}
	return result
}

/**
 * 全局主题覆盖状态
 * 存储全局主题覆盖配置，所有组件实例共享
 */
const globalThemeOverrides = ref<UTSJSONObject>({} as UTSJSONObject)

/**
 * 默认主题配置
 * wot-design-uni 组件库的完整主题配置
 * 优先级：最低（会被全局覆盖和局部覆盖）
 */
const DEFAULT_THEME : UTSJSONObject = {
	/* ========== 基础色彩 ========== */
	/* 主题色调 */
	colorTheme: '#409EFF',
	/* 成功色调 */
	colorSuccess: '#52C41A',
	/* 警告色调 */
	colorWarning: '#FFBA00',
	/* 危险色调 */
	colorDanger: '#F56C6C',

	/* ========== Loading 组件 ========== */
	/* Loading 大小 */
	loadingSize: '40rpx',

	/* ========== MessageBox 组件 ========== */
	/* MessageBox 标题颜色 */
	messageBoxTitleColor: '#333333',
	/* MessageBox 内容颜色 */
	messageBoxContentColor: '#666666',

	/* ========== Notify 组件 ========== */
	/* Notify 内边距 */
	notifyPadding: '24rpx 32rpx',
	/* Notify 字体大小 */
	notifyFontSize: '28rpx',

	/* ========== 导航栏 ========== */
	/* 导航栏标题字体大小 */
	navbarTitleFontSize: '32rpx',
	/* 导航栏标题字体粗细 */
	navbarTitleFontWeight: 'normal',
} as UTSJSONObject

/**
 * 主题配置管理 Hook
 * @param localOverrides 局部主题覆盖配置，优先级最高
 * @returns 主题配置对象和相关操作方法
 *
 * @example
 * ```uts
 * // 基础使用
 * const { themeVars } = useTheme()
 *
 * // 局部定制
 * const overrides = { buttonPrimaryBgColor: '#ff4757' } as UTSJSONObject
 * const { themeVars } = useTheme(overrides)
 *
 * // 全局主题管理
 * const { setGlobalTheme, resetGlobalTheme } = useTheme()
 * const darkTheme = { colorTheme: '#333333' } as UTSJSONObject
 * setGlobalTheme(darkTheme)
 * ```
 */
export const useTheme = (localOverrides ?: UTSJSONObject) => {
	/**
	 * 响应式主题配置
	 * 按优先级合并配置：默认主题 < 全局覆盖 < 局部覆盖
	 */
	const themeVars = computed(() : UTSJSONObject => {
		if (localOverrides != null) {
			return mergeObjects(DEFAULT_THEME, globalThemeOverrides.value, localOverrides!)
		}
		return mergeObjects(DEFAULT_THEME, globalThemeOverrides.value)
	})

	/**
	 * 设置全局主题覆盖
	 * @param overrides 要覆盖的主题配置项
	 * 会与现有全局配置合并，不会完全替换
	 *
	 * @example
	 * ```uts
	 * const overrides = { colorTheme: '#333333' } as UTSJSONObject
	 * setGlobalTheme(overrides)
	 * ```
	 */
	const setGlobalTheme = (overrides : UTSJSONObject) => {
		globalThemeOverrides.value = mergeObjects(globalThemeOverrides.value, overrides)
	}

	/**
	 * 重置全局主题覆盖
	 * 清空所有全局主题覆盖，恢复到默认主题
	 *
	 * @example
	 * ```uts
	 * resetGlobalTheme() // 清空全局覆盖，回到默认主题
	 * ```
	 */
	const resetGlobalTheme = () => {
		globalThemeOverrides.value = {} as UTSJSONObject
	}

	/**
	 * 获取当前完整主题配置
	 * @returns 当前生效的完整主题配置对象
	 * 返回合并后的最终主题配置，用于调试或外部使用
	 *
	 * @example
	 * ```uts
	 * const currentConfig = getCurrentTheme()
	 * console.log('当前主题配置:', JSON.stringify(currentConfig))
	 * ```
	 */
	const getCurrentTheme = () : UTSJSONObject => themeVars.value

	return {
		/* 响应式主题配置变量，直接绑定到 wd-config-provider */
		themeVars,
		/* 设置全局主题覆盖 */
		setGlobalTheme,
		/* 重置全局主题覆盖 */
		resetGlobalTheme,
		/* 获取当前完整主题配置 */
		getCurrentTheme,
	}
}
