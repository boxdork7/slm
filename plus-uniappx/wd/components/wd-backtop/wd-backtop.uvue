<!--
Backtop 回到顶部 用于返回页面顶部的操作按钮。

UniApp X 版本
- 移除 defineOptions
- export type BacktopShape → 移除 export
- addUnit 从 ../common/util 导入
-->
<template>
  <wd-transition :show="show" name="fade">
    <view
      :class="`wd-backtop ${customClass} is-${shape}`"
      :style="`z-index: ${zIndex}; bottom: ${addUnit(bottom)}; right: ${addUnit(right)}; ${customStyle}`"
      @click="handleBacktop"
    >
      <slot v-if="$slots.default" />
      <wd-icon
        v-else
        custom-class="wd-backtop__backicon"
        name="backtop"
        :custom-style="iconStyle"
      />
    </view>
  </wd-transition>
</template>

<script lang="uts" setup>
import { computed } from 'vue'
import { addUnit } from '../common/util'

/**
 * 回到顶部组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 页面滚动距离 */
  scrollTop : number
  /** 距离顶部多少距离时显示,单位rpx */
  top ?: number
  /** 返回顶部滚动时间,单位ms */
  duration ?: number
  /** 层级 */
  zIndex ?: number
  /** icon自定义样式 */
  iconStyle ?: string
  /** 形状,可选值:'circle' / 'square' */
  shape ?: string
  /** 距离屏幕底部距离,单位rpx */
  bottom ?: number
  /** 距离屏幕右边距离,单位rpx */
  right ?: number
}>(), {
  customStyle: '',
  customClass: '',
  top: 600,
  duration: 100,
  zIndex: 99,
  iconStyle: '',
  shape: 'circle',
  bottom: 200,
  right: 40,
})

/**
 * 计算是否显示回到顶部按钮
 */
const show = computed(() : boolean => props.scrollTop > props.top)

/**
 * 处理回到顶部点击事件
 */
const handleBacktop = () : void => {
  uni.pageScrollTo({
    scrollTop: 0,
    duration: props.duration,
  })
}
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

@include b(backtop) {
  position: fixed;
  background-color: $-backtop-bg;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: $-color-gray-8;

  @include e(backicon) {
    font-size: $-backtop-icon-size;
  }

  @include when(circle) {
    border-radius: 50%;
  }

  @include when(square) {
    border-radius: 8rpx;
  }
}
</style>
