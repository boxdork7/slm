<!--
Table 表格 用于展示多条结构类似的数据,可对数据进行排序等操作。

UniApp X 版本改动点:
1. 移除 defineOptions
2. 移除手动组件导入(easycom 自动注册)
3. AlignType/SortDirection/TableColumn 等类型移到 wd-table-key.uts
4. useChildren → createChildManager + provide 模式
5. 联合字面量类型改为 string
6. Record<string, any> → UTSJSONObject 或 any
7. CSSProperties → Map<string, any> 然后用 objToStyle
8. any → 具体类型或 any | null
9. 子组件管理采用 childUids + childrenMap 的方式
10. 计算属性返回类型需要显式标注
11. watch 的回调参数需要显式类型标注
12. ::before/::after 伪元素保留(样式文件中)
13. :deep() → 直接类选择器
-->
<template>
  <view
    :class="`wd-table ${border ? 'is-border' : ''} ${customClass}`"
    :style="`${isDef(height) ? `max-height: ${addUnit(height)};` : ''}${customStyle}`"
  >
    <!-- 固定表头模式 -->
    <template v-if="fixedHeader">
      <!-- 表头部分 -->
      <scroll-view
        v-if="showHeader"
        :enable-flex="true"
        :throttle="false"
        :scroll-left="state.scrollLeft"
        :scroll-x="true"
        class="wd-table__header"
        @scroll="scroll"
      >
        <view
          id="table-header"
          class="wd-table__content wd-table__content--header"
          :style="realWidthStyle"
        >
          <!-- 序号列表头 -->
          <view
            v-if="indexEnabled"
            :class="getHeaderCellClass(indexColumn)"
            :style="getHeaderCellStyle(-1)"
          >
            <text :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
              {{ indexColumn.label }}
            </text>
          </view>

          <!-- 配置式列表头 -->
          <template v-if="isColumnsMode">
            <view
              v-for="(column, columnIndex) in columns"
              :key="column.prop"
              :class="getHeaderCellClass(column)"
              :style="getHeaderCellStyle(columnIndex)"
            >
              <wd-sort-button
                v-if="column.sortable"
                v-model="columnSortDirections[columnIndex]"
                allow-reset
                :line="false"
                :title="column.label"
                @change="({ value }) => handleSortChange(value, columnIndex, column)"
              />
              <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                {{ column.label }}
              </text>
            </view>
          </template>

          <!-- 子组件式列表头 -->
          <template v-else>
            <view
              v-for="(child, childIndex) in childrenArray"
              :key="child.prop"
              :class="getHeaderCellClass(child)"
              :style="getHeaderCellStyle(childIndex)"
            >
              <wd-sort-button
                v-if="child.sortable"
                v-model="childrenMap.get(child.uid)!.sortDirection"
                allow-reset
                :line="false"
                :title="child.label"
                @change="({ value }) => handleSortChange(value, childIndex, child)"
              />
              <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                {{ child.label }}
              </text>
            </view>
          </template>
        </view>
      </scroll-view>

      <!-- 表格主体 -->
      <scroll-view
        class="wd-table__body"
        :style="`${isDef(height) ? `height: calc(${data.length} * ${isDef(rowHeight) ? addUnit(rowHeight) : '100rpx'});` : ''}`"
        :enable-flex="true"
        :throttle="false"
        :scroll-x="true"
        :scroll-left="state.scrollLeft"
        @scroll="scroll"
      >
        <view id="table-body" class="wd-table__content" :style="realWidthStyle">
          <!-- 序号列 -->
          <wd-table-col
            v-if="indexEnabled"
            :prop="indexColumn.prop"
            :label="indexColumn.label"
            :width="indexColumn.width"
            :sortable="false"
            :fixed="indexColumn.fixed"
            :align="indexColumn.align"
          >
            <template #value="{ index: colIndex }">
              <text>{{ colIndex + 1 }}</text>
            </template>
          </wd-table-col>

          <!-- 配置式列渲染 -->
          <template v-if="isColumnsMode">
            <view
              v-for="column in columns"
              :key="column.prop"
              :class="getColumnClass(column)"
              :style="getColumnStyle(column)"
            >
              <view
                v-for="(row, rowIndex) in getColumnData(column.prop)"
                :key="rowIndex"
                :class="getCellClass(rowIndex, column)"
                :style="getCellStyle(column)"
                @click="handleRowClick(rowIndex)"
              >
                <!-- 自定义插槽 -->
                <slot
                  v-if="column.useSlot"
                  :name="column.slotName || `column-${column.prop}`"
                  :row="getRowScope(rowIndex)"
                  :index="rowIndex"
                  :column="column"
                />
                <!-- 自定义渲染函数 -->
                <text
                  v-else-if="column.render != null"
                  :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`"
                >
                  {{ column.render!(getRowScope(rowIndex), rowIndex) }}
                </text>
                <!-- 默认渲染 -->
                <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                  {{ row }}
                </text>
              </view>
            </view>
          </template>

          <!-- 子组件式列渲染 -->
          <slot v-else />
        </view>
      </scroll-view>
    </template>

    <!-- 非固定表头模式 -->
    <template v-else>
      <scroll-view
        class="wd-table__wrapper"
        :enable-flex="true"
        :throttle="false"
        :scroll-x="true"
        :scroll-left="state.scrollLeft"
        @scroll="scroll"
      >
        <view class="wd-table__inner" :style="realWidthStyle">
          <!-- 表头部分 -->
          <view v-if="showHeader" class="wd-table__header-row">
            <!-- 序号列表头 -->
            <view
              v-if="indexEnabled"
              :class="getHeaderCellClass(indexColumn)"
              :style="getHeaderCellStyle(-1)"
            >
              <text :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                {{ indexColumn.label }}
              </text>
            </view>

            <!-- 配置式列表头 -->
            <template v-if="isColumnsMode">
              <view
                v-for="(column, columnIndex) in columns"
                :key="column.prop"
                :class="getHeaderCellClass(column)"
                :style="getHeaderCellStyle(columnIndex)"
              >
                <wd-sort-button
                  v-if="column.sortable"
                  v-model="columnSortDirections[columnIndex]"
                  allow-reset
                  :line="false"
                  :title="column.label"
                  @change="({ value }) => handleSortChange(value, columnIndex, column)"
                />
                <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                  {{ column.label }}
                </text>
              </view>
            </template>

            <!-- 子组件式列表头 -->
            <template v-else>
              <view
                v-for="(column, columnIndex) in childrenArray"
                :key="column.prop"
                :class="getHeaderCellClass(column)"
                :style="getHeaderCellStyle(columnIndex)"
              >
                <wd-sort-button
                  v-if="column.sortable"
                  v-model="childrenMap.get(column.uid)!.sortDirection"
                  allow-reset
                  :line="false"
                  :title="column.label"
                  @change="({ value }) => handleSortChange(value, columnIndex, column)"
                />
                <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                  {{ column.label }}
                </text>
              </view>
            </template>
          </view>

          <!-- 表格内容部分 -->
          <view
            class="wd-table__content"
            :style="`${isDef(height) ? `height: calc(${data.length} * ${isDef(rowHeight) ? addUnit(rowHeight) : '100rpx'});` : ''}`"
          >
            <!-- 序号列 -->
            <wd-table-col
              v-if="indexEnabled"
              :prop="indexColumn.prop"
              :label="indexColumn.label"
              :width="indexColumn.width"
              :sortable="false"
              :fixed="indexColumn.fixed"
              :align="indexColumn.align"
            >
              <template #value="{ index: colIndex }">
                <text>{{ colIndex + 1 }}</text>
              </template>
            </wd-table-col>

            <!-- 配置式列渲染 -->
            <template v-if="isColumnsMode">
              <view
                v-for="column in columns"
                :key="column.prop"
                :class="getColumnClass(column)"
                :style="getColumnStyle(column)"
              >
                <view
                  v-for="(row, rowIndex) in getColumnData(column.prop)"
                  :key="rowIndex"
                  :class="getCellClass(rowIndex, column)"
                  :style="getCellStyle(column)"
                  @click="handleRowClick(rowIndex)"
                >
                  <!-- 自定义插槽 -->
                  <slot
                    v-if="column.useSlot"
                    :name="column.slotName || `column-${column.prop}`"
                    :row="getRowScope(rowIndex)"
                    :index="rowIndex"
                    :column="column"
                  />
                  <!-- 自定义渲染函数 -->
                  <text
                    v-else-if="column.render != null"
                    :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`"
                  >
                    {{ column.render!(getRowScope(rowIndex), rowIndex) }}
                  </text>
                  <!-- 默认渲染 -->
                  <text v-else :class="`wd-table__value ${ellipsis ? 'is-ellipsis' : ''}`">
                    {{ row }}
                  </text>
                </view>
              </view>
            </template>

            <!-- 子组件式列渲染 -->
            <slot v-else />
          </view>
        </view>
      </scroll-view>
    </template>
  </view>
</template>

<script lang="uts" setup>
import { computed, reactive, ref, watch, provide } from 'vue'
import { addUnit, debounce, isDef, isObj, isOdd, objToStyle, uuid } from '../common/util'
import { createChildManager } from '../../composables/useChildren'
import { useTranslate } from '../../composables/useTranslate'
import {
  TABLE_KEY,
  type AlignType,
  type SortDirection,
  type TableColumn,
  type TableColChild,
  type TableProvide,
  type TableState,
  type TableProps,
} from './wd-table-key'

/**
 * 统一的默认列宽度常量
 */
const DEFAULT_COLUMN_WIDTH = 200

/**
 * 表格组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 列配置数组(配置式使用) */
  columns ?: TableColumn[]
  /** 显示的数据 */
  data ?: any[]
  /** 是否带有边框 */
  border ?: boolean
  /** 是否为斑马纹 table */
  stripe ?: boolean
  /** Table 的高度 */
  height ?: string | number
  /** 行高 */
  rowHeight ?: string | number
  /** 是否显示表头 */
  showHeader ?: boolean
  /** 是否超出2行隐藏 */
  ellipsis ?: boolean
  /** 是否显示索引列 */
  index ?: boolean | UTSJSONObject
  /** 是否固定表头 */
  fixedHeader ?: boolean
}>(), {
  customStyle: '',
  customClass: '',
  columns: () : TableColumn[] => [],
  data: () : any[] => [],
  border: true,
  stripe: true,
  rowHeight: 100,
  showHeader: true,
  ellipsis: true,
  index: false,
  fixedHeader: true,
})

/** 定义组件事件 */
const emit = defineEmits(['sort-method', 'row-click'])

/** 翻译函数 */
const { translate } = useTranslate('tableCol')

/** 响应式状态 */
const state = reactive<TableState>({
  scrollLeft: 0,
})

/** 配置式列的排序方向状态 */
const columnSortDirections = ref<number[]>([])

/** 子组件管理(用于兼容 wd-table-col 子组件模式) */
const manager = createChildManager()

/** 子组件信息存储 Map<uid, childInfo> */
const childrenMap = reactive<Map<number, TableColChild>>(new Map())

/** 子组件数组(按注册顺序) */
const childrenArray = computed(() : TableColChild[] => {
  const result : TableColChild[] = []
  for (let i = 0; i < manager.childUids.length; i++) {
    const uid = manager.childUids[i]
    const child = childrenMap.get(uid)
    if (child != null) {
      result.push(child)
    }
  }
  return result
})

/** 序号列UUID */
const indexUUID = uuid()

/** 序号列配置 */
const indexColumn = computed(() : any => {
  const base = {
    prop: indexUUID,
    label: translate('indexLabel'),
    width: '100rpx',
    sortable: false,
    fixed: false,
    align: 'left',
  }

  if (isObj(props.index)) {
    return { ...base, ...(props.index as UTSJSONObject) }
  }
  return base
})

/** 是否启用序号列 */
const indexEnabled = computed(() : boolean => {
  return props.index !== false
})

/**
 * 获取列的标准化宽度
 */
const getColumnWidth = (width ?: string | number) : string | number => {
  return width != null ? width : DEFAULT_COLUMN_WIDTH
}

/**
 * 判断是否使用配置式模式
 */
const isColumnsMode = computed(() : boolean => {
  return props.columns.length > 0
})

/**
 * 初始化配置式列的排序状态
 */
watch(
  () => props.columns,
  (newColumns : TableColumn[]) => {
    if (newColumns.length > 0) {
      columnSortDirections.value = newColumns.map((col : TableColumn) : number => col.sortDirection ?? 0)
    }
  },
  { immediate: true },
)

/**
 * 处理行点击事件
 */
const handleRowClick = (index : number) => {
  emit('row-click', { rowIndex: index })
}

/**
 * 是否最后一个固定元素(子组件模式)
 */
const getIsLastFixed = (column : any) : boolean => {
  let isLastFixed = false
  if (column.fixed === true && childrenArray.value.length > 0) {
    const fixedCols = childrenArray.value.filter((child : TableColChild) : boolean => child.fixed === true)
    if (fixedCols.length > 0 && fixedCols[fixedCols.length - 1].prop === column.prop) {
      isLastFixed = true
    }
  }
  return isLastFixed
}

/**
 * 获取固定列样式(子组件模式)
 */
const getFixedStyle = (columnIndex : number, style : Map<string, any>) : Map<string, any> => {
  if (columnIndex > 0) {
    let left = ''
    for (let i = 0; i < columnIndex && i < childrenArray.value.length; i++) {
      const column = childrenArray.value[i]
      const colWidth = addUnit(column.width)
      left = left !== '' ? `${left} + ${colWidth}` : colWidth
    }
    style.set('left', `calc(${left})`)
  } else {
    style.set('left', '0')
  }
  return style
}

/**
 * 处理滚动事件
 */
const handleScroll = (event : any) => {
  state.scrollLeft = event.detail.scrollLeft as number
}

/**
 * 注册子组件的增强版本
 */
const addChild = (uid : number, childInfo : TableColChild) => {
  manager.addChild(uid)
  childrenMap.set(uid, childInfo)
}

/**
 * 注销子组件的增强版本
 */
const removeChild = (uid : number) => {
  manager.removeChild(uid)
  childrenMap.delete(uid)
}

/**
 * Provide 数据给子组件
 */
const tableProps : TableProps = {
  data: props.data,
  border: props.border,
  stripe: props.stripe,
  rowHeight: props.rowHeight as string | number,
  ellipsis: props.ellipsis,
  index: props.index,
}

const tableProvide : TableProvide = {
  childUids: manager.childUids,
  addChild: addChild,
  removeChild: removeChild,
  state: state,
  props: tableProps,
  rowClick: handleRowClick,
  getIsLastFixed: getIsLastFixed,
  getFixedStyle: getFixedStyle,
}

provide(TABLE_KEY, tableProvide)

/** 防抖处理滚动事件 */
const scroll = debounce(handleScroll, 100, { leading: false })

/**
 * 计算实际宽度样式
 */
const realWidthStyle = computed(() : string => {
  const style = new Map<string, any>()
  style.set('display', 'flex')
  let width = ''

  // 配置式模式
  if (isColumnsMode.value) {
    // 序号列宽度
    if (indexEnabled.value) {
      width = addUnit(indexColumn.value.width)
    }
    // 配置式列宽度
    for (let i = 0; i < props.columns.length; i++) {
      const column = props.columns[i]
      const colWidth = addUnit(getColumnWidth(column.width))
      width = width !== '' ? `${width} + ${colWidth}` : colWidth
    }
  } else {
    // 子组件模式
    for (let i = 0; i < childrenArray.value.length; i++) {
      const child = childrenArray.value[i]
      const colWidth = addUnit(getColumnWidth(child.width))
      width = width !== '' ? `${width} + ${colWidth}` : colWidth
    }
  }

  style.set('width', `calc(${width})`)
  return objToStyle(style)
})

/**
 * 获取指定字段的列数据
 */
const getColumnData = (prop : string) : any[] => {
  if (!Array.isArray(props.data)) {
    return []
  }
  return props.data.map((item : any) : any => item[prop])
}

/**
 * 获取行数据
 */
const getRowScope = (index : number) : any => {
  if (!Array.isArray(props.data)) {
    return {}
  }
  return props.data[index] ?? {}
}

/**
 * 判断是否最后一个固定元素(配置式模式)
 */
const getIsLastFixedForColumn = (column : any) : boolean => {
  if (column.fixed !== true) return false

  if (isColumnsMode.value) {
    const fixedColumns = props.columns.filter((col : TableColumn) : boolean => col.fixed === true)
    return fixedColumns.length > 0 && fixedColumns[fixedColumns.length - 1].prop === column.prop
  }

  return getIsLastFixed(column)
}

/**
 * 获取表头单元格类名
 */
const getHeaderCellClass = (column : any) : string => {
  const classNames : string[] = ['wd-table__cell']

  if (props.border) classNames.push('is-border')
  if (column.fixed === true) classNames.push('is-fixed')
  if (props.stripe) classNames.push('is-stripe')
  classNames.push(`is-${column.align ?? 'left'}`)

  if (getIsLastFixedForColumn(column) && state.scrollLeft > 0) {
    classNames.push('is-shadow')
  }

  return classNames.join(' ')
}

/**
 * 获取序号列固定样式
 */
const getFixedStyleForIndex = (style : Map<string, any>) : Map<string, any> => {
  style.set('left', '0')
  return style
}

/**
 * 获取固定列样式(配置式模式)
 */
const getFixedStyleForColumn = (columnIndex : number, style : Map<string, any>) : Map<string, any> => {
  let left = ''

  // 序号列占用的宽度
  if (indexEnabled.value) {
    left = addUnit(indexColumn.value.width)
  }

  // 计算前面固定列的宽度
  if (columnIndex > 0) {
    for (let i = 0; i < columnIndex && i < props.columns.length; i++) {
      const column = props.columns[i]
      if (column.fixed === true) {
        const colWidth = addUnit(getColumnWidth(column.width))
        left = left !== '' ? `${left} + ${colWidth}` : colWidth
      }
    }
  }

  style.set('left', left !== '' ? `calc(${left})` : '0')
  return style
}

/**
 * 获取表头单元格样式
 */
const getHeaderCellStyle = (columnIndex : number) : string => {
  let style = new Map<string, any>()

  if (isColumnsMode.value) {
    if (columnIndex === -1) {
      // 序号列
      style.set('width', addUnit(indexColumn.value.width))
      if (indexColumn.value.fixed === true) {
        style = getFixedStyleForIndex(style)
      }
    } else {
      const column = props.columns[columnIndex]
      style.set('width', addUnit(getColumnWidth(column.width)))
      if (column.fixed === true) {
        style = getFixedStyleForColumn(columnIndex, style)
      }
    }
  } else {
    const column = childrenArray.value[columnIndex]
    if (column != null) {
      style.set('width', addUnit(getColumnWidth(column.width)))
      if (column.fixed === true) {
        style = getFixedStyle(columnIndex, style)
      }
    }
  }

  return objToStyle(style)
}

/**
 * 获取列容器类名(配置式模式)
 */
const getColumnClass = (column : TableColumn) : string => {
  const classNames : string[] = ['wd-table-col']

  if (column.fixed === true) classNames.push('wd-table-col--fixed')
  if (getIsLastFixedForColumn(column) && state.scrollLeft > 0) {
    classNames.push('is-shadow')
  }

  return classNames.join(' ')
}

/**
 * 获取列容器样式(配置式模式)
 */
const getColumnStyle = (column : TableColumn) : string => {
  let style = new Map<string, any>()

  style.set('width', addUnit(getColumnWidth(column.width)))

  if (column.fixed === true) {
    const columnIndex = props.columns.findIndex((col : TableColumn) : boolean => col.prop === column.prop)
    style = getFixedStyleForColumn(columnIndex, style)
  }

  return objToStyle(style)
}

/**
 * 获取单元格类名(配置式模式)
 */
const getCellClass = (index : number, column : TableColumn) : string => {
  const classNames : string[] = ['wd-table__cell']

  if (props.stripe && isOdd(index)) classNames.push('is-stripe')
  if (props.border) classNames.push('is-border')
  classNames.push(`is-${column.align ?? 'left'}`)

  return classNames.join(' ')
}

/**
 * 获取单元格样式(配置式模式)
 */
const getCellStyle = (column : TableColumn) : string => {
  const style = new Map<string, any>()

  const rowHeight = isDef(props.rowHeight) ? props.rowHeight : 100
  if (isDef(rowHeight)) {
    style.set('height', addUnit(rowHeight as string | number))
  }

  return objToStyle(style)
}

/**
 * 处理排序变化
 */
const handleSortChange = (value : number, index : number, column : any) => {
  if (isColumnsMode.value) {
    // 配置式模式
    columnSortDirections.value[index] = value
    // 清除其他列的排序
    for (let i = 0; i < columnSortDirections.value.length; i++) {
      if (i !== index) {
        columnSortDirections.value[i] = 0
      }
    }

    const tableColumn : TableColumn = {
      prop: column.prop,
      label: column.label,
      width: column.width,
      sortable: column.sortable,
      align: column.align,
      sortDirection: value,
      fixed: column.fixed,
    }
    emit('sort-method', tableColumn)
  } else {
    // 子组件模式
    const child = childrenMap.get(column.uid)
    if (child != null) {
      child.sortDirection = value
    }

    // 清除其他列的排序
    for (let i = 0; i < childrenArray.value.length; i++) {
      if (i !== index) {
        const otherChild = childrenArray.value[i]
        const otherInfo = childrenMap.get(otherChild.uid)
        if (otherInfo != null) {
          otherInfo.sortDirection = 0
        }
      }
    }

    const tableColumn : TableColumn = {
      prop: childrenArray.value[index].prop,
      label: childrenArray.value[index].label,
      width: childrenArray.value[index].width,
      sortable: childrenArray.value[index].sortable,
      align: childrenArray.value[index].align,
      sortDirection: value,
      fixed: childrenArray.value[index].fixed,
    }
    emit('sort-method', tableColumn)
  }
}
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

/* 暗色主题样式 */
.wot-theme-dark {
  @include b(table-col) {
    @include when(shadow) {
      &::after {
        background: linear-gradient(270deg, rgba(17, 17, 17, 0.2) 0%, rgba(0, 0, 0, 0) 100%);
      }
    }
  }

  @include b(table) {
    background: $-dark-background;

    @include when(border) {
      border: 2rpx solid $-dark-border-color;
    }

    @include e(cell) {
      color: $-dark-color;
      background: $-dark-background2;

      @include when(stripe) {
        background: $-dark-background4;
      }

      @include when(border) {
        border-right: 1rpx solid $-dark-border-color;
        border-bottom: 1rpx solid $-dark-border-color;
      }

      @include when(shadow) {
        &::after {
          background: linear-gradient(270deg, rgba(17, 17, 17, 0.2) 0%, rgba(0, 0, 0, 0) 100%);
        }
      }
    }
  }
}

/* 表格容器样式 */
@include b(table) {
  position: relative;
  width: 100%;
  overflow: auto;
  background: $-table-bg;

  @include when(border) {
    border: 1rpx solid $-table-border-color;
  }

  /* 移除 :deep() */
  .wd-table-col:last-child {
    .wd-table__cell {
      @include when(border) {
        border-right: none;
      }
    }
  }

  @include e(header) {
    width: 100%;
    height: 100rpx;
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    overflow-x: auto;
    white-space: nowrap;
  }

  @include e(body) {
    width: 100%;
    box-sizing: border-box;
  }

  @include e(content) {
    display: flex;

    @include m(header) {
      position: sticky;
      top: 0;
      z-index: 2;
    }
  }

  @include e(cell) {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    background: $-table-bg;
    width: 200rpx;
    min-height: 100rpx;
    padding: 16rpx 20rpx;
    font-size: $-table-font-size;
    color: $-table-color;
    --wot-sort-button-height: 60rpx;

    @include when(border) {
      border-right: 1rpx solid $-table-border-color;
      border-bottom: 1rpx solid $-table-border-color;
    }

    @include when(stripe) {
      background: $-table-stripe-bg;
    }

    @include when(fixed) {
      position: sticky;
      z-index: 1;
      left: 0;
    }

    @include when(shadow) {
      &::after {
        content: ' ';
        position: absolute;
        height: 100%;
        right: -30rpx;
        top: 0;
        width: 30rpx;
        height: 100%;
        background: linear-gradient(270deg, rgba(255, 255, 255, 0) 0%, rgba(0, 0, 0, 0.04) 100%);
      }
    }

    @include when(left) {
      justify-content: flex-start;
    }

    @include when(center) {
      justify-content: center;
    }

    @include when(right) {
      justify-content: flex-end;
    }
  }

  @include e(wrapper) {
    width: 100%;
    overflow: auto;
  }

  @include e(inner) {
    display: flex;
    flex-direction: column;
  }

  @include e(header-row) {
    display: flex;
    flex-direction: row;
    width: 100%;
  }

  @include e(body) {
    display: flex;
    width: 100%;
  }

  @include e(value) {
    @include when(ellipsis) {
      word-break: break-all;
      @include multiEllipsis(2);
    }
  }
}

/* 表格列样式 */
@include b(table-col) {
  .wd-table__cell {
    width: 100%;
  }

  @include m(fixed) {
    position: sticky;
    z-index: 1;
    left: 0;
  }

  @include when(shadow) {
    &::after {
      content: ' ';
      position: absolute;
      height: 100%;
      right: -30rpx;
      top: 0;
      width: 30rpx;
      height: 100%;
      background: linear-gradient(270deg, rgba(255, 255, 255, 0) 0%, rgba(0, 0, 0, 0.04) 100%);
    }
  }

  .wd-table__cell:last-child {
    @include when(border) {
      border-bottom: none;
    }
  }
}
</style>
