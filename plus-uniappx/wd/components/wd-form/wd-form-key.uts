/**
 * 表单容器提供的数据接口 - UniApp X 版本
 *
 * 与 plus-app 版本差异：
 * - 移除 InjectionKey 泛型（UTS 不支持 Symbol/InjectionKey）
 * - 改用字符串 key + type 定义
 * - FormRules/FormItemRule 在此文件统一定义（不从 .uvue export）
 * - 子组件管理通过 ChildManager 模式实现
 */

/**
 * 表单项验证规则（不含自定义验证函数的简化版）
 */
export type FormItemRule = {
  /** 是否必填 */
  required ?: boolean
  /** 错误提示信息 */
  message : string
  /** 正则表达式验证 */
  pattern ?: RegExp | null
  /** 最小值/最小长度 */
  min ?: number | null
  /** 最大值/最大长度 */
  max ?: number | null
}

/**
 * 表单验证规则集合
 * key 为字段名，value 为规则数组
 */
export type FormRules = Map<string, FormItemRule[]>

/**
 * 错误信息类型
 */
export type ErrorMessage = {
  /** 字段名 */
  prop : string
  /** 错误信息 */
  message : string
}

/**
 * 表单容器 Provide 接口
 */
export type FormProvide = {
  /** 子组件 UID 列表 */
  childUids : number[]
  /** 注册子组件 */
  addChild : (uid : number) => void
  /** 注销子组件 */
  removeChild : (uid : number) => void
  /** 表单数据对象 */
  model : UTSJSONObject
  /** 表单验证规则 */
  rules : FormRules
  /** 是否在输入时重置校验信息 */
  resetOnChange : boolean
  /** 错误提示类型 */
  errorType : string
  /** 错误信息 Map */
  errorMessages : Map<string, string>
  /** 清除指定字段的错误信息 */
  clearFieldMessage : (prop : string) => void
}

/**
 * 表单容器注入键（字符串 key）
 */
export const FORM_KEY = 'wd-form'
