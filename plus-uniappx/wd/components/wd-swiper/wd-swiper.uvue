<!--
Swiper 轮播 用于创建轮播，它支持水平和垂直方向的滑动，
可以自定义样式和指示器位置，支持视频和图片资源的轮播，支持设置轮播标题和自定义标题样式。

UniApp X 版本
- 移除 defineOptions
- 移除 export type/interface
- 联合类型改为 string（DirectionType/EasingType/IndicatorPositionType/AdjustHeightType/SwiperItemType）
- ImageMode 改为 string
- SwiperList 接口保留（内部使用）
- any 改为具体类型
- WdSwiperNavProps 类型内联
- getCurrentInstance 类型处理
- :deep() 移除
- #ifdef MP-WEIXIN 条件编译保留
-->
<template>
  <view :class="`wd-swiper ${customClass}`" :style="customStyle">
    <!-- #ifdef MP-WEIXIN -->
    <scroll-view scroll-y scroll-x style="width: 100%; height: 100%">
      <!-- #endif -->
      <swiper
        :adjust-height="adjustHeight"
        :adjust-vertical-height="adjustVerticalHeight"
        class="wd-swiper__track"
        :autoplay="autoplay && !videoPlaying"
        :current="navCurrent"
        :interval="interval"
        :duration="duration"
        :circular="loop"
        :vertical="direction === 'vertical'"
        :easing-function="easingFunction"
        :previous-margin="addUnit(previousMargin)"
        :next-margin="addUnit(nextMargin)"
        :snap-to-edge="snapToEdge"
        :display-multiple-items="Math.min(displayMultipleItems, list.length)"
        :style="{ height: addUnit(height) }"
        @change="handleChange"
        @animationfinish="handleAnimationfinish"
      >
        <swiper-item v-for="(item, index) in list" :key="index" class="wd-swiper__item">
          <video
            v-if="isVideo(item)"
            :id="`video-${index}-${uid}`"
            objectFit="cover"
            :style="{ height: addUnit(height) }"
            :src="isObj(item) ? item[valueKey] : item"
            :poster="isObj(item) ? item.poster : ''"
            :class="`wd-swiper__video ${customItemClass} ${getCustomItemClass(currentValue, index, list)}`"
            :enable-progress-gesture="false"
            :loop="videoLoop"
            :muted="muted"
            :autoplay="autoplayVideo"
            @play="handleVideoPlay"
            @pause="handleVideoPause"
            @click="handleClick(index, item)"
          />
          <image
            v-else
            :src="isObj(item) ? item[valueKey] : item"
            :class="`wd-swiper__image ${customImageClass} ${customItemClass} ${getCustomItemClass(currentValue, index, list)}`"
            :style="{ height: addUnit(height) }"
            :mode="imageMode"
            @click="handleClick(index, item)"
          />

          <text
            v-if="isObj(item) && item[textKey]"
            :class="`wd-swiper__text ${customTextClass}`"
            :style="customTextStyle"
          >
            {{ item[textKey] }}
          </text>
        </swiper-item>
      </swiper>
      <!-- #ifdef MP-WEIXIN -->
    </scroll-view>
    <!-- #endif -->

    <template v-if="indicator">
      <slot name="indicator" :current="currentValue" :total="list.length" />
      <wd-swiper-nav
        v-if="!$slots.indicator"
        :custom-class="customIndicatorClass"
        :type="swiperIndicator.type"
        :current="swiperIndicator.current"
        :total="swiperIndicator.total"
        :direction="swiperIndicator.direction"
        :indicator-position="swiperIndicator.indicatorPosition"
        :min-show-num="swiperIndicator.minShowNum"
        :show-controls="swiperIndicator.showControls"
        @change="handleIndicatorChange"
      />
    </template>
  </view>
</template>

<script lang="uts" setup>
import { computed, ref, watch } from 'vue'
import { addUnit, isDef, isImageUrl, isObj, isVideoUrl, uuid } from '../common/util'
import wdSwiperNav from '../wd-swiper-nav/wd-swiper-nav.uvue'

/**
 * 轮播项接口
 */
interface SwiperList {
  [key : string] : any | null
  /** 图片、视频等资源地址 */
  value ?: string
  /** 视频资源的封面 */
  poster ?: string
  /** 资源文件类型，可选值：'image' | 'video' */
  type ?: string
}

/**
 * 指示器配置接口
 */
interface SwiperIndicatorConfig {
  current : number
  total : number
  direction : string
  indicatorPosition : string
  type ?: string
  minShowNum ?: number
  showControls ?: boolean
}

/**
 * 轮播组件属性
 */
const props = withDefaults(defineProps<{
  /** 自定义根节点样式 */
  customStyle ?: string
  /** 自定义根节点样式类 */
  customClass ?: string
  /** 是否自动播放轮播图 */
  autoplay ?: boolean
  /** 当前轮播在哪一项（下标） */
  current ?: number
  /** 轮播滑动方向，可选值：'horizontal'（水平）或'vertical'（垂直） */
  direction ?: string
  /** 同时显示的滑块数量 */
  displayMultipleItems ?: number
  /** 滑动动画时长，单位为毫秒 */
  duration ?: number
  /** 指定 swiper 切换缓动动画类型 */
  easingFunction ?: string
  /** 轮播的高度 */
  height ?: number | string
  /** 轮播间隔时间，单位为毫秒 */
  interval ?: number
  /** 图片列表，可以是一个图片对象数组或字符串数组 */
  list ?: SwiperList[] | string[]
  /** 是否循环播放轮播图 */
  loop ?: boolean
  /** 视频是否循环播放 */
  videoLoop ?: boolean
  /** 视频是否静音播放 */
  muted ?: boolean
  /** 后边距 */
  nextMargin ?: number | string
  /** 页码信息展示位置 */
  indicatorPosition ?: string
  /** 前边距 */
  previousMargin ?: number | string
  /** 是否应用边距到第一个、最后一个元素 */
  snapToEdge ?: boolean
  /** 指示器全部配置，可以是布尔值或指示器配置对象 */
  indicator ?: boolean
  /** 图片裁剪、缩放的模式 */
  imageMode ?: string
  /** 选项对象中，value 对应的 key */
  valueKey ?: string
  /** 选项对象中，标题 text 对应的 key */
  textKey ?: string
  /** 视频是否自动播放 */
  autoplayVideo ?: boolean
  /** 切换轮播项时是否停止上一个视频的播放 */
  stopPreviousVideo ?: boolean
  /** 视频播放时是否停止自动轮播 */
  stopAutoplayWhenVideoPlay ?: boolean
  /** 自动以指定滑块的高度为整个容器的高度，仅支付宝小程序支持 */
  adjustHeight ?: string
  /** vertical 为 true 时强制使 adjust-height 生效，仅支付宝小程序支持 */
  adjustVerticalHeight ?: boolean
  /** 自定义指示器类名 */
  customIndicatorClass ?: string
  /** 自定义图片类名 */
  customImageClass ?: string
  /** 自定义上一个图片类名 */
  customPrevImageClass ?: string
  /** 自定义下一个图片类名 */
  customNextImageClass ?: string
  /** 自定义swiper子项类名 */
  customItemClass ?: string
  /** 自定义上一个子项类名 */
  customPrevClass ?: string
  /** 自定义下一个子项类名 */
  customNextClass ?: string
  /** 自定义文字标题类名 */
  customTextClass ?: string
  /** 自定义文字标题样式 */
  customTextStyle ?: string
}>(), {
  customStyle: '',
  customClass: '',
  autoplay: true,
  current: 0,
  direction: 'horizontal',
  displayMultipleItems: 1,
  duration: 300,
  easingFunction: 'default',
  height: '350',
  interval: 5000,
  list: () : SwiperList[] | string[] => [] as SwiperList[] | string[],
  loop: true,
  videoLoop: true,
  muted: true,
  nextMargin: '0',
  indicatorPosition: 'bottom',
  previousMargin: '0',
  snapToEdge: false,
  indicator: true,
  imageMode: 'aspectFill',
  valueKey: 'value',
  textKey: 'text',
  autoplayVideo: true,
  stopPreviousVideo: true,
  stopAutoplayWhenVideoPlay: false,
  adjustHeight: 'highest',
  adjustVerticalHeight: false,
  customIndicatorClass: '',
  customImageClass: '',
  customPrevImageClass: '',
  customNextImageClass: '',
  customItemClass: '',
  customPrevClass: '',
  customNextClass: '',
  customTextClass: '',
  customTextStyle: '',
})

/** 组件事件 */
const emit = defineEmits(['click', 'change', 'animationfinish', 'update:current'])

/** 响应式数据 */
const navCurrent = ref<number>(props.current)
const currentValue = ref<number>(props.current)
const videoPlaying = ref<boolean>(false)
const uid = ref<string>(uuid())

/**
 * 计算指示器配置
 */
const swiperIndicator = computed(() : SwiperIndicatorConfig => {
  const config : SwiperIndicatorConfig = {
    current: currentValue.value,
    total: props.list.length,
    direction: props.direction,
    indicatorPosition: props.indicatorPosition,
    type: 'dots',
    minShowNum: 2,
    showControls: false,
  }
  return config
})

/**
 * 更新当前滑块
 */
const updateCurrent = (current : number, force : boolean) => {
  currentValue.value = current
  if (force) {
    navCurrent.value = current
  }
  emit('update:current', current)
}

/**
 * 获取媒体类型
 */
const getMediaType = (item : string | SwiperList, type : string) : boolean => {
  const checkType = (url : string) : boolean => {
    return type === 'video' ? isVideoUrl(url) : isImageUrl(url)
  }

  if (isObj(item)) {
    const itemObj = item as SwiperList
    if (itemObj.type != null && (itemObj.type === 'video' || itemObj.type === 'image')) {
      return itemObj.type === type
    }
    return checkType(itemObj[props.valueKey] ?? '')
  } else {
    return checkType(item as string)
  }
}

/**
 * 判断是否为视频
 */
const isVideo = (item : string | SwiperList) : boolean => {
  return getMediaType(item, 'video')
}

/**
 * 导航到指定位置
 */
const navTo = (index : number) => {
  if (index === currentValue.value) return
  updateCurrent(index, true)
}

/**
 * 跳转到开始位置
 */
const goToStart = () => {
  navTo(0)
}

/**
 * 跳转到结束位置
 */
const goToEnd = () => {
  navTo(props.list.length - 1)
}

/**
 * 是否为当前滑块的前一个滑块
 */
const isPrev = (current : number, index : number, list : SwiperList[] | string[]) : boolean => {
  return (current - 1 + list.length) % list.length === index
}

/**
 * 是否为当前滑块的后一个滑块
 */
const isNext = (current : number, index : number, list : SwiperList[] | string[]) : boolean => {
  return (current + 1 + list.length) % list.length === index
}

/**
 * 监听 current 属性变化
 */
watch(
  () => props.current,
  (val : number) => {
    if (val < 0) {
      props.loop ? goToEnd() : goToStart()
    } else if (val >= props.list.length) {
      props.loop ? goToStart() : goToEnd()
    } else {
      navTo(val)
    }
  },
)

/**
 * 获取自定义项类名
 */
const getCustomItemClass = (current : number, index : number, list : SwiperList[] | string[]) : string => {
  let customItemClass : string = ''
  if (isPrev(current, index, list)) {
    customItemClass = props.customPrevClass != '' ? props.customPrevClass : props.customPrevImageClass
  }
  if (isNext(current, index, list)) {
    customItemClass = props.customNextClass != '' ? props.customNextClass : props.customNextImageClass
  }
  return customItemClass
}

/**
 * 视频播放事件处理
 */
const handleVideoPlay = () => {
  if (props.stopAutoplayWhenVideoPlay) {
    videoPlaying.value = true
  }
}

/**
 * 视频暂停事件处理
 */
const handleVideoPause = () => {
  videoPlaying.value = false
}

/**
 * 开始播放指定视频
 */
const handleStartVideoPlay = (index : number) => {
  if (props.autoplayVideo) {
    const currentItem = props.list[index]
    if (isDef(currentItem) && isVideo(currentItem)) {
      const video = uni.createVideoContext(`video-${index}-${uid.value}`)
      video?.play()
    }
  }
}

/**
 * 停止播放指定视频
 */
const handleStopVideoPlay = (index : number) => {
  if (props.stopPreviousVideo) {
    const previousItem = props.list[index]
    if (isDef(previousItem) && isVideo(previousItem)) {
      const video = uni.createVideoContext(`video-${index}-${uid.value}`)
      video?.pause()
    }
  } else if (props.stopAutoplayWhenVideoPlay) {
    handleVideoPause()
  }
}

/**
 * 处理视频切换
 */
const handleVideoChange = (previous : number, current : number) => {
  handleStopVideoPlay(previous)
  handleStartVideoPlay(current)
}

/**
 * 轮播滑块切换时触发
 */
const handleChange = (e : any) => {
  const current = e.detail.current as number
  const source = e.detail.source as string
  const previous = currentValue.value
  emit('change', { current, source })

  if (current !== currentValue.value) {
    const forceUpdate = source === 'autoplay' || source === 'touch'
    updateCurrent(current, forceUpdate)
  }

  handleVideoChange(previous, current)
}

/**
 * 滑块动画结束时触发
 */
const handleAnimationfinish = (e : any) => {
  const current = e.detail.current as number
  const source = e.detail.source as string

  if (current !== currentValue.value) {
    const forceUpdate = source === 'autoplay' || source === 'touch'
    updateCurrent(current, forceUpdate)
  }

  emit('animationfinish', { current, source })
}

/**
 * 点击滑块事件处理
 */
const handleClick = (index : number, item : string | SwiperList) => {
  emit('click', { index, item })
}

/**
 * 指示器变化事件处理
 */
const handleIndicatorChange = (event : any) => {
  const dir = event.dir as string
  const total = props.list.length
  let nextPos = dir === 'next' ? currentValue.value + 1 : currentValue.value - 1

  if (props.loop) {
    nextPos = dir === 'next' ? (currentValue.value + 1) % total : (currentValue.value - 1 + total) % total
  } else {
    nextPos = nextPos < 0 || nextPos >= total ? currentValue.value : nextPos
  }

  if (nextPos === currentValue.value) return
  navTo(nextPos)
}
</script>

<style lang="scss">
@import '../common/abstracts/variable';
@import '../common/abstracts/mixin';

@include b(swiper) {
  position: relative;

  @include e(track) {
    border-radius: $-swiper-radius;
    overflow: hidden;
    transform: translateY(0);
  }

  @include e(item) {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: $-swiper-item-padding;
  }

  @include e(image, video) {
    width: 100%;
    transition: all 0.3s ease;
  }

  @include e(text) {
    position: absolute;
    right: 24rpx;
    top: 24rpx;
    color: $-swiper-item-text-color;
    font-size: $-swiper-item-text-fs;
  }
}
</style>
